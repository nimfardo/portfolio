---
// The nav has linked to /about since copy-003 and the route never existed —
// this closes the last 404 on the site (feat-044 closed /process's).
//
// Built 1:1 from Max's canvas frame 2690:10957, after the copy-019/feat-061
// pass rebuilt it for recruiters and design leads. Sections in canvas order.
//
// Three deliberate omissions, all for want of assets rather than intent:
//   * The hero ships media-less and renders the placeholder box, exactly as
//     /process does (feat-053) — the video isn't shot yet.
//   * The two empty `image` frames below Hobbies (2712:2262/2264/2265) are
//     Max's placeholders with no content; nothing is invented to fill them.
//   * There is no Languages section. It was on the canvas during copy-019 and
//     is gone from it now, so the page matches what the canvas actually says.
import Layout from '@app/layouts/Layout.astro';
import { Heading } from '@shared/ui';
import { PageHeader } from '@widgets/page-header';
import { ProjectHero } from '@widgets/project-hero';
import { OverviewSection } from '@widgets/overview-section';
import { ProfileLinks } from '@widgets/profile-links';
import type { ProfileLink } from '@widgets/profile-links';
import { IndustriesBar } from '@widgets/industries-bar';

// Four cards, 2x2, matching canvas nodes 2702:11276 / 2702:11254. GitHub points
// at glacier-flow because the portfolio's own repo stays private (Max's call,
// 2026-08-17) — glacier-flow is public and already linked from three case
// studies, so it is the one real code artifact a reader can open.
// LINKEDIN_URL / BEHANCE_URL are copied from widgets/navigation, which is where
// the site's real profile URLs live. Deliberately duplicated rather than
// extracted: hoisting them into shared/config would mean editing Navigation,
// which renders on every page, and this change set is meant to be additive.
// They are a One-Place-Rule violation and owe an extraction — the copy deck
// already drifted from these once.
const LINKEDIN_URL = 'https://www.linkedin.com/in/maksym-shturma-680292149/';
const BEHANCE_URL = 'https://www.behance.net/shturma';

const links: ProfileLink[] = [
  {
    label: 'Download CV',
    icon: 'cv',
    href: '/max-shturma-cv.pdf',
    variant: 'accent',
    download: true,
  },
  { label: 'LinkedIn', icon: 'linkedin', href: LINKEDIN_URL },
  { label: 'Behance', icon: 'behance', href: BEHANCE_URL },
  { label: 'GitHub', icon: 'github', href: 'https://github.com/nimfardo/glacier-flow' },
];

// The close repeats the primary action beside the fastest way to reach him.
// CV first — canvas 2729:1908 leads with the accent card (Max reordered it
// from LinkedIn-first himself; see STATE.md's copy-019 notes).
const contactLinks: ProfileLink[] = [
  {
    label: 'Download CV',
    icon: 'cv',
    href: '/max-shturma-cv.pdf',
    variant: 'accent',
    download: true,
  },
  { label: 'LinkedIn', icon: 'linkedin', href: LINKEDIN_URL },
];

const EMAIL = 'max.shturma@gmail.com';
---

<Layout title="About — Max Shturma">
  <main class="about">
    {
      /* PageHeader's title is a <span> that's display:none below 1024px, so
        without this the page has no h1 at any width (feat-047's finding). */
    }
    <h1 class="visually-hidden">About</h1>

    <PageHeader title="About" class="about__header" />

    <ProjectHero scrollCue />

    <OverviewSection
      heading="Since 2017"
      class="about__section"
      tags={[
        'Design systems',
        '3-tier tokens',
        'Atomic components',
        'Interaction & motion (Lottie)',
        'Prototyping in code',
        'Git & deploy',
        'Research & usability testing',
        'Mentoring',
      ]}
    >
      I'm Max Shturma, a design engineer. Nine years of UX/UI and design systems behind that —
      3-tier tokens, component architecture. The last year I've been building what I design, in
      code.
    </OverviewSection>

    {
      /* Portrait beside the 2x2 card grid. The canvas pairs a 791.5x1000 photo
        with two 468px card rows and a 64px gap — which is exactly 1000px, and
        that is what makes the two columns end level. */
    }
    <section class="about__section about__profile">
      {
        /* The wrapper is what suppresses the raggedness: as a bare grid item the
          <img>'s own intrinsic height drove the row (1025px at a 1920 column
          against the cards' 1000px), so stretching alone left 25px of slack
          inside the card column. An empty positioned box has no intrinsic
          height, so the card column decides the row at every width and the
          image fills it. */
      }
      <div class="about__portrait-wrap" data-reveal>
        <img
          class="about__portrait"
          src="/media/about/portrait.jpg"
          alt="Max Shturma outdoors in a green beanie, holding a tabby cat that is nuzzling his beard"
          width="1583"
          height="2000"
          loading="lazy"
        />
      </div>
      <ProfileLinks cards={links} class="about__links" />
    </section>

    <section class="about__section section-grid">
      <Heading class="section-grid__aside">Industries</Heading>
      <div class="section-grid__body" data-reveal>
        <IndustriesBar />
      </div>
    </section>

    <section class="about__section section-grid">
      <Heading class="section-grid__aside">Availability</Heading>
      <p class="section-grid__body section-prose" data-reveal>
        Based in Budapest. Open to Design Engineer and design systems roles in Zurich, Amsterdam,
        London, and Dublin. I need visa sponsorship or an EOR arrangement, and I'm ready to
        relocate.
      </p>
    </section>

    <section class="about__section section-grid">
      <Heading class="section-grid__aside">Hobbies</Heading>
      <p class="section-grid__body section-prose" data-reveal>
        Photography, gothic typography, gaming, travel.
      </p>
    </section>

    <section class="about__section section-grid">
      <Heading class="section-grid__aside">Contact</Heading>
      <div class="section-grid__body about__contact" data-reveal>
        <p class="section-prose">If any of this fits what you're hiring for, get in touch.</p>
        <a class="about__email" href={`mailto:${EMAIL}`}>{EMAIL}</a>
        <ProfileLinks cards={contactLinks} />
      </div>
    </section>

    {
      /* No page-local back-to-top. The canvas shows one in this corner, but
        `features/scroll-to-top` is already global chrome mounted once in
        Layout.astro — a viewport-fixed button that appears after a screen of
        scrolling — and its own comment records that exact decision for this
        Figma node (2377:2011). feat-066 added a second one here and it was a
        straight duplicate. */
    }
  </main>
</Layout>

<style>
  /* :global() — the class merges onto PageHeader's own rendered element, which
     carries PageHeader.astro's astro-cid, not this page's. */
  :global(.about__header) {
    padding: 0 40px;
  }

  .about {
    padding-bottom: 160px;
  }

  /* The site's 160px section rhythm, same schedule process.astro uses.
     :global() for the same reason as .about__header above, and this one was a
     real bug: `about__section` is passed as a prop to <OverviewSection>, whose
     root element carries OverviewSection's astro-cid rather than this page's,
     so a scoped rule never matched it. That one miss produced four visible
     defects at once — the overview bled to the viewport edge (padding-left 0
     against every other section's 40px), its aside label sat 40px left of the
     other four, its body column started 13px left of theirs and ran 53px
     wider, and the hero-to-overview gap was 0px where every other gap was
     exactly 160px. The plain <section> elements below matched fine either way,
     which is what made it look like an alignment problem rather than a
     scoping one. */
  :global(.about__section) {
    padding: 0 40px;
    margin-top: 160px;
  }

  .about__profile {
    display: grid;
    /* Canvas: 791.5 photo + 64 gap + 791.5 cards inside the 1647 content
       column — an even split. */
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    /* stretch, not start: the card column is a fixed 468 + 64 + 468 = 1000px
       while the portrait's height followed its own aspect ratio, so the two
       only ended level when the column happened to be 791.5px wide. Measured
       ragged both ways — portrait 722px against cards 1000px at a 1440
       viewport, and 1025 against 1000 at 1920. Letting the row height drive
       the image and absorbing the difference in the crop makes them level at
       every width. */
    align-items: stretch;
  }
  .about__portrait-wrap {
    position: relative;
    min-height: 0;
  }
  .about__portrait {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about__contact {
    /* Canvas 2729:1908: statement -> email and email -> cards are both 64px. */
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3xl);
  }
  .about__email {
    font-family: var(--font-family-body);
    font-size: var(--font-size-3xl);
    /* Cross-paired on purpose: the canvas text is Manrope/3xl/medium (32/48),
       and this scale carries one line-height per size step (3xl = 40) — the
       same 3xl-size/4xl-line-height pairing the process card title uses. */
    line-height: var(--font-line-height-4xl);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-primary);
    text-decoration: none;
    /* Same animated underline vocabulary as the nav (feat-015): a wipe rather
       than a static rule, so it reads as part of the system. */
    background-image: linear-gradient(currentColor, currentColor);
    background-position: 0 100%;
    background-repeat: no-repeat;
    background-size: 0 1px;
    transition: background-size var(--duration-base) var(--ease-fade);
    align-self: flex-start;
  }
  @media (hover: hover) and (pointer: fine) {
    .about__email:hover {
      background-size: 100% 1px;
    }
  }
  .about__email:focus-visible {
    background-size: 100% 1px;
  }

  @media (prefers-reduced-motion: reduce) {
    .about__email {
      transition: none;
    }
  }

  @media (max-width: 1023px) {
    /* Same scale-down [slug].astro and process.astro apply — 160px of empty
       space between sections is a desktop-only luxury. :global() to match the
       base rule, or this override would miss OverviewSection too. */
    :global(.about__section) {
      margin-top: var(--spacing-4xl);
    }
    /* The photo beside a 2x2 card grid needs more width than a tablet has;
       stack them, photo first, as the canvas orders them. */
    .about__profile {
      grid-template-columns: 1fr;
    }
    /* Stacked there is no card column to decide the row, so the wrapper carries
       the ratio itself — an absolutely-filled image inside a box with no height
       would collapse to nothing. */
    .about__portrait-wrap {
      max-width: 520px;
      aspect-ratio: 791.5 / 1000;
    }
  }

  @media (max-width: 767px) {
    :global(.about__header) {
      padding: 0 24px;
    }
    /* :global() to match the base rule — see the note there. */
    :global(.about__section) {
      padding: 0 24px;
    }
    .about {
      padding-bottom: var(--spacing-4xl);
    }
    .about__contact {
      gap: var(--spacing-xl);
    }
  }
</style>
