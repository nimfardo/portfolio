---
import Layout from '@app/layouts/Layout.astro';
import { Heading } from '@shared/ui';
import { PageHeader } from '@widgets/page-header';
import { ProjectHero } from '@widgets/project-hero';
import { OverviewSection } from '@widgets/overview-section';
import { ContentSection } from '@widgets/content-section';
import { ProcessAccordion } from '@widgets/process-accordion';
import { BuildSection } from '@widgets/build-section';
import { Retrospective } from '@widgets/retrospective';
import { Footer } from '@widgets/footer';
import { connectis } from '@entities/project';

// Only CONNECTIS exists so far — Arvus and the rest land once Max approves
// more hi-fi designs in Figma (see planning/specs/site-implementation.md).
export function getStaticPaths() {
  return [{ params: { slug: connectis.slug }, props: { project: connectis } }];
}

const { project } = Astro.props;
---

<Layout title={`${project.name} — Max Shturma`}>
  <main class="project-page">
    <PageHeader title={project.name} showBack backHref="/" class="project-page__header" />

    <ProjectHero image={project.hero.image} imageAlt={project.hero.imageAlt} scrollCue />

    <div class="project-page__sections">
      <OverviewSection heading={project.overview.heading} tags={project.overview.tags}>
        {project.overview.text}
      </OverviewSection>

      <ContentSection
        heading={project.challenge.heading}
        blocks={[
          {
            image: project.challenge.image,
            imageAlt: project.challenge.imageAlt,
            text: project.challenge.text,
          },
        ]}
      />

      <section class="project-page__process">
        <Heading class="project-page__process-heading">Process</Heading>
        <div class="project-page__process-body">
          <ProcessAccordion steps={project.process} />
        </div>
      </section>

      <ContentSection heading={project.deliverables.heading} blocks={project.deliverables.blocks} />

      <BuildSection
        sitemapImage={project.build.sitemapImage}
        caption={project.build.caption}
        stats={project.build.stats}
      />

      <div class="project-page__gallery">
        <img class="project-page__gallery-full" src={project.gallery[0]} alt="" loading="lazy" />
        <div class="project-page__gallery-row">
          <img class="project-page__gallery-tall" src={project.gallery[1]} alt="" loading="lazy" />
          <div class="project-page__gallery-stack">
            <img src={project.gallery[2]} alt="" loading="lazy" />
            <img src={project.gallery[3]} alt="" loading="lazy" />
          </div>
        </div>
      </div>

      <Retrospective
        heading={project.retrospective.heading}
        behanceUrl={project.retrospective.behanceUrl}
      >
        {project.retrospective.text}
      </Retrospective>

      <Footer />
    </div>
  </main>
</Layout>

<style>
  /* :global() — class merges onto PageHeader's own rendered element, which
     carries PageHeader.astro's astro-cid, not this component's. Only
     horizontal padding — not a max-width — so it stays full-bleed like
     the hero/gallery images and every other page (Home has no page-wide
     cap either); a max-width here centered the header/sections into a
     column narrower than the full-bleed hero above ~1900px viewports,
     which read as misaligned even though it was mathematically symmetric
     (bug-012, 2026-07-28). */
  :global(.project-page__header) {
    padding: 0 40px;
  }
  .project-page__sections {
    display: flex;
    flex-direction: column;
    /* 160px between every section on this page, top to bottom — measured
       directly off the Figma frame's child y-positions, consistent across
       all 8 gaps. Not a token; this page's own established rhythm. */
    gap: 160px;
    padding: 160px 40px;
  }
  .project-page__process {
    display: grid;
    /* 33/66 proportional split — Max added reference columns in Figma
       (node 2165:3): 3 equal tracks with 80px gutters, heading spans
       track 1, content spans tracks 2-3. Same pattern as ContentSection,
       BuildSection, Retrospective. */
    grid-template-columns: repeat(3, 1fr);
    column-gap: 80px;
    align-items: start;
  }
  :global(.project-page__process-heading) {
    grid-column: 1 / 2;
  }
  .project-page__process-body {
    grid-column: 2 / 4;
    min-width: 0;
  }
  .project-page__gallery {
    display: flex;
    flex-direction: column;
    /* 64px — Frame 13's own internal rhythm between the full-width image
       and the row below, distinct from the page's 160px section gap. */
    gap: 64px;
  }
  .project-page__gallery-full {
    width: 100%;
    aspect-ratio: 1647 / 1000;
    object-fit: cover;
  }
  .project-page__gallery-row {
    display: flex;
    gap: 64px;
  }
  .project-page__gallery-tall {
    flex: 1;
    min-width: 0;
    aspect-ratio: 791.5 / 1000;
    object-fit: cover;
  }
  .project-page__gallery-stack {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 64px;
  }
  .project-page__gallery-stack img {
    width: 100%;
    aspect-ratio: 791.5 / 468;
    object-fit: cover;
  }

  @media (max-width: 1023px) {
    .project-page__process {
      grid-template-columns: 1fr;
      gap: var(--spacing-xl);
    }
    :global(.project-page__process-heading) {
      grid-column: 1;
    }
    .project-page__process-body {
      grid-column: 1;
    }
    /* 160px top/bottom rhythm was measured off Figma's desktop frame only
       (no mobile/tablet mock exists for this page) — left unreduced, it's
       a huge amount of empty space stacked between every section on a
       narrower screen. Scaled down at both breakpoints below, judgment
       call same as the nav's 1024px breakpoint (see STATE.md). */
    .project-page__sections,
    .project-page__gallery {
      gap: var(--spacing-4xl);
    }
    .project-page__sections {
      padding: var(--spacing-4xl) 40px;
    }
  }
  @media (max-width: 767px) {
    .project-page__sections,
    .project-page__gallery {
      gap: var(--spacing-3xl);
    }
    .project-page__sections {
      padding: var(--spacing-3xl) 24px;
    }
    .project-page__gallery-row {
      flex-direction: column;
      gap: var(--spacing-3xl);
    }
    .project-page__gallery-tall {
      aspect-ratio: 1647 / 1000;
    }
    .project-page__gallery-stack {
      gap: var(--spacing-3xl);
    }
  }
</style>
