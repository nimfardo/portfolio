---
import Layout from '@app/layouts/Layout.astro';
import { Heading } from '@shared/ui';
import { PageHeader } from '@widgets/page-header';
import { ProjectHero } from '@widgets/project-hero';
import { OverviewSection } from '@widgets/overview-section';
import { ContentSection } from '@widgets/content-section';
import { ProcessAccordion } from '@widgets/process-accordion';
import { BuildSection } from '@widgets/build-section';
import { Retrospective } from '@widgets/retrospective';
import { NoContent } from '@widgets/no-content';
import { PasswordGate } from '@widgets/password-gate';
import { ProjectGallery } from '@widgets/project-gallery';
import { VideoSection } from '@widgets/video-section';
import { PROJECTS, PROJECT_CONTENT } from '@entities/project';

// Every project card gets a route now, not just the ones with real content
// written (currently only CONNECTIS) — clicking any other card used to
// 404. `content` is undefined for a slug with no entry in PROJECT_CONTENT;
// the template falls back to the No Content state for those.
export function getStaticPaths() {
  return PROJECTS.map((meta) => ({
    params: { slug: meta.slug },
    props: { meta, content: PROJECT_CONTENT[meta.slug] },
  }));
}

const { meta, content } = Astro.props;
// Gating a project with no content yet would just be a password prompt
// guarding an empty page — content readiness takes priority over access.
const isGated = Boolean(content) && meta.access === 'nda';

// ProjectContent's two structural variants (feat-033): challenge is either
// a media block section (CONNECTIS) or a bare statement+description
// (defenceSystems), and process is either accordion steps or a single content block.
// Narrowed here so the template stays flat.
const challenge = content?.challenge;
const challengeBlocks = challenge && 'blocks' in challenge ? challenge : undefined;
const challengeStatement = challenge && !('blocks' in challenge) ? challenge : undefined;
const processSteps = Array.isArray(content?.process) ? content.process : undefined;
const processBlocks =
  content?.process && !Array.isArray(content.process) ? content.process : undefined;
---

<Layout title={`${meta.name} — Max Shturma`}>
  <main class="project-page">
    <PageHeader title={meta.name} showBack backHref="/" class="project-page__header" />

    {!content && <NoContent />}

    {
      content && (
        <PasswordGate active={isGated}>
          <ProjectHero media={content.hero} scrollCue />

          <div class="project-page__sections">
            <OverviewSection
              heading={content.overview.heading}
              description={content.overview.description}
              linkCards={content.overview.linkCards}
              tags={content.overview.tags}
            >
              {content.overview.text}
            </OverviewSection>

            {challengeBlocks && (
              <ContentSection heading={challengeBlocks.heading} blocks={challengeBlocks.blocks} />
            )}
            {challengeStatement && (
              <OverviewSection
                heading={challengeStatement.heading}
                description={challengeStatement.description}
              >
                {challengeStatement.text}
              </OverviewSection>
            )}

            {processSteps && (
              <section class="project-page__process">
                <Heading class="project-page__process-heading">Process</Heading>
                <div class="project-page__process-body">
                  <ProcessAccordion steps={processSteps} />
                </div>
              </section>
            )}
            {processBlocks && (
              <ContentSection heading={processBlocks.heading} blocks={processBlocks.blocks} />
            )}

            {content.deliverables && (
              <ContentSection
                heading={content.deliverables.heading}
                blocks={content.deliverables.blocks}
              />
            )}

            {content.build && (
              <BuildSection
                blocks={content.build.blocks}
                stats={content.build.stats}
                githubUrl={content.build.githubUrl}
              />
            )}

            {content.video && (
              <VideoSection
                src={content.video.src}
                poster={content.video.poster}
                alt={content.video.alt}
              />
            )}

            {content.gallery && <ProjectGallery rows={content.gallery} />}

            {content.retrospective && (
              <Retrospective
                heading={content.retrospective.heading}
                behanceUrl={content.retrospective.behanceUrl}
              >
                {content.retrospective.text}
              </Retrospective>
            )}
          </div>
        </PasswordGate>
      )
    }
  </main>
</Layout>

<style>
  /* :global() — class merges onto PageHeader's own rendered element, which
     carries PageHeader.astro's astro-cid, not this component's. Only
     horizontal padding — not a max-width — so it stays full-bleed like
     the hero/gallery images and every other page (Home has no page-wide
     cap either); a max-width here centered the header/sections into a
     column narrower than the full-bleed hero above ~1900px viewports,
     which read as misaligned even though it was mathematically symmetric
     (bug-012, 2026-07-28). */
  :global(.project-page__header) {
    padding: 0 40px;
  }
  .project-page__sections {
    display: flex;
    flex-direction: column;
    /* 160px between every section on this page, top to bottom — measured
       directly off the Figma frame's child y-positions, consistent across
       all 8 gaps. Not a token; this page's own established rhythm. */
    gap: 160px;
    padding: 160px 40px;
  }
  .project-page__process {
    display: grid;
    /* 33/66 proportional split — Max added reference columns in Figma
       (node 2165:3): 3 equal tracks with 80px gutters, heading spans
       track 1, content spans tracks 2-3. Same pattern as ContentSection,
       BuildSection, Retrospective. */
    grid-template-columns: repeat(3, 1fr);
    column-gap: 80px;
    align-items: start;
  }
  :global(.project-page__process-heading) {
    grid-column: 1 / 2;
  }
  .project-page__process-body {
    grid-column: 2 / 4;
    min-width: 0;
  }
  @media (max-width: 1023px) {
    .project-page__process {
      grid-template-columns: 1fr;
      gap: var(--spacing-xl);
    }
    :global(.project-page__process-heading) {
      grid-column: 1;
    }
    .project-page__process-body {
      grid-column: 1;
    }
    /* 160px top/bottom rhythm was measured off Figma's desktop frame only
       (no mobile/tablet mock exists for this page) — left unreduced, it's
       a huge amount of empty space stacked between every section on a
       narrower screen. Scaled down at both breakpoints below, judgment
       call same as the nav's 1024px breakpoint (see STATE.md). */
    .project-page__sections {
      gap: var(--spacing-4xl);
      padding: var(--spacing-4xl) 40px;
    }
  }
  @media (max-width: 767px) {
    .project-page__sections {
      /* Bumped from --spacing-3xl (64px) — too tight to read as a real
         section break while scrolling on a phone (Max caught this live).
         Matches the tablet breakpoint's value now. */
      gap: var(--spacing-4xl);
      padding: var(--spacing-4xl) 24px;
    }
  }
</style>
