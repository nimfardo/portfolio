---
// The nav has linked to /process since copy-003, but the route never existed —
// this page closes that 404. (/about is still outstanding.)
//
// Structure follows Max's Figma frame (node 2124:1834): a lead statement in
// the 66% column, the 12-step rail, then the Build section. BuildSection is
// reused verbatim from the case-study pages — it already renders a hardcoded
// "Build" heading, one media+text block and an optional GitHub button, which
// is exactly what the canvas has.
import Layout from '@app/layouts/Layout.astro';
import { PageHeader } from '@widgets/page-header';
import { ProjectHero } from '@widgets/project-hero';
import { ProcessRail } from '@widgets/process-rail';
import { BuildSection } from '@widgets/build-section';
import type { ContentBlock } from '@entities/project';

// The shared Glacier Flow block, byte-identical to the one defenceSystems, CONNECTIS and
// medicalSoftware carry — one video file in public/media/shared/, one caption. feat-046
// had built this page its own still instead, which also meant it shipped the
// *stale* pre-copy-008 caption while every case study carried the approved
// short one. Reusing the block resolves both (feat-050).
//
// `/media/process/build.jpg` is unreferenced as of this change and awaiting
// Max's call on deleting it.
const buildBlocks: ContentBlock[] = [
  {
    media: {
      type: 'video',
      src: '/media/shared/glacier-flow.webm',
      poster: '/media/shared/glacier-flow-poster.jpg',
      alt: "Glacier Flow's title card, then a scroll through the template's public GitHub README — core idea, folder map, and the gated task workflow",
    },
    text: 'I use Glacier Flow, a Claude Code template: folder routing, a knowledge base, and gated tasks.',
  },
];
---

<Layout title="Design Process — Max Shturma">
  <main class="process">
    {
      /* PageHeader's title is a <span>, and it's display:none below 1024px —
        so without this the page has no h1 at any width. */
    }
    <h1 class="visually-hidden">Design Process</h1>

    <PageHeader title="Design Process" class="process__header" />

    {
      /* Max added this hero to the canvas on 2026-08-16 (node 2712:2272) —
        the same bare media + "Scroll down" shape every case-study page
        opens with, so it's ProjectHero verbatim. No `media`: the video
        isn't shot yet, and the canvas shows the unset placeholder box. */
    }
    <ProjectHero scrollCue />

    <div class="process__lead section-grid">
      <p class="process__lead-text section-grid__body">
        Twelve steps from a blank repo to a living design system, run in Claude Code. Nothing is
        ever exported.
      </p>
    </div>

    <ProcessRail />

    <div class="process__build">
      <BuildSection blocks={buildBlocks} githubUrl="https://github.com/nimfardo/glacier-flow" />
    </div>
  </main>
</Layout>

<style>
  /* :global() — the class merges onto PageHeader's own rendered element, which
     carries PageHeader.astro's astro-cid, not this page's. */
  :global(.process__header) {
    padding: 0 40px;
  }

  .process {
    padding-bottom: 160px;
  }

  /* Reuses the shared 33/66 reference grid (ref-005). No aside here — the
     statement sits in the body column with the left track empty, matching
     the canvas, where it starts at x=769 (193 + 576). */
  .process__lead {
    padding: 0 40px;
    /* 160px below the hero, measured off the canvas (Hero-section ends at
       y=1028, lead starts at y=1188) — the same section rhythm the
       case-study pages use between the hero and everything under it. Was
       96px when the lead sat directly under the header. */
    margin-top: 160px;
  }
  .process__lead-text {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: var(--font-size-4xl);
    line-height: var(--font-line-height-5xl);
    letter-spacing: -0.4px;
    font-weight: var(--font-weight-medium);
    color: var(--color-text-emphasis);
  }

  /* Back to the site's standard 160px section gap. feat-048 had cut this to
     96px to compensate for the pinned rail's own slack; feat-051 removed that
     slack at the source (the viewport is sized to its content now), so this
     margin is once again the only thing between the rail and Build. */
  .process__build {
    padding: 0 40px;
    margin-top: 160px;
  }

  @media (max-width: 1023px) {
    /* Same scale-down [slug].astro applies to its own 160px rhythm — that
       much empty space between sections is desktop-only. */
    .process__lead,
    .process__build {
      margin-top: var(--spacing-4xl);
    }
  }

  @media (max-width: 767px) {
    :global(.process__header) {
      padding: 0 24px;
    }
    .process__lead,
    .process__build {
      padding: 0 24px;
    }
    .process {
      padding-bottom: var(--spacing-4xl);
    }
  }
</style>
