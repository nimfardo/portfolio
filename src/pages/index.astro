---
import Layout from '@app/layouts/Layout.astro';
import { PageHeader } from '@widgets/page-header';
import { ProjectGrid } from '@widgets/project-grid';
---

<Layout title="Max Shturma — Portfolio">
  <main class="home">
    <PageHeader title="Projects" />
    <ProjectGrid />
  </main>
</Layout>

<style>
  .home {
    padding: var(--spacing-xl) 40px;
  }

  /* PageHeader owns its own 40px top margin at this breakpoint (bug-012) —
     without zeroing this out, the two stack and overshoot Figma's y=40. */
  @media (min-width: 1024px) {
    .home {
      padding-top: 0;
    }
  }

  /* Max's call: 40px side gutters were eating too much of a phone screen —
     16px lets each card run noticeably bigger. */
  @media (max-width: 767px) {
    .home {
      padding-left: 16px;
      padding-right: 16px;
    }
  }
</style>
