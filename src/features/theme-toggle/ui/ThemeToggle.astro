---
// Reads/writes the same localStorage key the theme-init script in
// app/layouts/Layout.astro checks before first paint.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<button
  type="button"
  class:list={['theme-toggle', className]}
  data-theme-toggle
  aria-label="Toggle color theme"
>
  <span class="theme-toggle__label" data-theme-toggle-label>Dark</span>
  <span class="theme-toggle__track">
    <span class="theme-toggle__knob"></span>
  </span>
</button>

<script>
  import { bindOncePersisted, prefersReducedMotion } from '@shared/lib';

  // The desktop toggle (PageHeader) is fresh, unpersisted markup on every
  // page — needs (re)binding after each `astro:page-load`. The mobile
  // toggle (Navigation's persisted overlay) is the same DOM node the whole
  // session — bindOncePersisted stops it from picking up duplicate click
  // listeners on every subsequent swap.
  const STORAGE_KEY = 'theme';

  function syncLabel(button: HTMLElement) {
    const isLight = document.documentElement.dataset.theme === 'light';
    const label = button.querySelector('[data-theme-toggle-label]');
    if (label) label.textContent = isLight ? 'Light' : 'Dark';
    button.setAttribute('aria-pressed', String(isLight));
  }

  function syncAllLabels() {
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach(syncLabel);
  }

  function switchTheme() {
    const isLight = document.documentElement.dataset.theme === 'light';
    if (isLight) {
      delete document.documentElement.dataset.theme;
      localStorage.setItem(STORAGE_KEY, 'dark');
    } else {
      document.documentElement.dataset.theme = 'light';
      localStorage.setItem(STORAGE_KEY, 'light');
    }
    syncAllLabels();
  }

  /**
   * Where the wipe starts: the pointer itself, not the button's centre
   * (feat-089, after Max read the original as mis-positioned). The toggle is
   * ~102px wide — the word plus the track — so clicking the label put the
   * origin up to half that away from the cursor, and a circle that grows
   * from somewhere you didn't click is exactly what reads as wrong.
   *
   * A keyboard activation (Enter/Space) reports clientX/clientY as 0, which
   * is also a legitimate coordinate, so `detail` is what distinguishes them:
   * it counts clicks and is 0 for a synthesised one. Keyboard falls back to
   * the button's centre, which is the right answer when there is no cursor.
   */
  function wipeOrigin(event: MouseEvent, button: HTMLElement) {
    if (event.detail > 0) {
      return {
        x: Math.min(Math.max(event.clientX, 0), innerWidth),
        y: Math.min(Math.max(event.clientY, 0), innerHeight),
      };
    }
    const box = button.getBoundingClientRect();
    return { x: box.left + box.width / 2, y: box.top + box.height / 2 };
  }

  /**
   * Circular wipe out of the click (awwwards idea 2, feat-087).
   * The `::view-transition-*` keyframes live in global.css behind
   * `html[data-theme-switching]` — that flag is the whole reason page
   * navigations (also view transitions, via ClientRouter) don't inherit the
   * circle. Set it before starting, clear it when the transition settles.
   */
  function wipeTheme(event: MouseEvent, button: HTMLElement) {
    const root = document.documentElement;
    const { x, y } = wipeOrigin(event, button);
    // Farthest viewport corner from the origin — the radius at which the
    // circle has covered every pixel, so the wipe never stops short no
    // matter which corner it started nearest.
    const r = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
    root.style.setProperty('--tt-x', `${x}px`);
    root.style.setProperty('--tt-y', `${y}px`);
    root.style.setProperty('--tt-r', `${r}px`);
    root.dataset.themeSwitching = '';
    const transition = document.startViewTransition(switchTheme);
    transition.finished.finally(() => {
      delete root.dataset.themeSwitching;
    });
  }

  function initThemeToggle() {
    syncAllLabels();
    bindOncePersisted<HTMLButtonElement>('[data-theme-toggle]', (button) => {
      button.addEventListener('click', (event) => {
        if (!document.startViewTransition || prefersReducedMotion()) {
          switchTheme();
          return;
        }
        wipeTheme(event, button);
      });
    });
  }

  document.addEventListener('astro:page-load', initThemeToggle);
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-md);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font-family: var(--font-family-body);
    font-size: var(--font-size-sm);
    line-height: var(--font-line-height-sm);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-primary);
  }

  .theme-toggle__track {
    position: relative;
    width: 44px;
    height: 24px;
    border-radius: var(--radius-full);
    background: var(--color-bg-muted);
    transition: background 0.2s ease;
  }
  :global([data-theme='light']) .theme-toggle__track {
    background: var(--color-bg-elevated);
  }

  .theme-toggle__knob {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 20px;
    height: 20px;
    border-radius: var(--radius-full);
    background: var(--color-bg-inverse);
    transition: left 0.2s ease;
  }
  :global([data-theme='light']) .theme-toggle__knob {
    left: 22px;
  }
</style>
