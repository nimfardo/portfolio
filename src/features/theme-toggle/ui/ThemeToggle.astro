---
// Reads/writes the same localStorage key the theme-init script in
// app/layouts/Layout.astro checks before first paint.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<button
  type="button"
  class:list={['theme-toggle', className]}
  data-theme-toggle
  aria-label="Toggle color theme"
>
  <span class="theme-toggle__label">
    <span class="theme-toggle__word theme-toggle__word--dark">Dark</span>
    <span class="theme-toggle__word theme-toggle__word--light">Light</span>
  </span>
  <span class="theme-toggle__track">
    <span class="theme-toggle__knob"></span>
  </span>
</button>

<script>
  import { bindOncePersisted, initCvRole } from '@shared/lib';

  // The desktop toggle (PageHeader) is fresh, unpersisted markup on every
  // page — needs (re)binding after each `astro:page-load`. The mobile
  // toggle (Navigation's persisted overlay) is the same DOM node the whole
  // session — bindOncePersisted stops it from picking up duplicate click
  // listeners on every subsequent swap.
  const STORAGE_KEY = 'theme';

  // Which word shows is CSS's job now, keyed on [data-theme] like the track
  // and knob beside it. This only mirrors the state for assistive tech.
  //
  // It used to write `label.textContent` here: the HTML shipped "Dark", and on
  // a light-theme load this swapped in the wider "Light" one frame after
  // paint. The actions row is right-aligned, so the CV button jumped left on
  // every refresh — which is what Max was seeing as a jumping gap. Nothing
  // that affects layout can wait for JS; `data-theme` is already set before
  // first paint in Layout.astro, so CSS gets it right on frame one.
  function syncPressed(button: HTMLElement) {
    const isLight = document.documentElement.dataset.theme === 'light';
    button.setAttribute('aria-pressed', String(isLight));
  }

  function syncAllPressed() {
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach(syncPressed);
  }

  function initThemeToggle() {
    syncAllPressed();
    bindOncePersisted<HTMLButtonElement>('[data-theme-toggle]', (button) => {
      button.addEventListener('click', () => {
        const isLight = document.documentElement.dataset.theme === 'light';
        if (isLight) {
          delete document.documentElement.dataset.theme;
          localStorage.setItem(STORAGE_KEY, 'dark');
        } else {
          document.documentElement.dataset.theme = 'light';
          localStorage.setItem(STORAGE_KEY, 'light');
        }
        syncAllPressed();
        initCvRole();
      });
    });
  }

  document.addEventListener('astro:page-load', initThemeToggle);
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-md);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font-family: var(--font-family-body);
    font-size: var(--font-size-sm);
    line-height: var(--font-line-height-sm);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-primary);
  }

  /* Both words ship in the markup and CSS picks one, the same way the track
     and knob below pick their colours — so the label is right at first paint
     instead of a frame late (see the script comment). `display: none` rather
     than a reserved max-width box: hiding it outright keeps the label hugging
     its text exactly as before, and reserving room for the wider "LIGHT"
     would leave ~12px of dead space beside "DARK" in the other theme. */
  .theme-toggle__word--light {
    display: none;
  }
  :global([data-theme='light']) .theme-toggle__word--dark {
    display: none;
  }
  :global([data-theme='light']) .theme-toggle__word--light {
    display: inline;
  }

  .theme-toggle__track {
    position: relative;
    width: 44px;
    height: 24px;
    border-radius: var(--radius-full);
    background: var(--color-bg-muted);
    transition: background 0.2s ease;
  }
  :global([data-theme='light']) .theme-toggle__track {
    background: var(--color-bg-elevated);
  }

  .theme-toggle__knob {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 20px;
    height: 20px;
    border-radius: var(--radius-full);
    background: var(--color-bg-inverse);
    transition: left 0.2s ease;
  }
  :global([data-theme='light']) .theme-toggle__knob {
    left: 22px;
  }
</style>
