---
// Reads/writes the same localStorage key the theme-init script in
// app/layouts/Layout.astro checks before first paint.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<button
  type="button"
  class:list={['theme-toggle', className]}
  data-theme-toggle
  aria-label="Toggle color theme"
>
  <span class="theme-toggle__label" data-theme-toggle-label>Dark</span>
  <span class="theme-toggle__track">
    <span class="theme-toggle__knob"></span>
  </span>
</button>

<script>
  import { bindOncePersisted, prefersReducedMotion } from '@shared/lib';

  // The desktop toggle (PageHeader) is fresh, unpersisted markup on every
  // page — needs (re)binding after each `astro:page-load`. The mobile
  // toggle (Navigation's persisted overlay) is the same DOM node the whole
  // session — bindOncePersisted stops it from picking up duplicate click
  // listeners on every subsequent swap.
  const STORAGE_KEY = 'theme';

  function syncLabel(button: HTMLElement) {
    const isLight = document.documentElement.dataset.theme === 'light';
    const label = button.querySelector('[data-theme-toggle-label]');
    if (label) label.textContent = isLight ? 'Light' : 'Dark';
    button.setAttribute('aria-pressed', String(isLight));
  }

  function syncAllLabels() {
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach(syncLabel);
  }

  function switchTheme() {
    const isLight = document.documentElement.dataset.theme === 'light';
    if (isLight) {
      delete document.documentElement.dataset.theme;
      localStorage.setItem(STORAGE_KEY, 'dark');
    } else {
      document.documentElement.dataset.theme = 'light';
      localStorage.setItem(STORAGE_KEY, 'light');
    }
    syncAllLabels();
  }

  /**
   * Where the wipe starts: the centre of the switch itself — the 44px track,
   * not the button box. The button is ~98px wide because it carries the word
   * "DARK" as well, so its centre sits ~27px to the left of the thing that
   * visually reads as the toggle. Max's call after seeing it; feat-089 had
   * briefly used the pointer instead, which was the wrong reading of a note
   * about position.
   */
  function wipeOrigin(button: HTMLElement) {
    const anchor = button.querySelector('.theme-toggle__track') ?? button;
    const box = anchor.getBoundingClientRect();
    return { x: box.left + box.width / 2, y: box.top + box.height / 2 };
  }

  /**
   * Circular wipe out of the toggle (awwwards idea 2, feat-087).
   * The `::view-transition-*` keyframes live in global.css behind
   * `html[data-theme-switching]` — that flag is the whole reason page
   * navigations (also view transitions, via ClientRouter) don't inherit the
   * circle, and it is also what suppresses every CSS transition for the
   * duration so the wipe ends without a pop. Set it before starting, clear
   * it when the transition settles.
   */
  function wipeTheme(button: HTMLElement) {
    const root = document.documentElement;
    const { x, y } = wipeOrigin(button);
    // Farthest viewport corner from the origin — the radius at which the
    // circle has covered every pixel, so the wipe never stops short no
    // matter which corner it started nearest. Rounded up: a fractional
    // shortfall would leave one pixel of the old theme to snap away.
    const r = Math.ceil(Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y)));
    root.style.setProperty('--tt-x', `${x}px`);
    root.style.setProperty('--tt-y', `${y}px`);
    root.style.setProperty('--tt-r', `${r}px`);
    root.dataset.themeSwitching = '';
    const transition = document.startViewTransition(switchTheme);
    transition.finished.finally(() => {
      delete root.dataset.themeSwitching;
    });
  }

  function initThemeToggle() {
    syncAllLabels();
    bindOncePersisted<HTMLButtonElement>('[data-theme-toggle]', (button) => {
      button.addEventListener('click', () => {
        if (!document.startViewTransition || prefersReducedMotion()) {
          switchTheme();
          return;
        }
        wipeTheme(button);
      });
    });
  }

  document.addEventListener('astro:page-load', initThemeToggle);
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-md);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font-family: var(--font-family-body);
    font-size: var(--font-size-sm);
    line-height: var(--font-line-height-sm);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-primary);
  }

  .theme-toggle__track {
    position: relative;
    width: 44px;
    height: 24px;
    border-radius: var(--radius-full);
    background: var(--color-bg-muted);
    transition: background 0.2s ease;
  }
  :global([data-theme='light']) .theme-toggle__track {
    background: var(--color-bg-elevated);
  }

  .theme-toggle__knob {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 20px;
    height: 20px;
    border-radius: var(--radius-full);
    background: var(--color-bg-inverse);
    transition: left 0.2s ease;
  }
  :global([data-theme='light']) .theme-toggle__knob {
    left: 22px;
  }
</style>
