---
// No markup of its own — wires up open/close behavior for the elements
// widgets/navigation renders: [data-mobile-nav-trigger] opens
// [data-mobile-nav-overlay], [data-mobile-nav-close] and a backdrop click
// or Escape close it. Kept as its own feature slice (the "verb" is
// toggling the mobile nav) even though it has no visual output.
---

<script>
  import { bindOncePersisted } from '@shared/lib';

  // The trigger/overlay/close elements live inside Navigation's persisted
  // (transition:persist) containers, so they're the same DOM nodes across
  // every client-side navigation — bindOncePersisted skips repeat
  // `astro:page-load` fires, or clicks would stack duplicate listeners.
  function initMobileNavToggle() {
    bindOncePersisted<HTMLElement>('[data-mobile-nav-trigger]', (trigger) => {
      const overlay = document.querySelector<HTMLElement>('[data-mobile-nav-overlay]');
      const closeButton = document.querySelector<HTMLElement>('[data-mobile-nav-close]');

      function open() {
        overlay?.setAttribute('data-open', 'true');
        trigger.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
      }

      function close() {
        overlay?.removeAttribute('data-open');
        trigger.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      }

      trigger.addEventListener('click', open);
      closeButton?.addEventListener('click', close);
      overlay?.addEventListener('click', (event) => {
        if (event.target === overlay) close();
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') close();
      });
    });
  }

  document.addEventListener('astro:page-load', initMobileNavToggle);
</script>
