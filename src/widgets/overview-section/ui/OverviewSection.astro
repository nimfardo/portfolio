---
// Heading + a big statement line + tag pills, no image — Figma split this
// out of the old hero card once tags moved off the hero image (see
// widgets/project-hero). Same 33/66 reference-column grid as ContentSection.
//
// feat-033 additions, all optional so CONNECTIS renders unchanged: a
// smaller description paragraph under the statement, a row of clickable
// sub-brand LinkCards (defenceSystems's subBrandOne.example / subBrandTwo.example pair), and
// tags may be omitted — defenceSystems's Challenge reuses this widget as a bare
// statement + description section.
// The card markup itself now lives in entities/project's LinkCards — medicalSoftware
// needed the same cards inside a ContentSection, so keeping them here would
// have meant two copies of the pinned-colour rules (bug-040).
import { Heading } from '@shared/ui';
import { LinkCards } from '@entities/project';
import type { LinkCard, FeatureList } from '@entities/project';

interface Props {
  heading: string;
  tags?: string[];
  description?: string;
  /** enterpriseIt's "Features:" block — a bold label over a bulleted list. */
  features?: FeatureList;
  linkCards?: LinkCard[];
  class?: string;
}

const { heading, tags, description, features, linkCards, class: className } = Astro.props;
---

<section class:list={['section-grid', 'overview-section', className]}>
  <Heading class="section-grid__aside overview-section__heading">{heading}</Heading>
  <div class="section-grid__body overview-section__body" data-reveal>
    <p class="section-prose overview-section__text"><slot /></p>
    {description && <p class="overview-section__description">{description}</p>}
    {
      features && (
        <div class="overview-section__features">
          <p class="overview-section__features-label">{features.label}</p>
          <ul class="overview-section__features-list">
            {features.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      )
    }
    {linkCards && <LinkCards cards={linkCards} />}
    {
      tags && (
        <ul class="overview-section__tags">
          {tags.map((tag) => (
            <li class="overview-section__tag">{tag}</li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<style>
  /* Grid, column spans and the 1023px collapse come from .section-grid in
     global.css; the statement's type ramp comes from .section-prose there
     too — deliberately without `white-space: pre-line`, which this one
     statement (unlike the other four) has never had (ref-005). */
  .overview-section__body {
    display: flex;
    flex-direction: column;
    gap: 64px;
  }
  /* Figma text style Manrope/xl/regular-loose (node 2487:2264) — the
     smaller paragraph defenceSystems runs under its statement lines. */
  .overview-section__description {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: var(--font-size-xl);
    line-height: var(--font-line-height-3xl);
    font-weight: var(--font-weight-regular);
    color: var(--color-text-emphasis);
    white-space: pre-line;
  }
  /* enterpriseIt's Features block (Figma 2928:2365). The label is Manrope/xl/bold
     (2928:2340); the items reuse the description's Manrope/xl/regular-loose
     ramp (2928:2348 carries the same style), so the two stay in step if that
     ramp moves. 16px label-to-list is Figma's own gap: the list text sits at
     y=44 under a 28px label. */
  .overview-section__features {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }
  .overview-section__features-label {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: var(--font-size-xl);
    line-height: var(--font-line-height-xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-emphasis);
  }
  .overview-section__features-list {
    margin: 0;
    /* Bullets hang outside the text column so the items align with the
       statement above them, matching the canvas. */
    padding-left: 1.5em;
    font-family: var(--font-family-body);
    font-size: var(--font-size-xl);
    line-height: var(--font-line-height-3xl);
    font-weight: var(--font-weight-regular);
    color: var(--color-text-emphasis);
  }
  .overview-section__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .overview-section__tag {
    padding: 8px 14px;
    border: 1px solid var(--color-border-emphasis);
    border-radius: var(--radius-full);
    font-family: var(--font-family-body);
    font-size: var(--font-size-xs);
    line-height: var(--font-line-height-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-emphasis);
    white-space: nowrap;
  }

  @media (max-width: 767px) {
    /* A single nowrap pill can be wider than a phone screen (defenceSystems's
       longest tag is ~423px — caught as real 74px page overflow at 375px
       in feat-033's QA; CONNECTIS's 323px pill only just fit). Let the
       text wrap inside the pill instead. */
    .overview-section__tag {
      white-space: normal;
    }
  }
</style>
