---
// Wraps NDA project content (Figma `password-gate`, node 2326:1850,
// on the standalone Password page — reused here inline on a project page
// instead of a separate route, so unlocking reveals the real content in
// place).
//
// bug-073 changed what "hidden" means here. This used to render the gated
// markup and hide it with CSS, which hid it from visitors and from nobody
// else — Google had the case studies indexed with the client names in them.
// Now the markup is rendered to a string at build time, encrypted, and
// emitted only as ciphertext; the browser decrypts and injects it on a
// correct password. See shared/lib/password-gate.ts for what this does and
// does not protect.
//
// `active=false` renders the slot directly with no gate, no crypto and no
// JS at all — lets callers always wrap content in <PasswordGate active={...}>
// instead of duplicating the content markup across a gated/ungated branch.
import { NDA_PASSWORD } from 'astro:env/server';

import { InputField, Button } from '@shared/ui';

import { encryptGatedHtml } from '../lib/encrypt';

interface Props {
  active?: boolean;
}

const { active = true } = Astro.props;

// `Astro.slots.render` is what makes this possible: it renders the gated
// subtree to an HTML string here in the build instead of into the page, so
// there is something to encrypt and nothing to leak.
let payload = null;
if (active) {
  // Belt and braces. astro:env's schema already rejects both a missing and
  // an empty NDA_PASSWORD before this file runs (measured — an empty string
  // reports as "missing"), so in practice this never fires. It stays as the
  // last line of defence because of what the failure would cost: a falsy
  // password here means deriving a key nobody needs to guess, and shipping
  // five client case studies in the clear. A red build is the cheap outcome.
  if (!NDA_PASSWORD) {
    throw new Error(
      'NDA_PASSWORD is falsy — refusing to build a gated project page. ' +
        'Set a real value in .env locally and in Netlify’s build environment.',
    );
  }
  payload = encryptGatedHtml(await Astro.slots.render('default'), NDA_PASSWORD);
}
---

{!active && <slot />}

{
  active && payload && (
    <div
      class="password-gate-wrapper"
      data-password-gate
      data-nda-payload={JSON.stringify(payload)}
    >
      <script is:inline>
        // Sync and pre-paint: decryption is async, so without this an
        // already-unlocked visitor would see the password form flash before
        // the content resolves. Marks the wrapper as resuming (CSS hides the
        // form) and the module script below clears it either way.
        (function () {
          const wrapper = document.currentScript.closest('[data-password-gate]');
          if (sessionStorage.getItem('nda-key') !== null) {
            wrapper.setAttribute('data-resuming', '');
          }
        })();
      </script>

      <div class="password-gate">
        <p class="password-gate__title">Enter the Password</p>
        <form class="password-gate__controls" data-password-gate-form>
          <InputField
            label="Password"
            type="password"
            name="password"
            placeholder="Enter Your Password"
          />
          <Button type="solid">Enter</Button>
          <p class="password-gate__error" data-password-gate-error hidden>
            Incorrect password — try again.
          </p>
          <p class="password-gate__error" data-password-gate-locked hidden />
        </form>
      </div>

      {/* Empty on purpose — the decrypted markup is injected here. */}
      <div class="password-gate__content" />
    </div>
  )
}

<script>
  import {
    tryUnlockNda,
    decryptWithStoredKey,
    getLockoutRemainingMs,
    type NdaPayload,
  } from '@shared/lib';

  function formatRemaining(ms: number): string {
    const totalMinutes = Math.ceil(ms / 60000);
    const hours = Math.floor(totalMinutes / 60);
    const minutes = totalMinutes % 60;
    return hours > 0 ? `${hours}h ${minutes}m` : `${minutes}m`;
  }

  // Disables the form and shows the remaining time while a lockout (5 failed
  // attempts, see shared/lib/password-gate.ts) is active. Returns whether it
  // is locked, so the submit handler can skip the plain "incorrect password"
  // message when a failure just triggered the lock.
  function applyLockState(wrapper: HTMLElement): boolean {
    const form = wrapper.querySelector<HTMLFormElement>('[data-password-gate-form]');
    const input = form?.querySelector<HTMLInputElement>('input[name="password"]');
    const button = form?.querySelector<HTMLButtonElement>('button.button');
    const lockedEl = wrapper.querySelector<HTMLElement>('[data-password-gate-locked]');
    if (!form || !input || !button || !lockedEl) return false;

    const remaining = getLockoutRemainingMs();
    input.disabled = remaining > 0;
    button.disabled = remaining > 0;
    if (remaining > 0) {
      lockedEl.textContent = `Too many attempts — try again in ${formatRemaining(remaining)}.`;
      lockedEl.removeAttribute('hidden');
    } else {
      lockedEl.setAttribute('hidden', '');
    }
    return remaining > 0;
  }

  function readPayload(wrapper: HTMLElement): NdaPayload | null {
    const raw = wrapper.dataset.ndaPayload;
    if (!raw) return null;
    try {
      return JSON.parse(raw) as NdaPayload;
    } catch {
      return null;
    }
  }

  // Astro hoists each component's `<script>` to page level — but for a
  // component used ONLY inside this gate, "page level" lands inside the
  // slot HTML, which means inside the ciphertext. `innerHTML` never
  // executes a script, so on a gated page Media's video autoplay and Lottie
  // init would never load at all (they are page-level on public project
  // pages and absent from gated ones — that asymmetry is the tell).
  //
  // So re-create them as real elements and wait for them before firing
  // `nda:unlocked`, otherwise the event races the module that is supposed
  // to be listening for it.
  async function loadInjectedScripts(target: HTMLElement): Promise<void> {
    const injected = Array.from(target.querySelectorAll('script'));
    await Promise.all(
      injected.map((original) => {
        original.remove();
        const src = original.getAttribute('src');
        // Already on the page — a module shared with something ungated (the
        // dotLottie loader AnimatedLogo also pulls in, for instance).
        // ES modules dedupe by URL, so its listeners are long since
        // registered and re-adding it would execute nothing.
        if (src && document.querySelector(`script[src="${src}"]`)) return Promise.resolve();

        const fresh = document.createElement('script');
        for (const attr of Array.from(original.attributes)) {
          fresh.setAttribute(attr.name, attr.value);
        }
        if (!src) {
          fresh.textContent = original.textContent;
          document.head.append(fresh);
          return Promise.resolve();
        }
        const settled = new Promise<void>((resolve) => {
          fresh.addEventListener('load', () => resolve(), { once: true });
          // Resolve on error too — a missing chunk shouldn't wedge the
          // unlock and leave the reader staring at undecorated content.
          fresh.addEventListener('error', () => resolve(), { once: true });
        });
        document.head.append(fresh);
        return settled;
      }),
    );
  }

  // Drops the decrypted markup in and hands off to everything that binds
  // behaviour to page content. The injected nodes appeared long after
  // `astro:page-load` fired, so nothing is wired up to them yet — the
  // `nda:unlocked` event is what the accordion, media autoplay, Lottie
  // sizing, scroll-reveal and count-up listen for to re-init over the new
  // DOM. Dispatched on `document` rather than the wrapper so those
  // listeners stay where they are and need no knowledge of this widget.
  async function reveal(wrapper: HTMLElement, html: string) {
    const target = wrapper.querySelector<HTMLElement>('.password-gate__content');
    if (!target) return;
    target.innerHTML = html;
    // The ciphertext has served its purpose; leaving ~175KB of base64 in a
    // live attribute is just dead weight in the DOM.
    delete wrapper.dataset.ndaPayload;
    // Swap the form out for the content first, then wire it up — no reason
    // to make the reader wait on a script fetch to see the page.
    wrapper.removeAttribute('data-resuming');
    wrapper.setAttribute('data-unlocked', '');
    await loadInjectedScripts(target);
    document.dispatchEvent(new CustomEvent('nda:unlocked'));
  }

  // Not inside any transition:persist region — unguarded re-init on every
  // astro:page-load, same as ProcessAccordion/InputField.
  function initPasswordGate() {
    document.querySelectorAll<HTMLElement>('[data-password-gate]').forEach((wrapper) => {
      const form = wrapper.querySelector<HTMLFormElement>('[data-password-gate-form]');
      const errorEl = wrapper.querySelector<HTMLElement>('[data-password-gate-error]');
      const input = form?.querySelector<HTMLInputElement>('input[name="password"]');
      const payload = readPayload(wrapper);
      if (!form || !input || !payload) return;

      applyLockState(wrapper);

      // Already unlocked earlier this session: decrypt straight away with
      // the stored key. On failure (a stale key from a previous build) fall
      // through to the form, which the inline script had pre-hidden.
      void decryptWithStoredKey(payload).then((html) => {
        if (html !== null) void reveal(wrapper, html);
        else wrapper.removeAttribute('data-resuming');
      });

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (getLockoutRemainingMs() > 0) {
          applyLockState(wrapper);
          return;
        }
        errorEl?.setAttribute('hidden', '');
        const html = await tryUnlockNda(input.value, payload);
        if (html !== null) {
          await reveal(wrapper, html);
        } else if (!applyLockState(wrapper)) {
          errorEl?.removeAttribute('hidden');
        }
      });
    });
  }
  document.addEventListener('astro:page-load', initPasswordGate);
</script>

<style>
  .password-gate-wrapper[data-unlocked] .password-gate,
  .password-gate-wrapper[data-resuming] .password-gate {
    display: none;
  }

  .password-gate {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-2xl);
    min-height: 70vh;
    padding: var(--spacing-4xl) 40px;
    justify-content: center;
  }
  .password-gate__title {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: var(--font-size-2xl);
    line-height: var(--font-line-height-4xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-emphasis);
  }
  .password-gate__controls {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-xl);
  }
  .password-gate__error {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: var(--font-size-sm);
    line-height: var(--font-line-height-sm);
    color: var(--color-text-secondary);
  }
  /* :global() — InputField has no disabled styling of its own; matches the
     class-merge convention used elsewhere (e.g. ProjectCard's
     .project-card__arrow). Button already handles :disabled on its own. */
  .password-gate :global(.input-field__input:disabled) {
    opacity: 0.4;
    cursor: not-allowed;
  }

  @media (max-width: 767px) {
    .password-gate {
      padding: var(--spacing-3xl) 24px;
    }
  }
</style>
