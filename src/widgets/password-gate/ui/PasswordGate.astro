---
// Wraps NDA project content (Figma `password-gate`, node 2326:1850,
// on the standalone Password page — reused here inline on a project page
// instead of a separate route, so unlocking reveals the real content in
// place). Client-side-only gate — see shared/lib/password-gate.ts for why
// that's the ceiling on what this can actually protect.
//
// `active=false` renders the slot directly with no gate/JS at all — lets
// callers always wrap content in <PasswordGate active={...}> instead of
// duplicating the content markup across a gated/ungated branch.
import { InputField, Button } from '@shared/ui';

interface Props {
  active?: boolean;
}

const { active = true } = Astro.props;
---

{!active && <slot />}

{
  active && (
<div class="password-gate-wrapper" data-password-gate>
  <script is:inline>
    (function () {
      const wrapper = document.currentScript.closest('[data-password-gate]');
      if (sessionStorage.getItem('nda-unlocked') === '1') {
        wrapper.setAttribute('data-unlocked', '');
      }
    })();
  </script>

  <div class="password-gate">
    <p class="password-gate__title">Enter the Password</p>
    <form class="password-gate__controls" data-password-gate-form>
      <InputField label="Password" type="password" name="password" placeholder="Enter Your Password" />
      <Button type="solid">Enter</Button>
      <p class="password-gate__error" data-password-gate-error hidden>
        Incorrect password — try again.
      </p>
      <p class="password-gate__error" data-password-gate-locked hidden></p>
    </form>
  </div>

  <div class="password-gate__content">
    <slot />
  </div>
</div>
  )
}

<script>
  import { tryUnlockNda, getLockoutRemainingMs } from '@shared/lib';

  function formatRemaining(ms: number): string {
    const totalMinutes = Math.ceil(ms / 60000);
    const hours = Math.floor(totalMinutes / 60);
    const minutes = totalMinutes % 60;
    return hours > 0 ? `${hours}h ${minutes}m` : `${minutes}m`;
  }

  // Disables the form and shows the remaining time while a lockout (5 failed
  // attempts, see shared/lib/password-gate.ts) is active. Returns whether it
  // is locked, so the submit handler can skip the plain "incorrect password"
  // message when a failure just triggered the lock.
  function applyLockState(wrapper: HTMLElement): boolean {
    const form = wrapper.querySelector<HTMLFormElement>('[data-password-gate-form]');
    const input = form?.querySelector<HTMLInputElement>('input[name="password"]');
    const button = form?.querySelector<HTMLButtonElement>('button.button');
    const lockedEl = wrapper.querySelector<HTMLElement>('[data-password-gate-locked]');
    if (!form || !input || !button || !lockedEl) return false;

    const remaining = getLockoutRemainingMs();
    input.disabled = remaining > 0;
    button.disabled = remaining > 0;
    if (remaining > 0) {
      lockedEl.textContent = `Too many attempts — try again in ${formatRemaining(remaining)}.`;
      lockedEl.removeAttribute('hidden');
    } else {
      lockedEl.setAttribute('hidden', '');
    }
    return remaining > 0;
  }

  // Not inside any transition:persist region — unguarded re-init on every
  // astro:page-load, same as ProcessAccordion/InputField.
  function initPasswordGate() {
    document.querySelectorAll<HTMLElement>('[data-password-gate]').forEach((wrapper) => {
      const form = wrapper.querySelector<HTMLFormElement>('[data-password-gate-form]');
      const errorEl = wrapper.querySelector<HTMLElement>('[data-password-gate-error]');
      const input = form?.querySelector<HTMLInputElement>('input[name="password"]');
      if (!form || !input) return;

      applyLockState(wrapper);

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (getLockoutRemainingMs() > 0) {
          applyLockState(wrapper);
          return;
        }
        errorEl?.setAttribute('hidden', '');
        const correct = await tryUnlockNda(input.value);
        if (correct) {
          wrapper.setAttribute('data-unlocked', '');
        } else if (!applyLockState(wrapper)) {
          errorEl?.removeAttribute('hidden');
        }
      });
    });
  }
  document.addEventListener('astro:page-load', initPasswordGate);
</script>

<style>
  .password-gate-wrapper[data-unlocked] .password-gate {
    display: none;
  }
  .password-gate-wrapper:not([data-unlocked]) .password-gate__content {
    display: none;
  }

  .password-gate {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-2xl);
    min-height: 70vh;
    padding: var(--spacing-4xl) 40px;
    justify-content: center;
  }
  .password-gate__title {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: var(--font-size-2xl);
    line-height: var(--font-line-height-4xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-emphasis);
  }
  .password-gate__controls {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-xl);
  }
  .password-gate__error {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: var(--font-size-sm);
    line-height: var(--font-line-height-sm);
    color: var(--color-text-secondary);
  }
  /* :global() — InputField has no disabled styling of its own; matches the
     class-merge convention used elsewhere (e.g. ProjectCard's
     .project-card__arrow). Button already handles :disabled on its own. */
  .password-gate :global(.input-field__input:disabled) {
    opacity: 0.4;
    cursor: not-allowed;
  }

  @media (max-width: 767px) {
    .password-gate {
      padding: var(--spacing-3xl) 24px;
    }
  }
</style>
