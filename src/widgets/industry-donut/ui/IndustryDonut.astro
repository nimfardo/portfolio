---
// /about's Industries donut (canvas node 2738:1786). Five arcs, direct labels,
// career figure in the centre.
//
// ── Why five arcs, and why a sequential ramp ────────────────────────────────
// The palette is single-hue (obsidian-amber), and a pie's colours do a
// *categorical* job — telling identities apart. One hue cannot do that, so the
// dataviz validator FAILs any amber set on its normal-vision floor by
// construction. Two measurements against the dark surface (#110a03) shape this
// component, and both were run, not estimated:
//   * obsidian-amber-700 (#4d2d0e) measures 1.59:1 — below the 3:1 floor, so
//     600 is the darkest usable step in dark mode.
//   * 300 (#e0964d) and 400 (#da852f) are perceptually ONE tone, adjacent
//     ΔE 4.4 — a hard fail that secondary encoding cannot excuse — so 400 is
//     skipped in dark mode.
// That leaves five steps with real separation. The ramp is legitimate as a
// SEQUENTIAL ramp (the validator's own scope note: monotonic lightness is the
// applicable check) ONLY because every arc is labelled on the ring, so colour
// carries order and never identity.
//
// ⚠ If this is ever changed to a legend/swatch treatment, that reasoning
// collapses — the reader would then have to match colour to identity, and the
// palette must be re-derived from scratch.
//
// ── Why the ramp is *selected* per theme, never flipped ────────────────────
// The dark ramp is invisible in light mode: #faeee1 measures 1.02:1 on the
// light surface (#ededed). So light mode gets its own steps, running
// largest-is-darkest (standard on a light ground) — the inverse of dark mode's
// largest-is-lightest, where luminance against the ground is what reads. In the
// light set only 400 dips below 3:1 (2.43), which the direct labels relieve.
//
// ── Why the labels live inside the viewBox ─────────────────────────────────
// A fixed-width stage overflows: the 66% body column is ~880px at a 1440
// viewport, and the longest label reaches ~932px from the stage's left edge.
// Putting labels in the scaling viewBox makes overflow impossible at any width
// and keeps the direct labels the colour reasoning depends on.
import { INDUSTRIES, CAREER_YEARS } from '../model/industries';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;

// Stage matches the canvas frame; the SVG scales to its container.
const W = 1071;
const H = 520;
const CX = W / 2;
const CY = H / 2;
const R = 190;
const INNER = R * 0.88;
const R_MID = (R + INNER) / 2;
// 3px of surface between fills, per the dataviz mark spec, expressed as the
// angle that subtends 3px at the band's mid-radius.
const GAP = 3 / R_MID;

const total = INDUSTRIES.reduce((sum, d) => sum + d.years, 0);
const point = (angle: number, radius: number) =>
  [CX + Math.cos(angle) * radius, CY + Math.sin(angle) * radius] as const;

let cursor = -Math.PI / 2; // 12 o'clock
const arcs = INDUSTRIES.map((d, i) => {
  const span = (d.years / total) * Math.PI * 2;
  const a0 = cursor + GAP / 2;
  const a1 = cursor + span - GAP / 2;
  const mid = cursor + span / 2;
  cursor += span;

  const [ox0, oy0] = point(a0, R);
  const [ox1, oy1] = point(a1, R);
  const [ix1, iy1] = point(a1, INNER);
  const [ix0, iy0] = point(a0, INNER);
  const large = a1 - a0 > Math.PI ? 1 : 0;

  const [lx, ly] = point(mid, R + 10);
  const isRight = Math.cos(mid) >= 0;
  // 2.5 renders as "2.5 YRS"; whole numbers drop the decimal.
  const yrs = `${d.years}${d.years === 1 ? ' YR' : ' YRS'}`;

  return {
    label: d.label,
    years: d.years,
    path: `M ${ox0} ${oy0} A ${R} ${R} 0 ${large} 1 ${ox1} ${oy1} L ${ix1} ${iy1} A ${INNER} ${INNER} 0 ${large} 0 ${ix0} ${iy0} Z`,
    step: i + 1,
    leaderX1: isRight ? lx : lx - 28,
    leaderX2: isRight ? lx + 28 : lx,
    leaderY: ly,
    textX: isRight ? lx + 40 : lx - 40,
    textY: ly,
    anchor: isRight ? 'start' : 'end',
    text: `${d.label.toUpperCase()}   ${yrs}`,
  };
});
---

<div class:list={['donut', className]}>
  {
    /* Decorative: every value is in the list below, which is the accessible
      equivalent the dataviz method requires (a table/list view must exist). */
  }
  <svg
    class="donut__svg"
    viewBox={`0 0 ${W} ${H}`}
    role="presentation"
    aria-hidden="true"
    focusable="false"
  >
    {arcs.map((a) => <path class={`donut__seg donut__seg--${a.step}`} d={a.path} />)}
    {
      arcs.map((a) => (
        <line class="donut__leader" x1={a.leaderX1} y1={a.leaderY} x2={a.leaderX2} y2={a.leaderY} />
      ))
    }
    {
      arcs.map((a) => (
        <text class="donut__label" x={a.textX} y={a.textY} text-anchor={a.anchor}>
          {a.text}
        </text>
      ))
    }
    <text class="donut__figure" x={CX} y={CY} text-anchor="middle">{CAREER_YEARS}</text>
    <text class="donut__figure-caption" x={CX} y={CY + 34} text-anchor="middle">Years</text>
  </svg>

  {
    /* The centre figure lives in the SVG, which is aria-hidden — so this carries
      it for screen readers at every width, and becomes the *visible* figure
      below 768px. There the viewBox scales 1071 -> 260, which would render the
      "YEARS" caption at ~3px of mush. Same one-node-two-presentations trick as
      the list. */
  }
  <p class="donut__total">{CAREER_YEARS} years</p>

  {
    /* One list, two presentations: the screen-reader equivalent at every width,
      and the *visible* data below 768px — where a scaled viewBox would render
      14px labels at ~5px. Nothing is duplicated. */
  }
  <ul class="donut__list">
    {
      INDUSTRIES.map((d, i) => (
        <li class="donut__list-item">
          <span class={`donut__swatch donut__seg--${i + 1}`} aria-hidden="true" />
          <span class="donut__list-label">{d.label}</span>
          <span class="donut__list-years">
            {d.years} {d.years === 1 ? 'year' : 'years'}
          </span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  /* Dark mode (default): largest slice is LIGHTEST, because luminance against
     the near-black ground is what makes an arc read. 400 is skipped — it is
     perceptually identical to 300 (ΔE 4.4). */
  .donut {
    --donut-1: var(--color-obsidian-amber-50);
    --donut-2: var(--color-obsidian-amber-200);
    --donut-3: var(--color-obsidian-amber-300);
    --donut-4: var(--color-obsidian-amber-500);
    --donut-5: var(--color-obsidian-amber-600);
  }
  /* Light mode: a SELECTED ramp, not a flip. The dark steps measure as low as
     1.02:1 on #ededed. Largest is darkest here, the standard direction on a
     light ground. */
  :global([data-theme='light']) .donut {
    --donut-1: var(--color-obsidian-amber-800);
    --donut-2: var(--color-obsidian-amber-700);
    --donut-3: var(--color-obsidian-amber-600);
    --donut-4: var(--color-obsidian-amber-500);
    --donut-5: var(--color-obsidian-amber-400);
  }

  .donut__svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .donut__seg--1 {
    fill: var(--donut-1);
  }
  .donut__seg--2 {
    fill: var(--donut-2);
  }
  .donut__seg--3 {
    fill: var(--donut-3);
  }
  .donut__seg--4 {
    fill: var(--donut-4);
  }
  .donut__seg--5 {
    fill: var(--donut-5);
  }
  .donut__leader {
    stroke: var(--color-text-primary);
    stroke-width: 1;
  }
  /* Text wears text tokens, never a series colour — a labelled arc beside it
     carries the identity (dataviz non-negotiable). */
  .donut__label {
    fill: var(--color-text-emphasis);
    font-family: var(--font-family-body);
    font-size: 14px;
    letter-spacing: 0.56px;
    dominant-baseline: middle;
  }
  .donut__figure {
    fill: var(--color-text-emphasis);
    font-family: var(--font-family-body);
    font-size: 64px;
    font-weight: var(--font-weight-bold);
    dominant-baseline: middle;
  }
  .donut__figure-caption {
    fill: var(--color-text-primary);
    font-family: var(--font-family-body);
    font-size: 12px;
    letter-spacing: 0.48px;
    text-transform: uppercase;
  }

  .donut__list,
  .donut__total {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
    list-style: none;
  }

  @media (max-width: 767px) {
    /* Below 768px the viewBox scales labels to ~5px, so the ring keeps only its
       arcs and the list becomes the data. The reader still never matches colour
       to identity — each row states its own label and years. */
    .donut__svg {
      max-width: 260px;
      margin: 0 auto;
    }
    .donut__label,
    .donut__leader,
    /* Both would scale to ~15px and ~3px respectively — the caption is
       illegible and the pair reads as a smudge. The visible .donut__total
       below replaces them. */
    .donut__figure,
    .donut__figure-caption {
      display: none;
    }
    .donut__total {
      position: static;
      width: auto;
      height: auto;
      clip: auto;
      overflow: visible;
      margin: var(--spacing-lg) 0 0;
      font-family: var(--font-family-body);
      font-size: var(--font-size-3xl);
      line-height: var(--font-line-height-3xl);
      font-weight: var(--font-weight-medium);
      color: var(--color-text-emphasis);
      text-align: center;
    }
    .donut__list {
      position: static;
      width: auto;
      height: auto;
      margin: var(--spacing-xl) 0 0;
      clip: auto;
      white-space: normal;
      overflow: visible;
      display: flex;
      flex-direction: column;
      gap: var(--spacing-sm);
    }
    .donut__list-item {
      display: flex;
      align-items: center;
      gap: var(--spacing-sm);
      font-family: var(--font-family-body);
      font-size: var(--font-size-sm);
      line-height: var(--font-line-height-sm);
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--color-text-emphasis);
    }
    .donut__swatch {
      flex-shrink: 0;
      width: 10px;
      height: 10px;
      /* Swatch classes reuse the arc fills, which are `fill:` not
         `background:` — set the box colour explicitly here. */
      background: currentColor;
    }
    .donut__swatch.donut__seg--1 {
      color: var(--donut-1);
    }
    .donut__swatch.donut__seg--2 {
      color: var(--donut-2);
    }
    .donut__swatch.donut__seg--3 {
      color: var(--donut-3);
    }
    .donut__swatch.donut__seg--4 {
      color: var(--donut-4);
    }
    .donut__swatch.donut__seg--5 {
      color: var(--donut-5);
    }
    .donut__list-label {
      flex: 1;
    }
    .donut__list-years {
      color: var(--color-text-primary);
      white-space: nowrap;
    }
  }
</style>
