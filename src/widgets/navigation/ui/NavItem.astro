---
import { Icon } from '@shared/ui';
import type { IconName } from '@shared/ui';

interface Props {
  href: string;
  active?: boolean;
  large?: boolean;
  /** Opens in a new tab. The CV is the only nav entry that leaves the site. */
  external?: boolean;
  /** Trailing 16px glyph, beside the label. Optional — most items have none. */
  icon?: IconName;
}

const { href, active = false, large = false, external = false, icon } = Astro.props;
---

<a
  href={href}
  class:list={['nav-item', { 'nav-item--large': large }]}
  aria-current={active ? 'page' : undefined}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  <span class="nav-item__label"><slot /></span>
  {icon && <Icon name={icon} size={16} class="nav-item__icon" />}
</a>

<style>
  /* Underline wipe adapted from wearemotto.com/work's `.uline` pattern
     (wiki/concepts/motto-motion-patterns.md): one pseudo-element, flipping
     `transform-origin` between rest and hover/active so the same scaleX
     transition reads as "wipes in from the left, retreats to the right"
     instead of a plain fade. Replaces the old active-only indicator span —
     hover and the active-page state now share one mechanism.

     ⚠ The underline lives on the LABEL, not the anchor, and that distinction
     is load-bearing (bug-052). It sat on the anchor for as long as the label
     was the anchor's only child, so the two boxes were the same width and
     nothing gave the shortcut away. `CV` then gained a trailing 16px glyph and
     the underline stretched 24px past the word, running under the gap and the
     icon while the other three items still ended at their last letter. The
     underline is a *label* affordance; the anchor stays the hover target. */
  .nav-item {
    display: inline-flex;
    /* Row, not column: the label used to be the only child so the axis did not
       matter, and a trailing glyph in a column would stack under the text.
       Canvas puts the download icon beside "CV" (label at x=0 w=19, icon at
       x=27), which is an 8px gap. */
    flex-direction: row;
    align-items: center;
    gap: var(--spacing-sm);
    padding-bottom: 6px;
    text-decoration: none;
    font-family: var(--font-family-body);
    font-size: var(--font-size-sm);
    line-height: var(--font-line-height-sm);
    font-weight: var(--font-weight-regular);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-primary);
  }
  .nav-item__label {
    position: relative;
  }
  .nav-item__label::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    /* -6px, not 0: the anchor's own `padding-bottom: 6px` still reserves the
       gap, so the rule hangs that far below the label rather than sitting on
       its baseline box. Same rendered position as before the move. */
    bottom: -6px;
    height: 1.5px;
    background: var(--color-icon-default);
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform var(--duration-slow) var(--ease-reveal);
  }
  /* Trigger is still the whole anchor — hovering the CV glyph underlines the
     word, which is what a single link should do. */
  .nav-item:hover .nav-item__label::after,
  .nav-item[aria-current='page'] .nav-item__label::after {
    transform-origin: left center;
    transform: scaleX(1);
  }
  .nav-item--large {
    font-size: var(--font-size-lg);
    line-height: var(--font-line-height-lg);
    font-weight: var(--font-weight-bold);
  }
  /* :global() — the class merges onto Icon's own rendered <span>, which is a
     classlist merge rather than a descendant, so a scoped selector never
     matches it. Same gotcha every other Icon consumer documents. */
  :global(.nav-item__icon) {
    color: var(--color-icon-default);
  }
</style>
