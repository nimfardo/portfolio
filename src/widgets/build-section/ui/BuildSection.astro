---
import { Stat } from '@entities/stat';
import type { StatData } from '@entities/stat';
import { Heading, ZoomPan } from '@shared/ui';

interface Props {
  sitemap: { dark: string; light: string };
  caption: string;
  stats: StatData[];
}

const { sitemap, caption, stats } = Astro.props;
---

<section class="build-section">
  <Heading class="build-section__heading">Build</Heading>
  <div class="build-section__body" data-reveal>
    <div class="build-section__sitemap-frame">
      <ZoomPan>
        <img
          class="build-section__sitemap-dark"
          src={sitemap.dark}
          alt="CONNECTIS sitemap"
          loading="lazy"
        />
        <img
          class="build-section__sitemap-light"
          src={sitemap.light}
          alt="CONNECTIS sitemap"
          loading="lazy"
        />
      </ZoomPan>
    </div>
    <p class="build-section__caption">{caption}</p>
    <div class="build-section__stats">
      {stats.map((stat) => <Stat value={stat.value} unit={stat.unit} label={stat.label} />)}
    </div>
  </div>
</section>

<style>
  .build-section {
    display: grid;
    /* 33/66 proportional split — see ContentSection.astro for the Figma
       reference-column rationale. */
    grid-template-columns: repeat(3, 1fr);
    column-gap: 80px;
    align-items: start;
  }
  :global(.build-section__heading) {
    grid-column: 1 / 2;
  }
  .build-section__body {
    grid-column: 2 / 4;
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 80px;
  }
  .build-section__sitemap-frame {
    /* Same box every other content image on this page uses (see
       ContentSection.astro) — was free-height-sized to the PNG's own
       intrinsic ratio before, now a fixed, consistent frame; ZoomPan/the
       diagram fit inside via object-fit:contain instead of the photo
       object-fit:cover other sections use, so graph content never crops. */
    aspect-ratio: 1071 / 630;
    padding: 40px;
    background: var(--color-bg-subtle);
  }
  /* Default (dark) shows .build-section__sitemap-dark; light theme swaps to
     .build-section__sitemap-light — same display:none/block pattern as
     AnimatedLogo's own dark/light asset swap, since these SVGs bake their
     colors in at render time rather than using currentColor. !important is
     needed here: ZoomPan's own `.zoom-pan__content :global(img)` rule (1
     class + 1 attribute + 1 element) outranks this plain class selector (1
     class + 1 attribute) on specificity alone, so without it ZoomPan's
     generic display:block wins and both images show at once. */
  .build-section__sitemap-light {
    display: none !important;
  }
  :global([data-theme='light']) .build-section__sitemap-dark {
    display: none !important;
  }
  :global([data-theme='light']) .build-section__sitemap-light {
    display: block !important;
  }
  .build-section__caption {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: var(--font-size-4xl);
    line-height: var(--font-line-height-5xl);
    letter-spacing: -0.4px;
    font-weight: var(--font-weight-medium);
    color: var(--color-text-emphasis);
  }
  .build-section__stats {
    display: flex;
    gap: 40px;
  }

  @media (max-width: 1023px) {
    .build-section {
      grid-template-columns: 1fr;
      gap: var(--spacing-xl);
    }
    :global(.build-section__heading) {
      grid-column: 1;
    }
    .build-section__body {
      grid-column: 1;
    }
  }
  @media (max-width: 480px) {
    .build-section__stats {
      flex-direction: column;
      gap: var(--spacing-lg);
    }
  }
</style>
