---
// The interactive Mermaid sitemap (feat-027) that used to sit here — two
// pre-rendered SVGs inlined via set:html and wrapped in ZoomPan — was
// replaced by a plain media slot at Max's request: same image|video union
// every other slot on this page uses. ZoomPan, both sitemap SVGs and their
// .mmd sources are all left on disk unreferenced rather than deleted.
import { Stat } from '@entities/stat';
import type { StatData } from '@entities/stat';
import { Media } from '@entities/media';
import { Heading } from '@shared/ui';
import type { ProjectMedia } from '@entities/project';

interface Props {
  media: ProjectMedia;
  caption: string;
  stats: StatData[];
}

const { media, caption, stats } = Astro.props;
---

<section class="build-section">
  <Heading class="build-section__heading">Build</Heading>
  <div class="build-section__body" data-reveal>
    {
      media.type === 'image' ? (
        <img class="build-section__media" src={media.image} alt={media.imageAlt} loading="lazy" />
      ) : (
        <Media
          type="video"
          class="build-section__media"
          src={media.src}
          poster={media.poster}
          alt={media.alt}
        />
      )
    }
    <p class="build-section__caption">{caption}</p>
    <div class="build-section__stats">
      {stats.map((stat) => <Stat value={stat.value} unit={stat.unit} label={stat.label} />)}
    </div>
  </div>
</section>

<style>
  .build-section {
    display: grid;
    /* 33/66 proportional split — see ContentSection.astro for the Figma
       reference-column rationale. */
    grid-template-columns: repeat(3, 1fr);
    column-gap: 80px;
    align-items: start;
  }
  :global(.build-section__heading) {
    grid-column: 1 / 2;
  }
  .build-section__body {
    grid-column: 2 / 4;
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 80px;
  }
  /* Same box every other content media on this page uses (see
     ContentSection.astro) — no padding/bg-subtle frame anymore: that
     existed to give the Mermaid diagram breathing room, and the video
     fills the frame edge to edge at its native 1070x630.
     :global() for the usual classlist-merge reason — in the video branch
     the class lands on Media's own rendered root, not a descendant. */
  :global(.build-section__media) {
    width: 100%;
    aspect-ratio: 1071 / 630;
    object-fit: cover;
  }
  .build-section__caption {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: var(--font-size-4xl);
    line-height: var(--font-line-height-5xl);
    letter-spacing: -0.4px;
    font-weight: var(--font-weight-medium);
    color: var(--color-text-emphasis);
  }
  .build-section__stats {
    display: flex;
    gap: 40px;
  }

  @media (max-width: 1023px) {
    .build-section {
      grid-template-columns: 1fr;
      gap: var(--spacing-xl);
    }
    :global(.build-section__heading) {
      grid-column: 1;
    }
    .build-section__body {
      grid-column: 1;
    }
  }
  @media (max-width: 480px) {
    .build-section__stats {
      flex-direction: column;
      gap: var(--spacing-lg);
    }
  }
</style>
