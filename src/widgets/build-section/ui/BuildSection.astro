---
// Was an interactive Mermaid sitemap (feat-027) — two pre-rendered SVGs
// inlined via set:html inside a ZoomPan wrapper — until Max replaced it
// with a plain media slot on the same image|video union every other slot
// on this page uses. ZoomPan and the rendered SVGs are gone; the .mmd
// sources stay in reference/design-system/diagrams/ as case-study
// documentation of the product's real route structure.
//
// feat-033: generalized from one media+caption to media+text blocks —
// CONNECTIS gained a second block (the shared Glacier Flow video) and a
// GitHub button; defenceSystems's whole Build section is that one Glacier block.
// Stats render after the first block's text, the button after the last.
import { Stat } from '@entities/stat';
import { Media } from '@entities/media';
import { Button, Heading } from '@shared/ui';
import { staggerDelay } from '@shared/lib';
import type { BuildData } from '@entities/project';

interface Props {
  blocks: BuildData['blocks'];
  stats?: BuildData['stats'];
  githubUrl?: string;
}

const { blocks, stats, githubUrl } = Astro.props;
const lastIndex = blocks.length - 1;
---

<section class="section-grid build-section">
  <Heading class="section-grid__aside build-section__heading">Build</Heading>
  <div class="section-grid__body build-section__body">
    {
      blocks.map((block, i) => (
        <div class="build-section__block" data-reveal style={`--reveal-delay: ${staggerDelay(i, 100)}`}>
          {block.media.type === 'image' ? (
            <img class="build-section__media" src={block.media.image} alt={block.media.imageAlt} loading="lazy" />
          ) : (
            <Media
              type="video"
              class="build-section__media"
              src={block.media.src}
              poster={block.media.poster}
              alt={block.media.alt}
            />
          )}
          <p class="section-prose build-section__caption">{block.text}</p>
          {i === 0 && stats && (
            <div class="build-section__stats">
              {stats.map((stat) => (
                <Stat value={stat.value} unit={stat.unit} label={stat.label} />
              ))}
            </div>
          )}
          {i === lastIndex && githubUrl && (
            <Button type="outlined" href={githubUrl} class="build-section__button">
              GitHub
            </Button>
          )}
        </div>
      ))
    }
  </div>
</section>

<style>
  /* Grid, column spans and the 1023px collapse come from .section-grid in
     global.css (ref-005). */
  .build-section__body {
    display: flex;
    flex-direction: column;
    /* 80px between stacked blocks — measured off the canvas (block 1 ends
       y=992, block 2 starts y=1072 on CONNECTIS's Build). */
    gap: 80px;
  }
  .build-section__block {
    display: flex;
    flex-direction: column;
    /* 64px media->text->stats/button rhythm, same as ContentSection's
       blocks and consistent across both pages' canvases. */
    gap: 64px;
  }
  /* Same box every other content media on this page uses (see
     ContentSection.astro) — no padding/bg-subtle frame anymore: that
     existed to give the Mermaid diagram breathing room, and the video
     fills the frame edge to edge at its native 1070x630.
     :global() for the usual classlist-merge reason — in the video branch
     the class lands on Media's own rendered root, not a descendant. */
  :global(.build-section__media) {
    width: 100%;
    aspect-ratio: 1071 / 630;
    object-fit: cover;
  }
  /* Type ramp comes from .section-prose in global.css. */
  .build-section__caption {
    white-space: pre-line;
  }
  .build-section__stats {
    display: flex;
    gap: 40px;
  }
  /* Fixed 320px per Figma, same as Retrospective's Behance button — the
     flex column would otherwise stretch it full-width. */
  :global(.build-section__button) {
    align-self: flex-start;
  }

  @media (max-width: 480px) {
    .build-section__stats {
      flex-direction: column;
      gap: var(--spacing-lg);
    }
  }
</style>
