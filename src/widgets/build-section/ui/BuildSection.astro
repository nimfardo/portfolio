---
import { Stat } from '@entities/stat';
import type { StatData } from '@entities/stat';
import { Heading } from '@shared/ui';

interface Props {
  sitemapImage: string;
  caption: string;
  stats: StatData[];
}

const { sitemapImage, caption, stats } = Astro.props;
---

<section class="build-section">
  <Heading class="build-section__heading">Build</Heading>
  <div class="build-section__body">
    <div class="build-section__sitemap">
      <p class="build-section__sitemap-label">Sitemap:</p>
      <div class="build-section__sitemap-frame">
        <img src={sitemapImage} alt="CONNECTIS sitemap" loading="lazy" />
      </div>
    </div>
    <p class="build-section__caption">{caption}</p>
    <div class="build-section__stats">
      {stats.map((stat) => <Stat value={stat.value} label={stat.label} />)}
    </div>
  </div>
</section>

<style>
  .build-section {
    display: grid;
    /* 33/66 proportional split — see ContentSection.astro for the Figma
       reference-column rationale. */
    grid-template-columns: repeat(3, 1fr);
    column-gap: 80px;
    align-items: start;
  }
  :global(.build-section__heading) {
    grid-column: 1 / 2;
  }
  .build-section__body {
    grid-column: 2 / 4;
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 80px;
  }
  .build-section__sitemap {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xl);
  }
  .build-section__sitemap-label {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: var(--font-size-2xl);
    /* 48px, not the shared 2xl token (32px) — see Heading.astro. */
    line-height: 48px;
    font-weight: var(--font-weight-bold);
    color: var(--color-text-emphasis);
  }
  .build-section__sitemap-frame {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px;
    background: var(--color-bg-subtle);
  }
  .build-section__sitemap-frame img {
    width: 100%;
    height: auto;
  }
  .build-section__caption {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: var(--font-size-xl);
    line-height: 2;
    color: var(--color-text-emphasis);
  }
  .build-section__stats {
    display: flex;
    gap: 40px;
  }

  @media (max-width: 1023px) {
    .build-section {
      grid-template-columns: 1fr;
      gap: var(--spacing-xl);
    }
    :global(.build-section__heading) {
      grid-column: 1;
    }
    .build-section__body {
      grid-column: 1;
    }
  }
  @media (max-width: 480px) {
    .build-section__stats {
      flex-direction: column;
      gap: var(--spacing-lg);
    }
  }
</style>
