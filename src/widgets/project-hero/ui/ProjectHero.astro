---
import { Divider, Icon } from '@shared/ui';

// The top hero is now just a bare full-bleed image + a "Scroll down" cue
// (Figma dropped the tags/eyebrow/headline card from it — tags moved to
// widgets/overview-section, see connectis.ts). The eyebrow/headline card
// below is still used by the mid-page Challenge interstitial, but only
// until that section is migrated onto ContentSection's generalized
// `blocks` prop (see STATE.md) — this component will lose the card
// entirely once that lands, leaving just the bare-image+scroll-cue shape.
interface Props {
  image: string;
  imageAlt: string;
  eyebrow?: string;
  headline?: string[];
  scrollCue?: boolean;
  class?: string;
}

const { image, imageAlt, eyebrow, headline, scrollCue, class: className } = Astro.props;
const hasCard = Boolean(eyebrow && headline);
---

<section class:list={['project-hero', className]}>
  <div class:list={['project-hero__image-wrap', { 'project-hero__image-wrap--card': hasCard }]}>
    <img class="project-hero__image" src={image} alt={imageAlt} loading="lazy" />
  </div>
  {
    scrollCue && (
      <div class="project-hero__scroll-cue">
        <p class="project-hero__scroll-text">Scroll down</p>
        <Icon name="scroll" size={28} />
      </div>
    )
  }
  {
    hasCard && (
      <div class="project-hero__card">
        <p class="project-hero__eyebrow">{eyebrow}</p>
        <Divider class="project-hero__divider" />
        <p class="project-hero__headline">
          {headline!.map((line) => <span>{line}</span>)}
        </p>
      </div>
    )
  }
</section>

<style>
  .project-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .project-hero__image-wrap {
    position: relative;
    width: 100%;
    height: 800px;
  }
  /* Only the card variant needs the image pulled up underneath it — the
     bare scroll-cue variant sits in normal flow below the image instead. */
  .project-hero__image-wrap--card {
    margin-bottom: -230px;
  }
  .project-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-hero__scroll-cue {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    margin-top: 40px;
    color: var(--color-icon-default);
  }
  .project-hero__scroll-text {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: var(--font-size-xs);
    line-height: var(--font-line-height-xs);
    color: var(--color-text-primary);
  }

  .project-hero__card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-lg);
    width: 100%;
    max-width: 1487px;
    padding: 80px;
    background: var(--color-bg-subtle);
  }
  .project-hero__eyebrow {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: var(--font-size-xl);
    line-height: var(--font-line-height-xl);
    color: var(--color-text-emphasis);
  }
  .project-hero__card :global(.divider) {
    width: 480px;
  }
  .project-hero__headline {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding-bottom: 40px;
    font-family: var(--font-family-body);
    font-size: var(--font-size-5xl);
    line-height: var(--font-line-height-5xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.02em;
    text-align: center;
    text-transform: uppercase;
    color: var(--color-text-emphasis);
  }

  @media (max-width: 767px) {
    .project-hero__image-wrap {
      height: 400px;
    }
    .project-hero__image-wrap--card {
      margin-bottom: -120px;
    }
    .project-hero__card {
      padding: var(--spacing-xl);
    }
    .project-hero__headline {
      font-size: var(--font-size-3xl);
      line-height: var(--font-line-height-3xl);
    }
    .project-hero__card :global(.divider) {
      width: 240px;
    }
  }
</style>
