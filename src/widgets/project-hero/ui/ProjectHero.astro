---
import { Divider } from '@shared/ui';

// Reused for both the top Hero (with tags) and the Deliverables interstitial
// further down the page (same "important-text-container" pattern in Figma,
// just without tags) — pass `tags` only for the hero.
interface Props {
  image: string;
  imageAlt: string;
  eyebrow: string;
  headline: string[];
  tags?: string[];
  class?: string;
}

const { image, imageAlt, eyebrow, headline, tags, class: className } = Astro.props;
---

<section class:list={['project-hero', className]}>
  <div class="project-hero__image-wrap">
    <img class="project-hero__image" src={image} alt={imageAlt} loading="lazy" />
    {
      tags && tags.length > 0 && (
        <ul class="project-hero__tags">
          {tags.map((tag) => (
            <li class="project-hero__tag">{tag}</li>
          ))}
        </ul>
      )
    }
  </div>
  <div class="project-hero__card">
    <p class="project-hero__eyebrow">{eyebrow}</p>
    <Divider class="project-hero__divider" />
    <p class="project-hero__headline">
      {headline.map((line) => <span>{line}</span>)}
    </p>
  </div>
</section>

<style>
  .project-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .project-hero__image-wrap {
    position: relative;
    width: 100%;
    height: 800px;
    margin-bottom: -230px;
  }
  .project-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .project-hero__tags {
    position: absolute;
    top: 16px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 15px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .project-hero__tag {
    padding: 8px 14px;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-full);
    background: rgba(0, 0, 0, 0.3);
    font-family: var(--font-family-body);
    font-size: var(--font-size-xs);
    line-height: var(--font-line-height-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-emphasis);
    white-space: nowrap;
  }

  .project-hero__card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-lg);
    width: 100%;
    max-width: 1487px;
    padding: 80px;
    background: var(--color-bg-subtle);
  }
  .project-hero__eyebrow {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: var(--font-size-xl);
    line-height: var(--font-line-height-xl);
    color: var(--color-text-emphasis);
  }
  .project-hero__card :global(.divider) {
    width: 480px;
  }
  .project-hero__headline {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding-bottom: 40px;
    font-family: var(--font-family-body);
    font-size: var(--font-size-5xl);
    line-height: var(--font-line-height-5xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.02em;
    text-align: center;
    text-transform: uppercase;
    color: var(--color-text-emphasis);
  }

  @media (max-width: 767px) {
    .project-hero__image-wrap {
      height: 400px;
      margin-bottom: -120px;
    }
    .project-hero__card {
      padding: var(--spacing-xl);
    }
    .project-hero__headline {
      font-size: var(--font-size-3xl);
      line-height: var(--font-line-height-3xl);
    }
    .project-hero__card :global(.divider) {
      width: 240px;
    }
  }
</style>
