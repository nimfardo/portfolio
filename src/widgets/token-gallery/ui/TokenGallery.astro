---
// /system's token exhibit. Every swatch below is styled by the CSS custom
// property it names — `style={`background: var(${t.name})`}` — and every
// printed value comes from the same parse (`read-tokens.ts`) that produced
// the swatch. There is nothing hand-typed here to drift from `tokens.css`.
//
// Categories mirror the file's own sections (Primitive/Semantic/Spacing/
// Radius/Typography/Motion) via a name-prefix map in read-tokens.ts, not a
// parse of the file's prose comments — the light-mode block's comment is
// several sentences of rationale, not a category label, so prefix matching
// is the more robust boundary.
//
// Figma correspondence (the story's acceptance criteria) is just the raw
// `--token-name` printed next to its value: the naming already maps 1:1 to
// the Figma Sandbox file's variable names (tokens.css's own header), so no
// separate mapping table is built or maintained here.
//
// Category titles ("Colors — Primitive" etc.) used to render through the
// shared Heading atom — the exact same component as the page's own
// Overview/Tokens/Components labels one level up, so a category read as a
// peer of the page's own sections instead of a child of "Tokens" (Max's
// review). `.token-gallery__group-label` is a smaller, plain-text style
// instead — sized and coloured to match `.component-gallery__group-label`
// (ComponentGallery.astro) exactly, so the two galleries share one visual
// language for "this is a subgroup, not a section" (feat-112).
import { tokensByCategory, LIGHT_OVERRIDES } from '../model/read-tokens';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const primitives = tokensByCategory('Primitive');
const semantics = tokensByCategory('Semantic');
const spacing = tokensByCategory('Spacing');
const radius = tokensByCategory('Radius');
const typography = tokensByCategory('Typography');
const motion = tokensByCategory('Motion');

// The scale ladder pairs each font-size-X with font-line-height-X by suffix
// — the two are separate token families in the file, joined here only for
// display, not stored as a joined fact anywhere.
const sizeTokens = typography.filter((t) => t.name.startsWith('--font-size-'));
const lineHeightByStep = new Map(
  typography
    .filter((t) => t.name.startsWith('--font-line-height-'))
    .map((t) => [t.name.replace('--font-line-height-', ''), t]),
);
const scale = sizeTokens.map((size) => {
  const step = size.name.replace('--font-size-', '');
  return { step, size, lineHeight: lineHeightByStep.get(step) };
});
const familyToken = typography.find((t) => t.name === '--font-family-body')!;
const weightTokens = typography.filter((t) => t.name.startsWith('--font-weight-'));

const durations = motion.filter((t) => t.name.startsWith('--duration-'));
const eases = motion.filter((t) => t.name.startsWith('--ease-'));
// Two honest demos rather than one fabricated cross-product: durations are
// compared against ONE fixed ease, and eases against ONE fixed duration —
// the file never pairs a specific duration with a specific ease, so nothing
// here invents that it does.
const DURATION_DEMO_EASE = '--ease-fade';
const EASE_DEMO_DURATION = '--duration-base';
---

<div class:list={['token-gallery', className]}>
  <section class="token-gallery__section" data-reveal>
    <p class="token-gallery__group-label">Colors — Primitive</p>
    <ul class="token-gallery__cards">
      {
        primitives.map((t) => (
          <li class="token-gallery__card">
            <span class="token-gallery__chip" style={`background: var(${t.name})`} />
            <span class="token-gallery__card-text">
              <code class="token-gallery__name">{t.name}</code>
              <span class="token-gallery__value">{t.value}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="token-gallery__section" data-reveal>
    <p class="token-gallery__group-label">Colors — Semantic</p>
    <ul class="token-gallery__cards">
      {
        semantics.map((t) => (
          <li class="token-gallery__card">
            <span class="token-gallery__chip" style={`background: var(${t.name})`} />
            <span class="token-gallery__card-text">
              <code class="token-gallery__name">{t.name}</code>
              <span class="token-gallery__value">
                dark {t.value} · light {LIGHT_OVERRIDES.get(t.name)}
              </span>
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="token-gallery__section" data-reveal>
    <p class="token-gallery__group-label">Spacing</p>
    <ul class="token-gallery__cards">
      {
        spacing.map((t) => (
          <li class="token-gallery__card">
            <span class="token-gallery__chip token-gallery__chip--spacing">
              <span class="token-gallery__spacing-bar" style={`width: var(${t.name})`} />
            </span>
            <span class="token-gallery__card-text">
              <code class="token-gallery__name">{t.name}</code>
              <span class="token-gallery__value">{t.value}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="token-gallery__section" data-reveal>
    <p class="token-gallery__group-label">Radius</p>
    <ul class="token-gallery__cards">
      {
        radius.map((t) => (
          <li class="token-gallery__card">
            <span
              class="token-gallery__chip token-gallery__chip--radius"
              style={`border-radius: var(${t.name})`}
            />
            <span class="token-gallery__card-text">
              <code class="token-gallery__name">{t.name}</code>
              <span class="token-gallery__value">{t.value}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="token-gallery__section" data-reveal>
    <p class="token-gallery__group-label">Typography</p>
    <p class="token-gallery__type-meta" style={`font-family: var(${familyToken.name})`}>
      <code class="token-gallery__name">{familyToken.name}</code>
      <span class="token-gallery__value">{familyToken.value}</span>
    </p>
    <ul class="token-gallery__type-weights">
      {
        weightTokens.map((t) => (
          <li style={`font-weight: var(${t.name})`}>
            <code class="token-gallery__name">{t.name}</code>
            <span class="token-gallery__value">{t.value}</span>
          </li>
        ))
      }
    </ul>
    <ul class="token-gallery__scale">
      {
        scale.map(({ size, lineHeight }) => (
          <li class="token-gallery__scale-row">
            <span
              class="token-gallery__scale-sample"
              style={`font-size: var(${size.name}); line-height: var(${lineHeight ? lineHeight.name : size.name});`}
            >
              Ag
            </span>
            <code class="token-gallery__name">{size.name}</code>
            <span class="token-gallery__value">
              {size.value}
              {lineHeight ? ` / ${lineHeight.value} line-height` : ''}
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="token-gallery__section" data-reveal>
    <p class="token-gallery__group-label">Motion</p>
    <p class="token-gallery__motion-caption">Durations, shown against a fixed {DURATION_DEMO_EASE}:</p>
    <ul class="token-gallery__cards">
      {
        durations.map((d) => (
          <li class="token-gallery__card">
            <span class="token-gallery__chip token-gallery__chip--motion">
              <span
                class="token-gallery__motion-demo"
                style={`transition-duration: var(${d.name}); transition-timing-function: var(${DURATION_DEMO_EASE});`}
              />
            </span>
            <span class="token-gallery__card-text">
              <code class="token-gallery__name">{d.name}</code>
              <span class="token-gallery__value">{d.value}</span>
            </span>
          </li>
        ))
      }
    </ul>
    <p class="token-gallery__motion-caption">Curves, shown against a fixed {EASE_DEMO_DURATION}:</p>
    <ul class="token-gallery__cards">
      {
        eases.map((e) => (
          <li class="token-gallery__card">
            <span class="token-gallery__chip token-gallery__chip--motion">
              <span
                class="token-gallery__motion-demo"
                style={`transition-duration: var(${EASE_DEMO_DURATION}); transition-timing-function: var(${e.name});`}
              />
            </span>
            <span class="token-gallery__card-text">
              <code class="token-gallery__name">{e.name}</code>
              <span class="token-gallery__value">{e.value}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </section>
</div>

<style>
  .token-gallery {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4xl);
  }

  .token-gallery__section {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  /* One tier below the page's own "Tokens" aside label (Heading, in
     system.astro's section-grid) and matched byte-for-byte against
     ComponentGallery's `.component-gallery__group-label` — same size,
     weight, casing and colour, so "this is a subgroup" reads identically in
     both galleries. */
  .token-gallery__group-label {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-primary);
  }

  /* Card grid — every Primitive/Semantic/Spacing/Radius/Motion token is a
     bordered, rounded panel (swatch left, name+value stacked right)
     instead of the old bare flex-wrap list. auto-fill keeps the grid
     honest at any width: it never leaves a lone card stranded on its own
     row the way a fixed column count would at odd container widths. */
  .token-gallery__cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--spacing-md);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .token-gallery__card {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    min-width: 0;
    padding: var(--spacing-md);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    background: var(--color-bg-subtle);
  }
  .token-gallery__card-text {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    min-width: 0;
  }

  .token-gallery__chip {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border-default);
  }
  .token-gallery__chip--radius {
    background: var(--color-bg-accent);
    /* border-radius arrives inline per token — this chip has no radius of its own to conflict with. */
  }
  /* Spacing and Motion chips have no colour of their own — they're a
     bounded 48px frame holding a small demo (a bar, a translating square)
     instead of a flat fill, so every card in the grid still reads at one
     consistent size regardless of what the token actually measures. */
  .token-gallery__chip--spacing,
  .token-gallery__chip--motion {
    display: flex;
    align-items: center;
    background: var(--color-bg-muted);
    overflow: hidden;
  }
  .token-gallery__chip--spacing {
    padding: 0 var(--spacing-xs);
  }
  .token-gallery__spacing-bar {
    height: var(--spacing-sm);
    max-width: 100%;
    background: var(--color-bg-accent);
  }
  .token-gallery__chip--motion {
    justify-content: center;
  }
  .token-gallery__motion-demo {
    width: 16px;
    height: 16px;
    border-radius: var(--radius-sm);
    background: var(--color-bg-accent);
    transition-property: transform;
  }
  @media (hover: hover) and (pointer: fine) {
    .token-gallery__card:hover .token-gallery__motion-demo {
      transform: translateX(16px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .token-gallery__motion-demo {
      transition: none;
    }
  }

  /* Name and value share one restrained palette across the whole page:
     `--color-text-secondary` (a vivid, saturated orange reserved elsewhere
     for links/accents) used to carry every token name, which is what read
     as "too many colored texts" fighting the swatches themselves for
     attention. `--color-text-primary` is the same ramp at a much lower
     saturation — legible and on-brand without competing. */
  .token-gallery__name {
    font-family: monospace;
    font-size: var(--font-size-xs);
    color: var(--color-text-primary);
  }

  .token-gallery__value {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .token-gallery__type-meta {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--spacing-sm);
    font-size: var(--font-size-lg);
    color: var(--color-text-primary);
  }
  .token-gallery__type-weights {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-lg);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .token-gallery__scale {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* Grid, not flex: the "Ag" sample runs 12px (xs) to 128px (9xl), and a
     flex row sizes the name/value pair to start right after whatever the
     sample rendered at, so the ramp read as a staircase instead of a
     table. A fixed sample column pins name/value to one vertical line
     regardless of glyph size — 240px comfortably clears the 9xl sample. */
  .token-gallery__scale-row {
    display: grid;
    grid-template-columns: 240px auto 1fr;
    align-items: baseline;
    column-gap: var(--spacing-lg);
    row-gap: var(--spacing-xs);
  }
  .token-gallery__scale-sample {
    font-family: var(--font-family-body);
    color: var(--color-text-primary);
  }

  .token-gallery__motion-caption {
    margin: 0;
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }
</style>
