---
// The 12-step workflow as a horizontally-scrolled rail. The active step drives
// the detail panel, the counter and the progress bar below.
//
// Structure adapted from Codrops' "Horizontal Smooth Scroll Layout" demo 2
// (Max's reference) — a windowed rail where items bleed off the right edge.
// The styling deliberately does NOT follow it: that demo frames a photograph
// per item, tilts it, and floats a circular button over it. There are no
// photographs here, so a frame would enclose nothing and read as a broken
// image. Each step is an index entry instead — a hairline rule, a small number
// and icon, the title, and its outputs as plain text.
//
// Outputs are deliberately NOT pills. They are metadata; in bordered capsules
// they out-shouted the step titles, and the uppercase treatment mangled
// filenames into README.MD. As middot-separated text they recede and keep
// their real casing.
//
// No new dependency: the reference uses Locomotive Scroll, this uses native
// overflow-x + scroll-snap and an IntersectionObserver, the same primitive
// shared/lib/scroll-reveal.ts already uses.
import { Icon } from '@shared/ui';
import { PROCESS_STEPS } from '../model/steps';

const first = PROCESS_STEPS[0];
const total = String(PROCESS_STEPS.length).padStart(2, '0');
---

<section class="rail-section">
  <div class="rail" data-process-rail role="list">
    {
      PROCESS_STEPS.map((step, i) => (
        <article
          class:list={['step', i === 0 && 'is-active']}
          role="listitem"
          data-step={i}
          data-action={step.action}
          data-number={step.number}
        >
          <span class="step__rule" aria-hidden="true" />
          <div class="step__top">
            <span class="step__number">{step.number}</span>
            <Icon name={step.icon} size={22} class="step__icon" />
          </div>
          <h2 class="step__title">{step.title}</h2>
          <p class="step__outputs">{step.outputs.join(' · ')}</p>
        </article>
      ))
    }
  </div>

  <div class="rail-axis">
    <span class="rail-axis__progress" data-process-progress></span>
  </div>

  <p class="rail-meta">
    <span data-process-counter>{first.number} / {total}</span>
    <span class="rail-meta__sep">·</span>
    <span>The 12-Step AI-Design Workflow</span>
  </p>

  <div class="rail-detail">
    <p class="rail-detail__label">Action</p>
    <p class="rail-detail__text" data-process-action>{first.action}</p>
  </div>
</section>

<script>
  function initProcessRail() {
    document.querySelectorAll<HTMLElement>('[data-process-rail]').forEach((rail) => {
      const steps = [...rail.querySelectorAll<HTMLElement>('.step')];
      if (!steps.length) return;
      const section = rail.closest('.rail-section');
      if (!section) return;
      const actionEl = section.querySelector<HTMLElement>('[data-process-action]');
      const counterEl = section.querySelector<HTMLElement>('[data-process-counter]');
      const progressEl = section.querySelector<HTMLElement>('[data-process-progress]');
      const total = steps.length;

      progressEl?.style.setProperty('--rail-progress', `${100 / total}%`);

      let active = -1;
      const setActive = (index: number) => {
        if (index === active || index < 0 || index >= total) return;
        active = index;
        steps.forEach((s, i) => s.classList.toggle('is-active', i === index));
        const step = steps[index];
        if (actionEl) actionEl.textContent = step.dataset.action ?? '';
        if (counterEl) {
          counterEl.textContent = `${step.dataset.number} / ${String(total).padStart(2, '0')}`;
        }
        if (progressEl) progressEl.style.transform = `translateX(${index * 100}%)`;
      };

      // The leading card — the left-most one still fully in view — is active.
      // Observing against the rail rather than the viewport keeps that correct
      // however far down the page the user has scrolled.
      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((e) => e.isIntersecting)
            .map((e) => Number((e.target as HTMLElement).dataset.step))
            .sort((a, b) => a - b);
          if (visible.length) setActive(visible[0]);
        },
        { root: rail, threshold: 0.85 },
      );
      steps.forEach((s) => observer.observe(s));
      setActive(0);
    });
  }

  // Not inside a transition:persist region, so this re-runs cleanly on every
  // navigation — same as ProcessAccordion and PasswordGate. No resize handling
  // needed: the observer's root is the rail itself, so it re-evaluates on its
  // own when a breakpoint changes the card width.
  document.addEventListener('astro:page-load', initProcessRail);
</script>

<style>
  .rail-section {
    display: flex;
    flex-direction: column;
  }

  .rail {
    display: flex;
    gap: 48px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-left: 40px;
    padding: 0 40px;
    /* hidden deliberately — the axis below is the scroll affordance */
    scrollbar-width: none;
  }
  .rail::-webkit-scrollbar {
    display: none;
  }

  .step {
    flex: 0 0 392px;
    width: 392px;
    scroll-snap-align: start;
    opacity: 0.42;
    transition: opacity var(--duration-slow) var(--ease-fade);
  }
  .step.is-active {
    opacity: 1;
  }

  /* The rule is the whole frame. A 2px active state rather than a colour-only
     change so it still reads at a glance in both themes. */
  .step__rule {
    display: block;
    height: 1px;
    margin-bottom: 22px;
    background: var(--color-border-default);
    transition:
      background-color var(--duration-slow) var(--ease-fade),
      height var(--duration-slow) var(--ease-fade);
  }
  .step.is-active .step__rule {
    height: 2px;
    margin-bottom: 21px;
    background: var(--color-border-emphasis);
  }

  .step__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }
  .step__number {
    font-family: var(--font-family-body);
    font-size: var(--font-size-xs);
    line-height: var(--font-line-height-xs);
    letter-spacing: 0.12em;
    color: var(--color-text-primary);
  }
  /* :global() — the class merges onto Icon's own rendered <span>, which carries
     Icon.astro's astro-cid, not this component's. Icon deliberately declares no
     colour of its own (bug-004), so this is the only declaration on it. */
  :global(.step__icon) {
    color: var(--color-icon-default);
  }
  .step.is-active :global(.step__icon) {
    color: var(--color-text-emphasis);
  }

  .step__title {
    /* Two lines' worth, so single-line titles still push the outputs down to a
       shared baseline across the rail. */
    min-height: 63px;
    margin: 0 0 26px;
    font-family: var(--font-family-body);
    font-size: var(--font-size-3xl);
    line-height: 31px;
    letter-spacing: -0.4px;
    font-weight: var(--font-weight-medium);
    color: var(--color-text-emphasis);
  }

  .step__outputs {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: var(--font-size-sm);
    line-height: var(--font-line-height-sm);
    letter-spacing: 0.02em;
    color: var(--color-text-primary);
    opacity: 0.62;
  }
  .step.is-active .step__outputs {
    opacity: 0.9;
  }

  .rail-axis {
    position: relative;
    height: 1px;
    margin: 96px 40px 0;
    background: var(--color-border-default);
  }
  .rail-axis__progress {
    position: absolute;
    top: -1px;
    left: 0;
    height: 3px;
    width: var(--rail-progress, 8.3333%);
    background: var(--color-text-emphasis);
    transition: transform var(--duration-slow) var(--ease-reveal);
  }

  .rail-meta {
    margin: 26px 0 0;
    padding: 0 40px;
    font-family: var(--font-family-body);
    font-size: var(--font-size-xs);
    line-height: var(--font-line-height-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-primary);
    opacity: 0.45;
  }
  .rail-meta__sep {
    margin: 0 10px;
  }

  .rail-detail {
    margin-top: 80px;
    padding: 0 40px;
    text-align: right;
  }
  .rail-detail__label {
    margin: 0 0 16px;
    font-family: var(--font-family-body);
    font-size: var(--font-size-xs);
    line-height: var(--font-line-height-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-primary);
    opacity: 0.4;
  }
  .rail-detail__text {
    margin: 0 0 0 auto;
    max-width: 1240px;
    font-family: var(--font-family-body);
    font-size: var(--font-size-4xl);
    line-height: var(--font-line-height-5xl);
    letter-spacing: -0.5px;
    font-weight: var(--font-weight-medium);
    color: var(--color-text-emphasis);
  }

  @media (max-width: 1023px) {
    .step {
      flex-basis: 340px;
      width: 340px;
    }
    .rail {
      gap: 40px;
    }
    .rail-axis {
      margin-top: 72px;
    }
    .rail-detail {
      margin-top: 60px;
    }
  }

  @media (max-width: 767px) {
    /* One card plus a peek of the next, so the rail still reads as scrollable
       on a phone — a fixed 392px card would overflow a 375px viewport. */
    .step {
      flex-basis: 78vw;
      width: 78vw;
    }
    .rail,
    .rail-meta,
    .rail-detail {
      padding-left: 24px;
      padding-right: 24px;
    }
    .rail-axis {
      margin-left: 24px;
      margin-right: 24px;
    }
    .step__title {
      min-height: 0;
    }
    .rail-detail {
      text-align: left;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .step,
    .step__rule,
    .rail-axis__progress {
      transition: none;
    }
  }
</style>
