---
// The 12-step workflow as a horizontally-scrolled rail — four cards visible at
// desktop, the rest reached by scrolling sideways.
//
// Synced to Max's Figma restyle (node 2124:1834): a hairline rule per step
// that thickens to 2px when active, a 32px icon above the title, and the
// step's outputs as pill tags. There is no step number on the card and no
// detail panel below — both were in an earlier pass and he removed them.
//
// The pills use OverviewSection's tag treatment rather than a shared atom.
// The `Tag` atom that used to exist was stale — it rendered
// --color-text-secondary (orange) while the Figma master is cream — and had
// no consumers, so it was deleted in feat-045. Two copies of this treatment
// now exist (here and OverviewSection); a third would justify extracting it.
//
// No new dependency: the Codrops reference this is adapted from uses
// Locomotive Scroll, this uses native overflow-x plus an IntersectionObserver,
// the same primitive shared/lib/scroll-reveal.ts already uses.
import { Icon } from '@shared/ui';
import { PROCESS_STEPS } from '../model/steps';
---

<section class="rail-section">
  <div class="rail" data-process-rail role="list">
    {
      PROCESS_STEPS.map((step, i) => (
        <article class:list={['step', i === 0 && 'is-active']} role="listitem" data-step={i}>
          <span class="step__rule" aria-hidden="true" />
          <div class="step__body">
            <Icon name={step.icon} size={32} class="step__icon" />
            <h2 class="step__title">{step.title}</h2>
          </div>
          <ul class="step__outputs">
            {step.outputs.map((out) => (
              <li class="step__output">{out}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>

  <div class="rail-axis">
    <span class="rail-axis__progress" data-process-progress></span>
  </div>
</section>

<script>
  function initProcessRail() {
    document.querySelectorAll<HTMLElement>('[data-process-rail]').forEach((rail) => {
      const steps = [...rail.querySelectorAll<HTMLElement>('.step')];
      if (!steps.length) return;
      const section = rail.closest('.rail-section');
      const progressEl = section?.querySelector<HTMLElement>('[data-process-progress]');
      const total = steps.length;

      progressEl?.style.setProperty('--rail-progress', `${100 / total}%`);

      let active = -1;
      const setActive = (index: number) => {
        if (index === active || index < 0 || index >= total) return;
        active = index;
        steps.forEach((s, i) => s.classList.toggle('is-active', i === index));
        if (progressEl) progressEl.style.transform = `translateX(${index * 100}%)`;
      };

      // The leading card — the left-most one still fully in view — is active.
      // Observing against the rail rather than the viewport keeps that correct
      // however far down the page the reader has scrolled vertically.
      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((e) => e.isIntersecting)
            .map((e) => Number((e.target as HTMLElement).dataset.step))
            .sort((a, b) => a - b);
          if (visible.length) setActive(visible[0]);
        },
        { root: rail, threshold: 0.85 },
      );
      steps.forEach((s) => observer.observe(s));
      setActive(0);
    });
  }

  // Not inside a transition:persist region, so this re-runs cleanly on every
  // navigation — same as ProcessAccordion and PasswordGate.
  document.addEventListener('astro:page-load', initProcessRail);
</script>

<style>
  .rail {
    display: flex;
    gap: 48px;
    overflow-x: auto;
    /* `proximity`, not `mandatory`: this rail sits between a lead paragraph
       and the Build section, so a mandatory snap fights vertical page
       scrolling on trackpads that emit both axes at once. */
    scroll-snap-type: x proximity;
    scroll-padding-left: 40px;
    padding: 0 40px;
    /* hidden deliberately — the axis below is the scroll affordance */
    scrollbar-width: none;
    /* keep sideways swipes in the rail from triggering browser back-nav */
    overscroll-behavior-x: contain;
  }
  .rail::-webkit-scrollbar {
    display: none;
  }

  .step {
    display: flex;
    flex-direction: column;
    gap: 40px;
    flex: 0 0 392px;
    width: 392px;
    scroll-snap-align: start;
    opacity: 0.42;
    transition: opacity var(--duration-slow) var(--ease-fade);
  }
  .step.is-active {
    opacity: 1;
  }

  /* The rule is the whole frame. A thickness change as well as a colour change
     so the active step still reads at a glance in both themes. */
  .step__rule {
    display: block;
    height: 1px;
    background: var(--color-border-default);
    transition:
      background-color var(--duration-slow) var(--ease-fade),
      height var(--duration-slow) var(--ease-fade);
  }
  .step.is-active .step__rule {
    height: 2px;
    background: var(--color-border-emphasis);
  }

  .step__body {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  /* :global() — the class merges onto Icon's own rendered <span>, which
     carries Icon.astro's astro-cid, not this component's. Icon declares no
     colour of its own (bug-004), so this is the only declaration on it. */
  :global(.step__icon) {
    color: var(--color-icon-default);
  }
  .step.is-active :global(.step__icon) {
    color: var(--color-text-emphasis);
  }

  .step__title {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: var(--font-size-3xl);
    line-height: 31px;
    letter-spacing: -0.4px;
    font-weight: var(--font-weight-medium);
    color: var(--color-text-emphasis);
  }

  .step__outputs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Matches the Figma tag master (node 2119:1692) and OverviewSection's tags:
     cream border and text, not the stale orange the old Tag atom used. */
  .step__output {
    padding: 8px 14px;
    border: 1px solid var(--color-border-emphasis);
    border-radius: var(--radius-full);
    font-family: var(--font-family-body);
    font-size: var(--font-size-xs);
    line-height: var(--font-line-height-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-emphasis);
    white-space: nowrap;
  }

  .rail-axis {
    position: relative;
    height: 1px;
    margin: 96px 40px 0;
    background: var(--color-border-default);
  }
  .rail-axis__progress {
    position: absolute;
    top: -1px;
    left: 0;
    height: 3px;
    width: var(--rail-progress, 8.3333%);
    background: var(--color-text-emphasis);
    transition: transform var(--duration-slow) var(--ease-reveal);
  }

  @media (max-width: 1023px) {
    .step {
      flex-basis: 340px;
      width: 340px;
    }
    .rail {
      gap: 40px;
    }
    .rail-axis {
      margin-top: 72px;
    }
  }

  @media (max-width: 767px) {
    /* One card plus a peek of the next, so the rail still reads as scrollable
       on a phone — a fixed 392px card would overflow a 375px viewport. */
    .step {
      flex-basis: 78vw;
      width: 78vw;
    }
    .rail {
      padding-left: 24px;
      padding-right: 24px;
    }
    .rail-axis {
      margin-left: 24px;
      margin-right: 24px;
    }
    /* A single nowrap pill can be wider than a phone screen — same fix
       OverviewSection needed at this breakpoint (feat-033). */
    .step__output {
      white-space: normal;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .step,
    .step__rule,
    .rail-axis__progress {
      transition: none;
    }
  }
</style>
