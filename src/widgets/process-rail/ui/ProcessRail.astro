---
// The 12-step workflow as a rail of cards.
//
// Two layouts, one markup. At >=1024px with motion allowed the section is
// pinned: it stands as tall as the track is wide, the viewport sticks for
// that distance, and the track slides sideways 1:1 with the reader's vertical
// scroll (feat-048). Everywhere else — narrow viewports, reduced motion, or
// no JS at all — it is a plain vertical stack of 12 entries. The stack is the
// base stylesheet and pinning is a script-added class on top of it, so the
// fallback is what you get by default rather than what you get after a
// failure.
//
// Synced to Max's Figma restyle (node 2124:1834): a hairline rule per step
// that thickens to 2px when active, a 32px icon above the title, and the
// step's outputs as pill tags.
//
// The step number and the step's one-line action are back on the card
// (feat-047). feat-046 had removed both to match canvas, which left every
// card as a title plus two filenames — a numbered process rendered without
// numbers, and no answer anywhere on the page to "what actually happens at
// this step". The `action` strings were already written and sitting unused
// in the model. Canvas is still the source of truth for this widget, so
// node 2659:1752 owes a resync.
//
// The pills use OverviewSection's tag treatment rather than a shared atom.
// The `Tag` atom that used to exist was stale — it rendered
// --color-text-secondary (orange) while the Figma master is cream — and had
// no consumers, so it was deleted in feat-045. Two copies of this treatment
// now exist (here and OverviewSection); a third would justify extracting it.
//
// Still no new dependency: the Codrops reference this is adapted from uses
// Locomotive Scroll; this is a sticky element and one rAF-throttled scroll
// listener.
import { Icon } from '@shared/ui';
import { PROCESS_STEPS } from '../model/steps';
---

<!-- A <section> with an accessible name is a `region` landmark on its own; no
  explicit role needed. It is also the *only* thing naming this group now that
  Max has taken the visible "The 12-Step Workflow" heading off the page
  (feat-050) — which is why the step titles are h2 rather than h3: with no
  parent heading left, h3 would skip a level under the page's h1. -->
<section class="rail-section" aria-label="The 12-step AI-design workflow" data-rail-section>
  <div class="rail-viewport" data-rail-viewport>
    <div class="rail-clip">
      <ol class="rail" data-process-rail>
        {
          PROCESS_STEPS.map((step, i) => (
            <li class:list={['step', i === 0 && 'is-active']}>
              <span class="step__rule" aria-hidden="true" />
              <div class="step__body">
                <span class="step__number">{step.number}</span>
                <Icon name={step.icon} size={32} class="step__icon" />
                <h2 class="step__title">{step.title}</h2>
                <p class="step__action">{step.action}</p>
              </div>
              <ul class="step__outputs">
                {step.outputs.map((out) => (
                  <li class="step__output">{out}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="rail-progress">
      <div class="rail-axis" data-process-axis>
        <span class="rail-axis__progress" data-process-progress></span>
      </div>
      {
        /* Duplicates what a screen reader already gets from 12 numbered list
        items, and a live region here would interrupt on every step change
        during a continuous scroll. Sighted-reader affordance only. */
      }
      <p class="rail-counter" aria-hidden="true">
        <span data-process-counter>01</span> / {String(PROCESS_STEPS.length).padStart(2, '0')}
      </p>
      {
        /* When the band locks, vertical scrolling stops paying out vertical
        movement — the moment that reads as "is this stuck?". This nudges
        sideways to say where the movement went, and retires itself once the
        reader has passed step 1 and clearly knows. Same vocabulary as the
        hero's bouncing scroll cue, turned 90°. Decorative: the counter it sits
        beside is aria-hidden for the same reason. */
      }
      <span class="rail-hint" aria-hidden="true">
        {/* Wrapped because Icon's Props are explicit with no attribute
        pass-through, so aria-hidden on the component itself is dropped —
        the same reason VideoSection wraps Media (feat-041). */}
        <Icon name="arrow-right" size={16} class="rail-hint__icon" />
      </span>
    </div>
  </div>
</section>

<script>
  function initProcessRail() {
    const sections = document.querySelectorAll<HTMLElement>('[data-rail-section]');
    if (!sections.length) return;

    // ClientRouter swaps the DOM without a page unload, so a scroll listener
    // bound here outlives the page it belongs to and keeps writing transforms
    // to detached nodes. One controller per init, aborted on the way out.
    const controller = new AbortController();
    const { signal } = controller;
    document.addEventListener('astro:before-swap', () => controller.abort(), { once: true });

    sections.forEach((section) => {
      const viewport = section.querySelector<HTMLElement>('[data-rail-viewport]');
      const rail = section.querySelector<HTMLElement>('[data-process-rail]');
      const progressEl = section.querySelector<HTMLElement>('[data-process-progress]');
      const counterEl = section.querySelector<HTMLElement>('[data-process-counter]');
      if (!viewport || !rail) return;
      const steps = [...rail.querySelectorAll<HTMLElement>('.step')];
      if (!steps.length) return;
      const total = steps.length;

      // Mirrors the pinned-mode media query exactly, `min-height` included —
      // the viewport is sized to its content, so a window shorter than the
      // band would pin rows that can never be scrolled into view.
      const roomy = window.matchMedia('(min-width: 1024px) and (min-height: 700px)');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
      const canPin = () => roomy.matches && !reduced.matches;

      // Page scroll spent per pixel of track movement. At 1:1 the rail cost
      // 4588px — 67% of the whole document — to deliver twelve short cards,
      // ~368px of scrolling each. The track still crosses its full width and
      // still tracks progress exactly; only the price in wheel-turns changes.
      const SCROLL_RATIO = 0.6;
      // How late the highlight hands over, in card-widths. See update().
      const ACTIVE_BIAS = 0.25;

      let travel = 0;
      let scrollSpan = 0;
      let stickOffset = 0;
      let lastWidth = -1;
      let active = -1;

      const setActive = (index: number) => {
        if (index === active) return;
        active = index;
        steps.forEach((s, i) => s.classList.toggle('is-active', i === index));
        if (counterEl) counterEl.textContent = String(index + 1).padStart(2, '0');
        // Past steps dim harder than upcoming ones, so the rail reads
        // forward instead of spotlighting one card in a uniform haze
        // (feat-058).
        steps.forEach((s, i) => s.classList.toggle('is-past', i < index));
        // The sideways hint retires once the reader is clearly moving. Not at
        // step 1: that boundary is only ~145px of scroll past the lock, so the
        // hint began fading before it could be read.
        section.classList.toggle('is-advanced', index > 1);
      };

      // p is derived from the section's own rect rather than a cached document
      // offset: while the viewport is stuck, rect.top runs from 0 down to
      // -travel by construction (section height = viewport height + travel),
      // so this stays correct without knowing where the section sits.
      const update = () => {
        if (travel <= 0 || scrollSpan <= 0) return;
        // Measured from the stick point, not from 0 — the band centres itself
        // in the window (feat-055), so `rect.top` runs from stickOffset down
        // to stickOffset - scrollSpan rather than from 0.
        const p = Math.min(
          1,
          Math.max(0, (stickOffset - section.getBoundingClientRect().top) / scrollSpan)
        );
        rail.style.transform = `translate3d(${-p * travel}px, 0, 0)`;
        // Fills continuously off p rather than stepping a one-twelfth segment
        // by whole cards — the counter beside it already carries the discrete
        // reading, so the bar is free to track the gesture itself.
        if (progressEl) progressEl.style.width = `${p * 100}%`;
        // With travel == (total - 1) * pitch, this expression IS the card at
        // the focus gutter — index at the gutter is p*travel/pitch, which is
        // exactly p*(total - 1). Before feat-054 travel stopped at the
        // content's right edge instead, so the two diverged and the current
        // card slid across the screen as you scrolled: it began at the left
        // gutter and finished 809px to the right, never twice in the same
        // place. Both readings agree now, so the highlight holds still and
        // steps 11 and 12 stay reachable (the feat-048 defect) by
        // construction rather than by keying around the geometry.
        //
        // The quarter-step bias shifts WHERE that stable anchor sits. A
        // discrete highlight against continuous motion always slides one full
        // pitch before handing over; unbiased, that slide is centred on the
        // gutter, so the current card spends the back half of its turn cut by
        // the left edge — measured 173px into the clip at worst. Biasing the
        // hand-over a quarter-step later moves the window to roughly
        // [-70, +370], so the highlighted card stays at least 82% visible for
        // its whole turn. Both endpoints stay exact: round(0.25) is 0 and
        // round(11.25) is 11.
        setActive(Math.round(p * (total - 1) + ACTIVE_BIAS));
      };

      const measure = () => {
        if (!canPin()) {
          section.classList.remove('is-pinned');
          section.style.height = '';
          viewport.style.top = '';
          rail.style.transform = '';
          if (progressEl) progressEl.style.width = '';
          steps.forEach((s) => s.classList.remove('is-active', 'is-past'));
          section.classList.remove('is-advanced');
          travel = 0;
          scrollSpan = 0;
          active = -1;
          lastWidth = -1;
          return;
        }
        section.classList.add('is-pinned');
        rail.style.transform = 'translate3d(0, 0, 0)';

        const vp = viewport.getBoundingClientRect();
        // One card-pitch measured off two real card boxes, not from the CSS
        // values — the same reason the old code measured boxes rather than
        // trusting scrollWidth on a container that no longer scrolls.
        const pitch =
          total > 1
            ? steps[1].getBoundingClientRect().left - steps[0].getBoundingClientRect().left
            : 0;
        // The track runs until the LAST card reaches the position the FIRST
        // one started from, so every card gets its turn at the focus gutter.
        // It used to stop as soon as the last card's right edge met the
        // viewport edge, which meant the final cards never reached the gutter
        // at all — the root cause of both the wandering highlight and
        // feat-048's unreachable steps 11 and 12. The cost is roughly one
        // viewport of empty track past the last card, which reads as the end
        // of the sequence rather than as missing content.
        travel = Math.max(0, pitch * (total - 1));
        scrollSpan = travel * SCROLL_RATIO;
        lastWidth = vp.width;

        // Centre the band in the window while it's stuck. Sized to its content
        // it is 563px in a 900px window, so a third of the screen sat empty
        // below it for the whole section. This offsets the STICK POINT and
        // leaves the box's own height alone, which is what keeps it different
        // from the centring feat-050 removed: that one made the viewport 100vh
        // and centred inside it, inflating the lead-to-cards distance in the
        // document by ~227px. Nothing here moves in flow — only where the band
        // locks on screen. The padding is subtracted because it sits inside
        // clientHeight but isn't visible content, so centring on the raw box
        // would push the cards low.
        const padTop = parseFloat(getComputedStyle(viewport).paddingTop) || 0;
        const contentH = viewport.clientHeight - padTop;
        stickOffset = Math.max(0, Math.round((window.innerHeight - contentH) / 2 - padTop));
        viewport.style.top = `${stickOffset}px`;

        // The stuck distance is section.height - viewport.height regardless of
        // the offset, so the travel maths is indifferent to it: the band still
        // bottoms out exactly at p == 1.
        section.style.height = `${viewport.clientHeight + scrollSpan}px`;
        update();
      };

      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          update();
        });
      };

      // A sideways trackpad swipe over the rail is the gesture the old
      // overflow-x rail accepted, and it stayed muscle memory after feat-048
      // moved the rail onto vertical scroll — so honour both.
      //
      // Horizontal delta is translated into *page scroll*, not into the
      // transform directly. Scroll position stays the single source of truth,
      // the existing rAF update() does the work, and the two gestures can
      // never disagree about where the rail is. It also means both ends
      // behave identically: scrollBy clamps, so swiping back at p=0 carries
      // on up out of the section exactly as a vertical scroll would.
      //
      // Non-passive because it has to preventDefault — which is also what
      // suppresses the macOS two-finger back-navigation gesture.
      const onWheel = (e: WheelEvent) => {
        if (!canPin() || travel <= 0) return;
        // Vertical-dominant input is left entirely to the browser.
        if (Math.abs(e.deltaY) >= Math.abs(e.deltaX)) return;
        const dx =
          e.deltaMode === 1
            ? e.deltaX * 16 // DOM_DELTA_LINE
            : e.deltaMode === 2
              ? e.deltaX * viewport.clientHeight // DOM_DELTA_PAGE
              : e.deltaX;
        e.preventDefault();
        window.scrollBy(0, dx);
      };
      viewport.addEventListener('wheel', onWheel, { passive: false, signal });

      // The axis looks exactly like a progress bar, and progress bars get
      // clicked. Without this the only way past the rail is to keep scrolling
      // through all twelve steps. Same trick as the wheel handler: it moves
      // the PAGE, so scroll position stays the single source of truth and the
      // existing rAF update() does the rendering.
      //
      // Deliberately not focusable and not a real slider control. The counter
      // beside it is already aria-hidden for the same reason (feat-049): every
      // step is reachable by ordinary scrolling in DOM order, which is the
      // keyboard and screen-reader path, so this is a pointer affordance for
      // sighted readers rather than a second way to navigate that would need
      // its own semantics.
      const axisEl = section.querySelector<HTMLElement>('[data-process-axis]');
      if (axisEl) {
        const scrubTo = (clientX: number) => {
          const r = axisEl.getBoundingClientRect();
          if (r.width <= 0) return;
          const ratio = Math.min(1, Math.max(0, (clientX - r.left) / r.width));
          const sectionTop = section.getBoundingClientRect().top + window.scrollY;
          window.scrollTo(0, Math.round(sectionTop - stickOffset + ratio * scrollSpan));
        };
        axisEl.addEventListener(
          'pointerdown',
          (e) => {
            if (!canPin() || scrollSpan <= 0) return;
            // bug-024 hit a silent throw here that killed the whole gesture.
            try {
              axisEl.setPointerCapture(e.pointerId);
            } catch {
              /* capture is an optimisation; scrubbing still works without it */
            }
            e.preventDefault();
            scrubTo(e.clientX);
          },
          { signal }
        );
        axisEl.addEventListener(
          'pointermove',
          (e) => {
            if (!axisEl.hasPointerCapture(e.pointerId)) return;
            scrubTo(e.clientX);
          },
          { signal }
        );
        const release = (e: PointerEvent) => {
          if (axisEl.hasPointerCapture(e.pointerId)) axisEl.releasePointerCapture(e.pointerId);
        };
        axisEl.addEventListener('pointerup', release, { signal });
        axisEl.addEventListener('pointercancel', release, { signal });
      }

      window.addEventListener('scroll', onScroll, { passive: true, signal });
      window.addEventListener('resize', measure, { signal });
      roomy.addEventListener('change', measure, { signal });
      reduced.addEventListener('change', measure, { signal });

      // Setting the section's height can make the page tall enough to gain a
      // scrollbar, which narrows the viewport and changes `travel` with no
      // window resize event behind it. Guarded on width so the two can't
      // oscillate off each other.
      new ResizeObserver(() => {
        if (canPin() && viewport.getBoundingClientRect().width !== lastWidth) measure();
      }).observe(viewport);

      measure();
    });
  }

  // Not inside a transition:persist region, so this re-runs cleanly on every
  // navigation — same as ProcessAccordion and PasswordGate.
  document.addEventListener('astro:page-load', initProcessRail);
</script>

<style>
  /* Base state is the stacked vertical list — one entry after another, no
     clipping, no transform, nothing for the script to do. Pinning is layered
     on top of it and only ever added by the script, so a JS failure or a
     no-JS reader lands on the layout that always works rather than on a row
     of cards clipped at the viewport edge with no way to reach them. */
  .rail-section {
    margin-top: var(--spacing-4xl);
  }

  .rail {
    display: flex;
    flex-direction: column;
    gap: 64px;
    margin: 0;
    padding: 0 24px;
    list-style: none;
  }

  .step {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  /* The rule is the whole frame — a divider between entries when stacked, and
     the active indicator when pinned. */
  .step__rule {
    display: block;
    height: 1px;
    background: var(--color-border-default);
    transition:
      background-color var(--duration-slow) var(--ease-fade),
      height var(--duration-slow) var(--ease-fade);
  }

  /* Meaningless without a horizontal position to report. */
  .rail-progress {
    display: none;
  }

  /* Only ever shown in pinned mode, where the handoff it explains happens. */
  .rail-hint {
    display: none;
  }

  .step__body {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  /* :global() — the class merges onto Icon's own rendered <span>, which
     carries Icon.astro's astro-cid, not this component's. Icon declares no
     colour of its own (bug-004), so this is the only declaration on it. */
  :global(.step__icon) {
    color: var(--color-icon-default);
  }
  .step.is-active :global(.step__icon) {
    color: var(--color-text-emphasis);
  }

  /* Same label treatment as the output pills below, minus the uppercase
     transform — these are digits. */
  .step__number {
    font-family: var(--font-family-body);
    font-size: var(--font-size-xs);
    line-height: var(--font-line-height-xs);
    letter-spacing: 0.04em;
    color: var(--color-text-primary);
  }

  /* Bound to the Figma text style `Manrope/3xl/medium` — 32/48/-1% — rather
     than the hardcoded 31px line-height and -0.4px tracking it carried before
     (comp-013). Those were left over from a 27px canvas title that had no
     style bound at all and sat off the type scale entirely.

     The line-height is deliberately cross-paired from 4xl: this system's
     scale has one line-height per size step (`--font-line-height-3xl` is
     40px) while Figma's styles differ by weight (3xl/medium is 48, 3xl/bold
     is 40). 4xl's 48px is the exact value the medium style specifies, and
     global.css already documents cross-pairing as the way to hold a ratio
     across breakpoints. Retargeting the 3xl token itself would have moved
     OverviewSection and ProjectHero too. */
  .step__title {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: var(--font-size-3xl);
    line-height: var(--font-line-height-4xl);
    letter-spacing: -0.01em;
    font-weight: var(--font-weight-medium);
    color: var(--color-text-emphasis);
  }

  .step__action {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: var(--font-size-base);
    line-height: var(--font-line-height-base);
    color: var(--color-text-primary);
  }

  .step__outputs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Matches the Figma tag master (node 2119:1692) and OverviewSection's tags:
     cream border and text, not the stale orange the old Tag atom used.

     No `text-transform` here, unlike OverviewSection's tags — these are real
     paths, and uppercasing them printed `README.MD` for a file named
     `README.md`. The page's whole claim is that these artifacts exist in a
     repo, so a filename that couldn't be checked out undercuts it. Mixed case
     also reads faster at 12px. feat-045 had already retired this by dropping
     the pills entirely; feat-046 brought the pills back and the transform with
     them (bug-048). */
  .step__output {
    padding: 8px 14px;
    border: 1px solid var(--color-border-emphasis);
    border-radius: var(--radius-full);
    font-family: var(--font-family-body);
    font-size: var(--font-size-xs);
    line-height: var(--font-line-height-xs);
    letter-spacing: 0.04em;
    color: var(--color-text-emphasis);
    white-space: nowrap;
  }

  /* A single nowrap pill can be wider than a phone screen — same fix
     OverviewSection needed at this breakpoint (feat-033). */
  @media (max-width: 767px) {
    .step__output {
      white-space: normal;
    }
  }

  /* ── Pinned mode ──────────────────────────────────────────────────────────
     feat-048. The rail used to be a second scroll container sitting inside a
     322px band: 12 steps and 5312px of content behind a sideways gesture the
     page gave no reason to expect, with a hidden scrollbar and an axis 96px
     below the cards that read as a section divider. It now advances off the
     vertical scroll the reader is already making — the section is as tall as
     the track is wide, the viewport sticks for that distance, and the track
     translates 1:1 with progress through it. One gesture, nothing hidden.

     Gated on both the class (script-added) and the query, so neither alone
     can pin a phone or a reader who has asked for less motion. The
     `min-height` floor matters because the viewport is sized to its content
     (see below): in a window shorter than the band, sticking it to the top
     would pin content that can never be scrolled into view. Below the floor
     the stacked list takes over, which always works. */
  @media (min-width: 1024px) and (min-height: 700px) and (prefers-reduced-motion: no-preference) {
    /* The section carries no top margin here: the gap to the lead statement
       is the viewport's own padding-top instead, so it stays 160px — the
       same rhythm every case-study section uses — whether the viewport is
       still flowing or already stuck. Centring the content in 100vh (which
       this did until feat-050) added roughly another 227px of dead air above
       the cards on entry, on top of the margin. */
    .rail-section.is-pinned {
      margin-top: 0;
    }
    /* Height is the content's, not 100vh. At 100vh the band's own slack —
       371px in a 900px window, 551px in a 1080px one — sat inside the section
       below the axis, and Build's margin stacked on top of it, so the gap to
       Build measured 467px/647px and *grew with window height*. Sized to
       content, the only thing between the axis and Build is Build's own
       160px margin, at any window height. The travel maths is indifferent:
       `section.height = viewport.clientHeight + travel` means the sticky
       release still lands at `rect.top === -travel` by construction. */
    .rail-section.is-pinned .rail-viewport {
      position: sticky;
      top: 0;
      display: flex;
      flex-direction: column;
      padding-top: 160px;
    }

    /* The clip is a separate box from the viewport so the mask only ever
       touches the cards: a mask on the viewport would fade the heading and
       axis at their ends too, and a mask on the track itself would travel
       with the transform. */
    .rail-section.is-pinned .rail-clip {
      overflow: hidden;
      /* Both edges — the track is clipped left and right, and a hard cut
         through a title mid-stroke reads as a rendering fault rather than as
         content continuing past the frame. The 40px ramps are exactly the
         rail's own gutter, so at rest the first card is pristine and at full
         scroll so is the last; only mid-scroll cards are ever touched. */
      mask-image: linear-gradient(
        to right,
        transparent 0,
        #000 40px,
        #000 calc(100% - 40px),
        transparent 100%
      );
    }

    .rail-section.is-pinned .rail {
      flex-direction: row;
      gap: 48px;
      padding: 0 40px;
      /* No transition — the transform has to track the wheel exactly, or the
         rail lags behind the gesture driving it. */
      will-change: transform;
    }

    /* Three levels, not two — a process reads forward, and dimming every
       non-current card equally made the two thirds of the screen the reader
       is scrolling TOWARD as faint as the part they had already finished.
       Upcoming steps stay bright enough to read ahead; only what's behind
       recedes. 0.65 remains the floor set in feat-047 (cream at 0.42 falls
       under 4.5:1 here; at 0.65 it measures 8.3:1, so this was never a
       contrast problem — it was an attention one). */
    .rail-section.is-pinned .step {
      flex: 0 0 392px;
      width: 392px;
      opacity: 0.85;
      transition: opacity var(--duration-slow) var(--ease-fade);
    }
    .rail-section.is-pinned .step.is-past {
      opacity: 0.65;
    }
    .rail-section.is-pinned .step.is-active {
      opacity: 1;
    }

    /* Thickness as well as colour, so the active step still reads at a glance
       in both themes. */
    .rail-section.is-pinned .step.is-active .step__rule {
      height: 2px;
      background: var(--color-border-emphasis);
    }

    /* Two lines reserved, so every action starts on the same baseline. Eleven
       titles wrap to one line and "Motion & Micro-interactions" wraps to two,
       which pushed that card's action and pills 48px below its neighbours' —
       invisible in a stacked list, obvious when cards stand side by side.
       Pinned mode only: stacked, there is nothing to align against and this
       would just be dead space. */
    .rail-section.is-pinned .step__title {
      min-height: calc(var(--font-line-height-4xl) * 2);
    }

    /* Pinned to the card's bottom edge rather than flowing straight after the
       action text — the actions run one to three lines depending on the step,
       and without this the pills sit at a different height on every card. */
    .rail-section.is-pinned .step__outputs {
