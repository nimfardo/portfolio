---
// The 12-step workflow as a rail of cards.
//
// Two layouts, one markup. At >=1024px with motion allowed the section is
// pinned: it stands as tall as the track is wide, the viewport sticks for
// that distance, and the track slides sideways 1:1 with the reader's vertical
// scroll (feat-048). Everywhere else — narrow viewports, reduced motion, or
// no JS at all — it is a plain vertical stack of 12 entries. The stack is the
// base stylesheet and pinning is a script-added class on top of it, so the
// fallback is what you get by default rather than what you get after a
// failure.
//
// Synced to Max's Figma restyle (node 2124:1834): a hairline rule per step
// that thickens to 2px when active, a 32px icon above the title, and the
// step's outputs as pill tags.
//
// The step number and the step's one-line action are back on the card
// (feat-047). feat-046 had removed both to match canvas, which left every
// card as a title plus two filenames — a numbered process rendered without
// numbers, and no answer anywhere on the page to "what actually happens at
// this step". The `action` strings were already written and sitting unused
// in the model. Canvas is still the source of truth for this widget, so
// node 2659:1752 owes a resync.
//
// The pills use OverviewSection's tag treatment rather than a shared atom.
// The `Tag` atom that used to exist was stale — it rendered
// --color-text-secondary (orange) while the Figma master is cream — and had
// no consumers, so it was deleted in feat-045. Two copies of this treatment
// now exist (here and OverviewSection); a third would justify extracting it.
//
// Still no new dependency: the Codrops reference this is adapted from uses
// Locomotive Scroll; this is a sticky element and one rAF-throttled scroll
// listener.
import { Icon } from '@shared/ui';
import { PROCESS_STEPS } from '../model/steps';
---

<section class="rail-section" data-rail-section>
  <div class="rail-viewport" data-rail-viewport>
    <ol class="rail" data-process-rail>
      {
        PROCESS_STEPS.map((step, i) => (
          <li class:list={['step', i === 0 && 'is-active']} data-step={i}>
            <span class="step__rule" aria-hidden="true" />
            <div class="step__body">
              <span class="step__number">{step.number}</span>
              <Icon name={step.icon} size={32} class="step__icon" />
              <h3 class="step__title">{step.title}</h3>
              <p class="step__action">{step.action}</p>
            </div>
            <ul class="step__outputs">
              {step.outputs.map((out) => (
                <li class="step__output">{out}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>

    <div class="rail-axis">
      <span class="rail-axis__progress" data-process-progress></span>
    </div>
  </div>
</section>

<script>
  function initProcessRail() {
    const sections = document.querySelectorAll<HTMLElement>('[data-rail-section]');
    if (!sections.length) return;

    // ClientRouter swaps the DOM without a page unload, so a scroll listener
    // bound here outlives the page it belongs to and keeps writing transforms
    // to detached nodes. One controller per init, aborted on the way out.
    const controller = new AbortController();
    const { signal } = controller;
    document.addEventListener('astro:before-swap', () => controller.abort(), { once: true });

    sections.forEach((section) => {
      const viewport = section.querySelector<HTMLElement>('[data-rail-viewport]');
      const rail = section.querySelector<HTMLElement>('[data-process-rail]');
      const progressEl = section.querySelector<HTMLElement>('[data-process-progress]');
      if (!viewport || !rail) return;
      const steps = [...rail.querySelectorAll<HTMLElement>('.step')];
      if (!steps.length) return;
      const total = steps.length;

      progressEl?.style.setProperty('--rail-progress', `${100 / total}%`);

      const wide = window.matchMedia('(min-width: 1024px)');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
      const canPin = () => wide.matches && !reduced.matches;

      let travel = 0;
      let lastWidth = -1;
      let active = -1;

      const setActive = (index: number) => {
        if (index === active) return;
        active = index;
        steps.forEach((s, i) => s.classList.toggle('is-active', i === index));
        if (progressEl) progressEl.style.transform = `translateX(${index * 100}%)`;
      };

      // p is derived from the section's own rect rather than a cached document
      // offset: while the viewport is stuck, rect.top runs from 0 down to
      // -travel by construction (section height = viewport height + travel),
      // so this stays correct without knowing where the section sits.
      const update = () => {
        if (travel <= 0) return;
        const p = Math.min(1, Math.max(0, -section.getBoundingClientRect().top / travel));
        rail.style.transform = `translate3d(${-p * travel}px, 0, 0)`;
        // Active is keyed to progress through the section, NOT to whichever
        // card sits at the left gutter. The track stops once the last card's
        // right edge meets the viewport edge, so the final ~3 cards never
        // reach the gutter — feat-044's leading-card rule left steps 11 and 12
        // permanently dim and the axis permanently short of full. Keying it to
        // p makes both ends exact, and the highlight is provably always on
        // and the leading card index at p is p*travel/cardPitch, which is
        // strictly below p*(total-1) for any rail wider than one viewport.
        setActive(Math.round(p * (total - 1)));
      };

      const measure = () => {
        if (!canPin()) {
          section.classList.remove('is-pinned');
          section.style.height = '';
          rail.style.transform = '';
          steps.forEach((s) => s.classList.remove('is-active'));
          travel = 0;
          active = -1;
          lastWidth = -1;
          return;
        }
        section.classList.add('is-pinned');
        rail.style.transform = 'translate3d(0, 0, 0)';

        const vp = viewport.getBoundingClientRect();
        const last = steps[total - 1].getBoundingClientRect();
        const padRight = parseFloat(getComputedStyle(rail).paddingRight) || 0;
        // Measured off the real card boxes, not `scrollWidth` — the cards
        // overflow a container that no longer scrolls, where scrollWidth
        // isn't dependable.
        travel = Math.max(0, last.right - vp.left + padRight - vp.width);
        lastWidth = vp.width;
        section.style.height = `${viewport.clientHeight + travel}px`;
        update();
      };

      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          update();
        });
      };

      window.addEventListener('scroll', onScroll, { passive: true, signal });
      window.addEventListener('resize', measure, { signal });
      wide.addEventListener('change', measure, { signal });
      reduced.addEventListener('change', measure, { signal });

      // Setting the section's height can make the page tall enough to gain a
      // scrollbar, which narrows the viewport and changes `travel` with no
      // window resize event behind it. Guarded on width so the two can't
      // oscillate off each other.
      new ResizeObserver(() => {
        if (canPin() && viewport.getBoundingClientRect().width !== lastWidth) measure();
      }).observe(viewport);

      measure();
    });
  }

  // Not inside a transition:persist region, so this re-runs cleanly on every
  // navigation — same as ProcessAccordion and PasswordGate.
  document.addEventListener('astro:page-load', initProcessRail);
</script>

<style>
  /* Base state is the stacked vertical list — one entry after another, no
     clipping, no transform, nothing for the script to do. Pinning is layered
     on top of it and only ever added by the script, so a JS failure or a
     no-JS reader lands on the layout that always works rather than on a row
     of cards clipped at the viewport edge with no way to reach them. */
  .rail {
    display: flex;
    flex-direction: column;
    gap: 64px;
    margin: 0;
    padding: 0 24px;
    list-style: none;
  }

  .step {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  /* The rule is the whole frame — a divider between entries when stacked, and
     the active indicator when pinned. */
  .step__rule {
    display: block;
    height: 1px;
    background: var(--color-border-default);
    transition:
      background-color var(--duration-slow) var(--ease-fade),
      height var(--duration-slow) var(--ease-fade);
  }

  /* Meaningless without a horizontal position to report. */
  .rail-axis {
    display: none;
  }

  .step__body {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  /* :global() — the class merges onto Icon's own rendered <span>, which
     carries Icon.astro's astro-cid, not this component's. Icon declares no
     colour of its own (bug-004), so this is the only declaration on it. */
  :global(.step__icon) {
    color: var(--color-icon-default);
  }
  .step.is-active :global(.step__icon) {
    color: var(--color-text-emphasis);
  }

  /* Same label treatment as the output pills below, minus the uppercase
     transform — these are digits. */
  .step__number {
    font-family: var(--font-family-body);
    font-size: var(--font-size-xs);
    line-height: var(--font-line-height-xs);
    letter-spacing: 0.04em;
    color: var(--color-text-primary);
  }

  .step__title {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: var(--font-size-3xl);
    line-height: 31px;
    letter-spacing: -0.4px;
    font-weight: var(--font-weight-medium);
    color: var(--color-text-emphasis);
  }

  .step__action {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: var(--font-size-base);
    line-height: var(--font-line-height-base);
    color: var(--color-text-primary);
  }

  .step__outputs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Matches the Figma tag master (node 2119:1692) and OverviewSection's tags:
     cream border and text, not the stale orange the old Tag atom used. */
  .step__output {
    padding: 8px 14px;
    border: 1px solid var(--color-border-emphasis);
    border-radius: var(--radius-full);
    font-family: var(--font-family-body);
    font-size: var(--font-size-xs);
    line-height: var(--font-line-height-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-emphasis);
    white-space: nowrap;
  }

  /* A single nowrap pill can be wider than a phone screen — same fix
     OverviewSection needed at this breakpoint (feat-033). */
  @media (max-width: 767px) {
    .step__output {
      white-space: normal;
    }
  }

  /* ── Pinned mode ──────────────────────────────────────────────────────────
     feat-048. The rail used to be a second scroll container sitting inside a
     322px band: 12 steps and 5312px of content behind a sideways gesture the
     page gave no reason to expect, with a hidden scrollbar and an axis 96px
     below the cards that read as a section divider. It now advances off the
     vertical scroll the reader is already making — the section is as tall as
     the track is wide, the viewport sticks for that distance, and the track
     translates 1:1 with progress through it. One gesture, nothing hidden.

     Gated on both the class (script-added) and the query, so neither alone
     can pin a phone or a reader who has asked for less motion. */
  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    .rail-section.is-pinned .rail-viewport {
      position: sticky;
      top: 0;
      height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      overflow: hidden;
    }

    .rail-section.is-pinned .rail {
      flex-direction: row;
      gap: 48px;
      padding: 0 40px;
      /* No transition — the transform has to track the wheel exactly, or the
         rail lags behind the gesture driving it. */
      will-change: transform;
    }

    .rail-section.is-pinned .step {
      flex: 0 0 392px;
      width: 392px;
      /* 0.65, not feat-046's 0.42: cream at 0.42 on this background falls
         under 4.5:1, and with three cards on screen it dimmed two thirds of
         the section hard enough to read as disabled rather than as
         not-current. */
      opacity: 0.65;
      transition: opacity var(--duration-slow) var(--ease-fade);
    }
    .rail-section.is-pinned .step.is-active {
      opacity: 1;
    }

    /* Thickness as well as colour, so the active step still reads at a glance
       in both themes. */
    .rail-section.is-pinned .step.is-active .step__rule {
      height: 2px;
      background: var(--color-border-emphasis);
    }

    /* Pinned to the card's bottom edge rather than flowing straight after the
       action text — the actions run one to three lines depending on the step,
       and without this the pills sit at a different height on every card. */
    .rail-section.is-pinned .step__outputs {
      margin-top: auto;
    }

    .rail-section.is-pinned .rail-axis {
      display: block;
      position: relative;
      height: 1px;
      /* 32px, not feat-044's 96px — at 96px it reads as the divider between
         two sections rather than as this rail's own progress track. */
      margin: 32px 40px 0;
      background: var(--color-border-default);
    }
    .rail-section.is-pinned .rail-axis__progress {
      position: absolute;
      top: -1px;
      left: 0;
      height: 3px;
      width: var(--rail-progress, 8.3333%);
      background: var(--color-text-emphasis);
      transition: transform var(--duration-slow) var(--ease-reveal);
    }
  }
</style>
