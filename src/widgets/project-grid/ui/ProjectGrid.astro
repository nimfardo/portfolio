---
import { PROJECTS } from '@entities/project';
import ProjectCard from './ProjectCard.astro';
---

<div class="project-grid">
  {
    PROJECTS.map((project, i) => (
      <ProjectCard project={project} revealDelay={`${(i % 3) * 80}ms`} />
    ))
  }
</div>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    /* 40px — Figma project-grid's real itemSpacing (row and column both),
       re-pulled after Max's update. Not on the token scale. */
    gap: 40px;
  }

  @media (max-width: 1023px) {
    .project-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--spacing-lg);
    }
  }

  @media (max-width: 767px) {
    .project-grid {
      grid-template-columns: 1fr;
      gap: var(--spacing-md);
    }
  }
</style>
