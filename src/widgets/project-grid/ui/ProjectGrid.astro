---
import { PROJECTS } from '@entities/project';
import { staggerDelay } from '@shared/lib';
import ProjectCard from './ProjectCard.astro';
---

<div class="project-grid" data-project-grid>
  {
    PROJECTS.map((project, i) => (
      <ProjectCard project={project} revealDelay={staggerDelay(i, 80, 3)} eager={i < 3} />
    ))
  }
</div>

<script>
  import { isNdaUnlocked } from '@shared/lib';

  // Dim-siblings-on-hover (ProjectCard.astro's `.project-grid--card-hover`
  // rule) needs its trigger to be an actual card, not the grid container —
  // a bare `.project-grid:hover` fires for the gap space between cards too
  // (Max caught this reading as a bug). `:has(.project-card:hover)` is the
  // pure-CSS equivalent but didn't reliably invalidate style on sibling
  // cards when tested, so this uses plain non-bubbling mouseenter/mouseleave
  // on each card instead — simple, and every current AND future page-load's
  // cards need this re-wired after `astro:page-load` (ClientRouter swaps
  // aren't guaranteed to keep this exact set of nodes around).
  function initProjectGridHover() {
    const grid = document.querySelector<HTMLElement>('[data-project-grid]');
    if (!grid) return;
    grid.querySelectorAll<HTMLElement>('.project-card').forEach((card) => {
      card.addEventListener('mouseenter', () => grid.classList.add('project-grid--card-hover'));
      card.addEventListener('mouseleave', () => grid.classList.remove('project-grid--card-hover'));
    });
  }

  // One shared password unlocks every NDA project (shared/lib/password-gate.ts),
  // so a single check here hides the mask on every NDA card on this page —
  // not just the one the visitor happened to unlock it on.
  function syncNdaMasks() {
    if (!isNdaUnlocked()) return;
    document
      .querySelectorAll<HTMLElement>('[data-project-grid] [data-nda-mask]')
      .forEach((mask) => mask.setAttribute('hidden', ''));
  }

  document.addEventListener('astro:page-load', initProjectGridHover);
  document.addEventListener('astro:page-load', syncNdaMasks);
</script>

<style>
  .project-grid {
    display: grid;
    /* minmax(0, 1fr), not bare 1fr: a bare 1fr track's minimum width
       defaults to auto (its content's min-content size), so a card with
       wide content (e.g. the NDA badge, or a long name) can force its
       column wider than its fair share once the grid is narrow enough —
       confirmed uneven (237/197/271px) in /system's narrower gallery
       column, though the wide home-page grid never exposed it. */
    grid-template-columns: repeat(3, minmax(0, 1fr));
    /* 40px — Figma project-grid's real itemSpacing (row and column both),
       re-pulled after Max's update. Not on the token scale. */
    gap: 40px;
  }

  @media (max-width: 1023px) {
    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--spacing-lg);
    }
  }

  @media (max-width: 767px) {
    .project-grid {
      grid-template-columns: 1fr;
      gap: var(--spacing-md);
    }
  }
</style>
