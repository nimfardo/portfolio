---
import { Icon } from '@shared/ui';
import type { Project } from '@entities/project';

interface Props {
  project: Project;
  revealDelay?: string;
}

const { project, revealDelay } = Astro.props;
---

<a
  href={`/projects/${project.slug}`}
  class="project-card"
  data-reveal
  style={revealDelay ? `--reveal-delay: ${revealDelay}` : undefined}
>
  <div class="project-card__media">
    <img src={project.thumbnail} alt={project.name} loading="lazy" />
  </div>
  <div class="project-card__footer">
    <span class="project-card__name">{project.name}</span>
    <span class="project-card__meta">
      {
        project.access === 'nda' && (
          <span class="project-card__nda">
            <Icon name="locker" size={16} />
            Under NDA
          </span>
        )
      }
      <Icon name="arrow-right" size={28} class="project-card__arrow" />
    </span>
  </div>
</a>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    text-decoration: none;
    color: inherit;
  }

  .project-card__media {
    position: relative;
    width: 100%;
    aspect-ratio: 515 / 400;
    overflow: hidden;
    transition: opacity var(--duration-base) var(--ease-fade);
  }
  .project-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-md);
    /* 16px inset both sides — Figma's updated hover master pads the name
       and the NDA-badge+arrow group in from the card edges. */
    padding: 0 var(--spacing-md);
    transition: opacity var(--duration-fast) var(--ease-fade);
  }
  /* Hover-to-reveal only on devices that can actually hover with a
     precise pointer. Gating opacity:0 behind this (rather than applying
     it unconditionally and un-hiding on :hover) means touch devices —
     which never fire a real, sustained :hover — see the name/arrow
     footer always, instead of it being permanently invisible until tap. */
  @media (hover: hover) and (pointer: fine) {
    .project-card__footer {
      opacity: 0;
    }
    .project-card:hover .project-card__footer {
      opacity: 1;
    }

    /* Dim-siblings-on-hover, adapted from wearemotto.com's `.h-fade-invert`
       (wiki/concepts/motto-motion-patterns.md). Trigger is a JS-toggled
       `.project-grid--card-hover` class (see ProjectGrid.astro's script),
       not a bare `.project-grid:hover` — that fired for the gap space
       between cards too, dimming everything just from moving the cursor
       through the gutters (caught by Max). A `:has(.project-card:hover)`
       CSS-only version was tried first but didn't reliably invalidate style
       on sibling cards when tested live, so this uses an explicit class
       instead. `:global()` is required since `.project-grid` belongs to
       ProjectGrid.astro, a different component's scope (same gotcha as the
       Icon color race in bug-002/bug-004). */
    :global(.project-grid--card-hover) .project-card__media {
      opacity: 0.4;
    }
    .project-card:hover .project-card__media {
      opacity: 1;
    }
  }
  .project-card__name {
    min-width: 0;
    font-family: var(--font-family-body);
    font-size: var(--font-size-lg);
    line-height: var(--font-line-height-lg);
    font-weight: var(--font-weight-regular);
    color: var(--color-text-emphasis);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .project-card__meta {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    gap: var(--spacing-md);
  }
  .project-card__nda {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    padding: 8px 14px;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-full);
    font-family: var(--font-family-body);
    font-size: var(--font-size-xs);
    line-height: var(--font-line-height-xs);
    font-weight: var(--font-weight-regular);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-emphasis);
    white-space: nowrap;
  }
  /* :global() required — `class="project-card__arrow"` merges onto Icon's
     own rendered <span> (class:list={['icon', className]}), so the element
     only carries Icon.astro's astro-cid, never this component's. Without
     :global() the compiled attribute-selector never matches and the color
     silently falls through to inherited body text color instead. */
  :global(.project-card__arrow) {
    flex-shrink: 0;
    color: var(--color-icon-emphasis);
  }
</style>
