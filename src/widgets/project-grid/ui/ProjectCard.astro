---
import { Icon } from '@shared/ui';
import type { Project } from '@entities/project';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const hasMeta = Boolean(project.category || project.tags?.length);
---

<a href={`/projects/${project.slug}`} class="project-card">
  <div class="project-card__media">
    <img src={project.thumbnail} alt={project.name} loading="lazy" />
    {
      hasMeta && (
        <div class="project-card__overlay">
          {project.category && <span class="project-card__category">{project.category}</span>}
          {project.tags && <span class="project-card__tags">{project.tags.join(' · ')}</span>}
        </div>
      )
    }
  </div>
  <div class="project-card__footer">
    <span class="project-card__name-group">
      <span class="project-card__name">{project.name}</span>
      {
        project.access === 'nda' && (
          <span class="project-card__nda">
            <Icon name="locker" size={16} />
            Under NDA
          </span>
        )
      }
    </span>
    <Icon name="arrow-right" size={28} class="project-card__arrow" />
  </div>
</a>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    text-decoration: none;
    color: inherit;
  }

  .project-card__media {
    position: relative;
    width: 100%;
    aspect-ratio: 515 / 400;
    overflow: hidden;
  }
  .project-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-card__overlay {
    position: absolute;
    inset: auto 0 0 0;
    height: 50%;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--spacing-md);
    padding: var(--spacing-md) var(--spacing-md) var(--spacing-lg);
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.7) 100%);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .project-card:hover .project-card__overlay {
    opacity: 1;
  }
  .project-card__category,
  .project-card__tags {
    min-width: 0;
    max-width: 48%;
    font-family: var(--font-family-body);
    font-size: var(--font-size-sm);
    line-height: var(--font-line-height-sm);
    font-weight: var(--font-weight-regular);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-emphasis);
  }
  .project-card__tags {
    text-align: right;
  }

  .project-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-md);
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .project-card:hover .project-card__footer {
    opacity: 1;
  }
  .project-card__name-group {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    min-width: 0;
  }
  .project-card__name {
    font-family: var(--font-family-body);
    font-size: var(--font-size-lg);
    line-height: var(--font-line-height-lg);
    font-weight: var(--font-weight-regular);
    color: var(--color-text-primary);
    white-space: nowrap;
  }
  .project-card__nda {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    padding: 8px 14px;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-full);
    font-family: var(--font-family-body);
    font-size: var(--font-size-xs);
    line-height: var(--font-line-height-xs);
    font-weight: var(--font-weight-regular);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-primary);
    white-space: nowrap;
  }
  .project-card__arrow {
    flex-shrink: 0;
    color: var(--color-icon-default);
  }
</style>
