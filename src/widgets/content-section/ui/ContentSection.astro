---
// Reused for Project Overview / Brand Development / Design System — every
// CONNECTIS section that's just a heading + one image + one paragraph.
interface Props {
  heading: string;
  image: string;
  imageAlt: string;
  class?: string;
}

const { heading, image, imageAlt, class: className } = Astro.props;
---

<section class:list={['content-section', className]}>
  <h2 class="content-section__heading">{heading}</h2>
  <div class="content-section__body">
    <img class="content-section__image" src={image} alt={imageAlt} loading="lazy" />
    <p class="content-section__text"><slot /></p>
  </div>
</section>

<style>
  .content-section {
    display: grid;
    /* Max's Figma reference columns: 3 equal tracks + 80px gutters. Heading
       spans track 1 (33%), body spans tracks 2-3 + the gutter between them
       (66%) — proportional, not a fixed px split, so it holds at any
       container width instead of skewing as the viewport shrinks. */
    grid-template-columns: repeat(3, 1fr);
    column-gap: 80px;
    align-items: start;
  }
  .content-section__heading {
    grid-column: 1 / 2;
    margin: 0;
    font-family: var(--font-family-body);
    font-size: var(--font-size-4xl);
    line-height: var(--font-line-height-4xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.01em;
    color: var(--color-text-emphasis);
  }
  .content-section__body {
    grid-column: 2 / 4;
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 80px;
  }
  .content-section__image {
    width: 100%;
    aspect-ratio: 1071 / 630;
    object-fit: cover;
  }
  .content-section__text {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: var(--font-size-xl);
    line-height: 2;
    font-weight: var(--font-weight-regular);
    color: var(--color-text-emphasis);
  }

  @media (max-width: 1023px) {
    .content-section {
      grid-template-columns: 1fr;
      gap: var(--spacing-xl);
    }
    .content-section__heading,
    .content-section__body {
      grid-column: 1;
    }
  }
</style>
