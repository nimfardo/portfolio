---
// Heading + one or more stacked image+paragraph blocks — reused for
// Challenge (1 block) and Deliverables (2 blocks, one heading over both:
// Brand Development + Design System merged into one Figma section).
import { Heading } from '@shared/ui';

interface ContentBlock {
  image: string;
  imageAlt: string;
  text: string;
}

interface Props {
  heading: string;
  blocks: ContentBlock[];
  class?: string;
}

const { heading, blocks, class: className } = Astro.props;
---

<section class:list={['content-section', className]}>
  <Heading class="content-section__heading">{heading}</Heading>
  <div class="content-section__body">
    {
      blocks.map((block, i) => (
        <div class="content-section__block" data-reveal style={`--reveal-delay: ${i * 100}ms`}>
          <img
            class="content-section__image"
            src={block.image}
            alt={block.imageAlt}
            loading="lazy"
          />
          <p class="content-section__text">{block.text}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  .content-section {
    display: grid;
    /* Max's Figma reference columns: 3 equal tracks + 80px gutters. Heading
       spans track 1 (33%), body spans tracks 2-3 + the gutter between them
       (66%) — proportional, not a fixed px split, so it holds at any
       container width instead of skewing as the viewport shrinks. */
    grid-template-columns: repeat(3, 1fr);
    column-gap: 80px;
    align-items: start;
  }
  /* :global() — class merges onto Heading's own rendered <h2>, which
     carries Heading.astro's astro-cid, not this component's. */
  :global(.content-section__heading) {
    grid-column: 1 / 2;
  }
  .content-section__body {
    grid-column: 2 / 4;
    display: flex;
    min-width: 0;
    flex-direction: column;
    /* 160px between stacked blocks (Deliverables' 2 blocks) — matches the
       page's own section rhythm, per Figma. */
    gap: 160px;
  }
  .content-section__block {
    display: flex;
    flex-direction: column;
    gap: 64px;
  }
  .content-section__image {
    width: 100%;
    aspect-ratio: 1071 / 630;
    object-fit: cover;
  }
  .content-section__text {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: var(--font-size-4xl);
    line-height: var(--font-line-height-5xl);
    letter-spacing: -0.4px;
    font-weight: var(--font-weight-medium);
    color: var(--color-text-emphasis);
  }

  @media (max-width: 1023px) {
    .content-section {
      grid-template-columns: 1fr;
      gap: var(--spacing-xl);
    }
    :global(.content-section__heading) {
      grid-column: 1;
    }
    .content-section__body {
      grid-column: 1;
    }
  }
</style>
