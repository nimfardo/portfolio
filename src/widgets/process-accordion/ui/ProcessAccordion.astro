---
// Native <details>/<summary> — matches Figma's Accordion component
// (open=true|false variants), first step open by default. The step number
// renders inside the same 80x80 IconBadge shell used for process-block
// icons elsewhere — IconBadge's icon prop is optional here and this
// projects the number through its slot instead. Each step is a single
// image + paragraph (Figma dropped the old What-we-did/The-Value
// sub-block split).
//
// Open/close is no longer instant: the <script> below animates height via
// WAAPI (the standard details/summary animation recipe — toggling `open`
// natively gives no transition hook at all) and the plus/minus icon
// crossfades+rotates via plain CSS on [open] instead of a hard
// display:none swap.
import { Icon, IconBadge } from '@shared/ui';
import type { ProcessStep } from '../model/types';

interface Props {
  steps: ProcessStep[];
}

const { steps } = Astro.props;
---

<div class="process-accordion">
  {
    steps.map((step, index) => (
      <details
        class="process-step"
        open={index === 0}
        data-reveal
        style={`--reveal-delay: ${(index % 4) * 80}ms`}
      >
        <summary class="process-step__summary">
          <IconBadge class="process-step__number-badge">
            <span class="process-step__number">{step.number}</span>
          </IconBadge>
          <span class="process-step__title-row">
            <span class="process-step__title">{step.title}</span>
            <span class="process-step__icon-swap">
              <Icon name="plus" size={32} class="process-step__icon process-step__icon--closed" />
              <Icon name="minus" size={32} class="process-step__icon process-step__icon--open" />
            </span>
          </span>
        </summary>
        <div class="process-step__content">
          <img
            class="process-step__image"
            src={step.image}
            alt={step.imageAlt}
            loading="lazy"
          />
          <p class="process-step__text">{step.body}</p>
        </div>
      </details>
    ))
  }
</div>

<script>
  import { prefersReducedMotion } from '@shared/lib';

  // Native <details> toggling is instant with no transition hook — this is
  // the standard WAAPI details/summary animation recipe (animate `height`
  // on the <details> element itself between its current and target height,
  // flip the `open` attribute once the animation settles). Not inside any
  // transition:persist region, so re-init unguarded on every
  // `astro:page-load`, same as scroll-reveal/Media's video observer.
  function initAccordionAnimations() {
    if (prefersReducedMotion()) return;

    const root = getComputedStyle(document.documentElement);
    const duration = parseFloat(root.getPropertyValue('--duration-base')) * 1000;
    const easing = root.getPropertyValue('--ease-reveal').trim();

    document.querySelectorAll<HTMLDetailsElement>('.process-step').forEach((details) => {
      const summary = details.querySelector<HTMLElement>('.process-step__summary');
      const content = details.querySelector<HTMLElement>('.process-step__content');
      if (!summary || !content) return;

      let animation: Animation | null = null;

      summary.addEventListener('click', (event) => {
        event.preventDefault();
        details.style.overflow = 'hidden';
        if (details.open) {
          collapse();
        } else {
          expand();
        }
      });

      function finish(open: boolean) {
        details.open = open;
        animation = null;
        details.style.height = '';
        details.style.overflow = '';
      }

      function expand() {
        animation?.cancel();
        details.open = true;
        const startHeight = `${summary!.offsetHeight}px`;
        const endHeight = `${summary!.offsetHeight + content!.offsetHeight}px`;
        animation = details.animate({ height: [startHeight, endHeight] }, { duration, easing });
        animation.onfinish = () => finish(true);
      }

      function collapse() {
        animation?.cancel();
        const startHeight = `${details.offsetHeight}px`;
        const endHeight = `${summary!.offsetHeight}px`;
        animation = details.animate({ height: [startHeight, endHeight] }, { duration, easing });
        animation.onfinish = () => finish(false);
      }
    });
  }

  document.addEventListener('astro:page-load', initAccordionAnimations);
</script>

<style>
  .process-accordion {
    display: flex;
    flex-direction: column;
  }
  .process-step {
    border-bottom: 1px solid var(--color-border-default);
  }
  .process-step:first-child {
    border-top: 1px solid var(--color-border-default);
  }

  .process-step__summary {
    display: flex;
    align-items: center;
    /* 40px — was 80px; Figma's number badge grew from a bare 40px-wide
       number to an 80px IconBadge, and the gap shrank to match (badge
       80 + gap 40 = same 120px total the title-row/content still indent
       by, so process-step__content's margin-left stays unchanged). */
    gap: 40px;
    padding: 40px 0;
    cursor: pointer;
    list-style: none;
  }
  .process-step__summary::-webkit-details-marker {
    display: none;
  }
  /* :global() — class merges onto IconBadge's own rendered <span>, which
     carries IconBadge.astro's astro-cid, not this component's. */
  :global(.process-step__number-badge) {
    flex-shrink: 0;
  }
  .process-step__number {
    font-family: var(--font-family-body);
    font-size: var(--font-size-xl);
    line-height: var(--font-line-height-xl);
    color: var(--color-text-primary);
  }
  .process-step__title-row {
    /* Figma nests title+icon in their own row (951px wide, space-between)
       rather than making the icon a 3rd item in the outer number/title/icon
       row — that extra 80px gap was stealing width from the title and
       forcing long headings onto 2 lines. Matching the real structure gives
       the title the same ~903px Figma allots it, so real headings fit on
       one line like they do in Figma. */
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-lg);
  }
  .process-step__title {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: var(--font-size-2xl);
    /* 48px, not the shared 2xl token (32px) — see shared/ui/heading. Was
       3xl/40px/-1% before Max sized this down to match the new Heading
       component's scale. */
    line-height: 48px;
    font-weight: var(--font-weight-bold);
    color: var(--color-text-emphasis);
  }
  .process-step__icon-swap {
    position: relative;
    flex-shrink: 0;
    width: 32px;
    height: 32px;
  }
  .process-step :global(.process-step__icon) {
    position: absolute;
    inset: 0;
    color: var(--color-icon-default);
    opacity: 1;
    transform: rotate(0deg);
    transition:
      opacity var(--duration-base) var(--ease-fade),
      transform var(--duration-base) var(--ease-fade);
  }
  .process-step:not([open]) :global(.process-step__icon--open) {
    opacity: 0;
    transform: rotate(-45deg);
  }
  .process-step[open] :global(.process-step__icon--closed) {
    opacity: 0;
    transform: rotate(45deg);
  }

  .process-step__content {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-bottom: 40px;
    /* Indented to align with the title-row above, not the number column —
       matches Figma (content nests under the same 951px-wide title frame). */
    margin-left: 120px;
  }

  .process-step__image {
    width: 100%;
    aspect-ratio: 1071 / 560;
    object-fit: cover;
  }
  .process-step__text {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: var(--font-size-xl);
    line-height: 2;
    color: var(--color-text-emphasis);
  }

  @media (max-width: 767px) {
    .process-step__summary {
      gap: var(--spacing-lg);
      align-items: flex-start;
    }
    .process-step__title {
      font-size: var(--font-size-xl);
      line-height: var(--font-line-height-xl);
    }
    .process-step__content {
      margin-left: 0;
    }
  }
</style>
