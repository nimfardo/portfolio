---
// Native <details>/<summary> — matches Figma's Accordion component
// (open=true|false variants); all steps start closed, and only one can be
// open at a time (opening a step closes whichever other one is open) —
// enforced entirely by the <script> below, not the native `name` grouping
// attribute: that was tried and reverted, since setting `details.open =
// true` on the newly-opened step makes the browser instantly force-close
// same-named siblings itself, which snapped the previous step shut before
// its own WAAPI collapse animation ever got a chance to run. The step
// number
// renders inside the same 80x80 IconBadge shell used for process-block
// icons elsewhere — IconBadge's icon prop is optional here and this
// projects the number through its slot instead. Each step is a single
// image + paragraph (Figma dropped the old What-we-did/The-Value
// sub-block split).
//
// Open/close is no longer instant: the <script> below animates height via
// WAAPI (the standard details/summary animation recipe — toggling `open`
// natively gives no transition hook at all) and the plus/minus icon
// crossfades+rotates via plain CSS on [open] instead of a hard
// display:none swap.
import { Icon, IconBadge } from '@shared/ui';
import { Media } from '@entities/media';
import { staggerDelay } from '@shared/lib';
import type { ProcessStep } from '../model/types';

interface Props {
  steps: ProcessStep[];
}

const { steps } = Astro.props;
---

<div class="process-accordion">
  {
    steps.map((step, index) => (
      <details
        class="process-step"
        data-reveal
        style={`--reveal-delay: ${staggerDelay(index, 80, 4)}`}
      >
        <summary class="process-step__summary">
          <IconBadge class="process-step__number-badge">
            <span class="process-step__number">{step.number}</span>
          </IconBadge>
          <span class="process-step__title-row">
            <span class="process-step__title">{step.title}</span>
            <span class="process-step__icon-swap">
              <Icon name="plus" size={32} class="process-step__icon process-step__icon--closed" />
              <Icon name="minus" size={32} class="process-step__icon process-step__icon--open" />
            </span>
          </span>
        </summary>
        <div class="process-step__content">
          {
            step.media.type === 'image' ? (
              <img
                class="process-step__image"
                src={step.media.image}
                alt={step.media.imageAlt}
                loading="lazy"
              />
            ) : (
              <Media
                type="video"
                class="process-step__image"
                src={step.media.src}
                poster={step.media.poster}
                alt={step.media.alt}
              />
            )
          }
          <p class="process-step__text">{step.body}</p>
        </div>
      </details>
    ))
  }
</div>

<script>
  import { prefersReducedMotion } from '@shared/lib';

  // Native <details> toggling is instant with no transition hook — this is
  // the standard WAAPI details/summary animation recipe (animate `height`
  // on the <details> element itself between its current and target height,
  // flip the `open` attribute once the animation settles). Not inside any
  // transition:persist region, so re-init unguarded on every
  // `astro:page-load`, same as scroll-reveal/Media's video observer.
  function initAccordionAnimations() {
    if (prefersReducedMotion()) return;

    const root = getComputedStyle(document.documentElement);
    const duration = parseFloat(root.getPropertyValue('--duration-base')) * 1000;
    const easing = root.getPropertyValue('--ease-reveal').trim();

    // Accordion behavior: only one step open at a time. Each step's `toggle`
    // is a closure scoped to its own `animation` variable, so a shared map
    // is needed to reach across steps and close whichever other one is open
    // before opening this one.
    let openStep: HTMLDetailsElement | null = null;
    const toggles = new Map<HTMLDetailsElement, (open: boolean) => void>();

    document.querySelectorAll<HTMLDetailsElement>('.process-step').forEach((details) => {
      const summary = details.querySelector<HTMLElement>('.process-step__summary');
      const content = details.querySelector<HTMLElement>('.process-step__content');
      if (!summary || !content) return;

      let animation: Animation | null = null;

      summary.addEventListener('click', (event) => {
        event.preventDefault();
        const opening = !details.open;
        details.style.overflow = 'hidden';
        if (opening && openStep && openStep !== details) {
          toggles.get(openStep)?.(false);
        }
        toggle(opening);
        openStep = opening ? details : null;
      });

      function finish(open: boolean) {
        details.open = open;
        animation = null;
        details.style.height = '';
        details.style.overflow = '';
      }

      // Opening and closing are the same animation with the direction
      // flipped: cancel whatever's in flight, animate `height` from the
      // current value to the target, settle `open` on finish. The only
      // asymmetry is startHeight when opening — `details.open = true` must
      // happen before reading `content.offsetHeight` for endHeight (that's
      // how the browser lays out the now-visible content), but startHeight
      // itself comes from `summary.offsetHeight` either way (the collapsed
      // height), which setting `open` doesn't affect.
      function toggle(open: boolean) {
        animation?.cancel();
        // Drives the +/- icon swap, decoupled from `details.open` on purpose:
        // closing must keep `open=true` for the whole collapse (native
        // <details> hides content the instant `open` is removed, which would
        // break the height animation), so `details.open` only flips to false
        // in finish() — if the icon CSS keyed off `[open]` instead of this
        // class, it'd stay showing "minus" for the entire close animation and
        // only snap to "plus" after the box had already finished collapsing.
        details.classList.toggle('is-open', open);
        const startHeight = open ? `${summary!.offsetHeight}px` : `${details.offsetHeight}px`;
        if (open) details.open = true;
        const endHeight = open
          ? `${summary!.offsetHeight + content!.offsetHeight}px`
          : `${summary!.offsetHeight}px`;
        animation = details.animate({ height: [startHeight, endHeight] }, { duration, easing });
        animation.onfinish = () => finish(open);
      }

      toggles.set(details, toggle);
    });
  }

  document.addEventListener('astro:page-load', initAccordionAnimations);
</script>

<style>
  .process-accordion {
    display: flex;
    flex-direction: column;
  }
  .process-step {
    border-bottom: 1px solid var(--color-border-default);
  }
  .process-step:first-child {
    border-top: 1px solid var(--color-border-default);
  }

  .process-step__summary {
    display: flex;
    align-items: center;
    /* 40px — was 80px; Figma's number badge grew from a bare 40px-wide
       number to an 80px IconBadge, and the gap shrank to match (badge
       80 + gap 40 = same 120px total the title-row/content still indent
       by, so process-step__content's margin-left stays unchanged). */
    gap: 40px;
    padding: 40px 0;
    cursor: pointer;
    list-style: none;
  }
  .process-step__summary::-webkit-details-marker {
    display: none;
  }
  /* :global() — class merges onto IconBadge's own rendered <span>, which
     carries IconBadge.astro's astro-cid, not this component's. */
  :global(.process-step__number-badge) {
    flex-shrink: 0;
  }
  .process-step__number {
    font-family: var(--font-family-body);
    font-size: var(--font-size-xl);
    line-height: var(--font-line-height-xl);
    color: var(--color-text-primary);
  }
  .process-step__title-row {
    /* Figma nests title+icon in their own row (951px wide, space-between)
       rather than making the icon a 3rd item in the outer number/title/icon
       row — that extra 80px gap was stealing width from the title and
       forcing long headings onto 2 lines. Matching the real structure gives
       the title the same ~903px Figma allots it, so real headings fit on
       one line like they do in Figma. */
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-lg);
  }
  .process-step__title {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: var(--font-size-2xl);
    /* 48px, not the shared 2xl token (32px) — see shared/ui/heading. Was
       3xl/40px/-1% before Max sized this down to match the new Heading
       component's scale. */
    line-height: 48px;
    font-weight: var(--font-weight-bold);
    color: var(--color-text-emphasis);
  }
  .process-step__icon-swap {
    position: relative;
    flex-shrink: 0;
    width: 32px;
    height: 32px;
  }
  .process-step :global(.process-step__icon) {
    position: absolute;
    inset: 0;
    color: var(--color-icon-default);
    opacity: 1;
    transform: rotate(0deg);
    transition:
      opacity var(--duration-base) var(--ease-fade),
      transform var(--duration-base) var(--ease-fade);
  }
  .process-step:not(.is-open) :global(.process-step__icon--open) {
    opacity: 0;
    transform: rotate(-45deg);
  }
  .process-step.is-open :global(.process-step__icon--closed) {
    opacity: 0;
    transform: rotate(45deg);
  }

  .process-step__content {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-bottom: 40px;
    /* Indented to align with the title-row above, not the number column —
       matches Figma (content nests under the same 951px-wide title frame). */
    margin-left: 120px;
  }

  /* :global() — the video branch's class merges onto Media's own rendered
     root <div>, which carries Media.astro's astro-cid, not this component's
     (same classlist-merge gotcha as every other Icon/PageHeader consumer in
     this codebase); :global() also still matches this component's own <img>
     in the image branch, so one rule covers both. object-fit has no effect
     on Media's wrapper div itself, but Media's own internal CSS already
     applies object-fit:cover to its <video>, so both branches crop the same
     way. */
  :global(.process-step__image) {
    width: 100%;
    aspect-ratio: 1071 / 560;
    object-fit: cover;
  }
  .process-step__text {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: var(--font-size-xl);
    line-height: 2;
    color: var(--color-text-emphasis);
  }

  @media (max-width: 767px) {
    .process-step__summary {
      gap: var(--spacing-lg);
      align-items: flex-start;
    }
    .process-step__title {
      font-size: var(--font-size-xl);
      line-height: var(--font-line-height-xl);
    }
    .process-step__content {
      margin-left: 0;
    }
  }
</style>
