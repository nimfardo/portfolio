---
// Figma "header" organism, now canvas 2910:2049: page-name on the left, and a
// right group holding the Download CV button + theme-toggle. Sitting above
// content on desktop. Desktop-only — mobile's own header (widgets/navigation)
// is logo+hamburger only, and the mobile overlay already carries the
// theme-toggle, so this would be redundant below 1024px.
//
// The CV button arrived in feat-100 and this component being desktop-only is
// load-bearing for how it was wired: because nothing here renders below
// 1024px, CV had to STAY in the mobile overlay's nav list. It is the sidebar
// copy that went (see `overlayOnly` in navigation's nav-items). Max accepted
// that "always visible" therefore means desktop; on phones CV is still one tap
// inside the hamburger.
//
// The glyph is `download`, and the canvas will not tell you that by name — the
// layer is called `right-arrow` (the Button master's slot name) while the
// exported path is the project's own download icon scaled 28 -> 24, checked
// coordinate by coordinate. Third time that trap has come up this week.
import { Button, Icon } from '@shared/ui';
import { CV_HREF, CV_LABEL } from '@shared/config';
import { ThemeToggle } from '@features/theme-toggle';

interface Props {
  title: string;
  showBack?: boolean;
  backHref?: string;
  class?: string;
}

const { title, showBack = false, backHref = '/', class: className } = Astro.props;
---

<div class:list={['page-header', className]}>
  <div class="page-header__title-group">
    {
      showBack && (
        <a href={backHref} class="page-header__back" aria-label="Back">
          <Icon name="arrow-left" size={32} />
        </a>
      )
    }
    <span class="page-header__title">{title}</span>
  </div>
  <div class="page-header__actions">
    <Button
      type="outlined"
      size="sm"
      href={CV_HREF}
      external
      icon="download"
      class="page-header__cv"
    >
      {CV_LABEL}
    </Button>
    <ThemeToggle />
  </div>
</div>

<style>
  .page-header {
    display: none;
  }

  @media (min-width: 1024px) {
    .page-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 48px;
      /* 40px top+bottom — Figma's real gap on both Home and CONNECTIS
         (`header` instance sits at y=40 on both frames, and the next
         element starts exactly 40px after it), not the 48px --spacing-2xl
         token (bug-012, 2026-07-28). */
      margin-top: 40px;
      margin-bottom: 40px;
    }
    .page-header__title-group {
      display: flex;
      align-items: center;
      gap: var(--spacing-lg);
    }
    /* Canvas 2910:2069: the button ends at x=187 and the toggle group starts
       at x=227, so the gap is 40 — not a spacing token, which stops at 32
       (xl) and jumps to 48 (2xl). The same 40 the header's own margins use. */
    .page-header__actions {
      display: flex;
      align-items: center;
      gap: 40px;
    }
    /* Manrope/xl/regular, synced from the "header" master (node 2304:1538,
       bug-033). Was 2xl/bold with a hardcoded 48px line-height — that was
       the bug-005 style-vs-variable divergence special case, which no
       longer applies now that this style sits cleanly on its own size
       step's tokens. */
    .page-header__title {
      font-family: var(--font-family-body);
      font-size: var(--font-size-xl);
      line-height: var(--font-line-height-xl);
      font-weight: var(--font-weight-regular);
      color: var(--color-text-primary);
    }
    .page-header__back {
      display: flex;
      color: var(--color-icon-default);
    }
  }
</style>
