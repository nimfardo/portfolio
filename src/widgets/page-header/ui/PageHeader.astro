---
// Figma "header" organism (2078:375 / 2118:1602): page-name + theme-toggle,
// sitting above content on desktop. Desktop-only — mobile's own header
// (widgets/navigation) is logo+hamburger only, and the mobile overlay
// already carries the theme-toggle, so this would be redundant below 1024px.
import { Icon } from '@shared/ui';
import { ThemeToggle } from '@features/theme-toggle';

interface Props {
  title: string;
  showBack?: boolean;
  backHref?: string;
  class?: string;
}

const { title, showBack = false, backHref = '/', class: className } = Astro.props;
---

<div class:list={['page-header', className]}>
  <div class="page-header__title-group">
    {
      showBack && (
        <a href={backHref} class="page-header__back" aria-label="Back">
          <Icon name="arrow-left" size={32} />
        </a>
      )
    }
    <span class="page-header__title">{title}</span>
  </div>
  <ThemeToggle />
</div>

<style>
  .page-header {
    display: none;
  }

  @media (min-width: 1024px) {
    .page-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 48px;
      /* 40px top+bottom — Figma's real gap on both Home and CONNECTIS
         (`header` instance sits at y=40 on both frames, and the next
         element starts exactly 40px after it), not the 48px --spacing-2xl
         token (bug-012, 2026-07-28). */
      margin-top: 40px;
      margin-bottom: 40px;
    }
    .page-header__title-group {
      display: flex;
      align-items: center;
      gap: var(--spacing-lg);
    }
    .page-header__title {
      font-family: var(--font-family-body);
      font-size: var(--font-size-2xl);
      /* 48px, not the shared 2xl token (32px) — see shared/ui/heading. */
      line-height: 48px;
      font-weight: var(--font-weight-bold);
      color: var(--color-text-primary);
    }
    .page-header__back {
      display: flex;
      color: var(--color-icon-default);
    }
  }
</style>
