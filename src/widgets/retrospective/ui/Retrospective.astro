---
import circleDoodle from './circle-doodle.svg?raw';
import { Button, Icon, Heading } from '@shared/ui';

interface Props {
  heading: string;
  behanceUrl: string;
}

const { heading, behanceUrl } = Astro.props;
---

<section class="retrospective">
  <Heading class="retrospective__heading">{heading}</Heading>
  <div class="retrospective__body" data-reveal>
    <p class="retrospective__text"><slot /></p>
    <Button type="solid" href={behanceUrl} class="retrospective__button">Check on Behance</Button>
    <div class="retrospective__smile">
      <span class="retrospective__smile-ring" set:html={circleDoodle} />
      <Icon name="smile" size={32} />
    </div>
  </div>
</section>

<style>
  .retrospective {
    display: grid;
    /* 33/66 proportional split — see ContentSection.astro for the Figma
       reference-column rationale. */
    grid-template-columns: repeat(3, 1fr);
    column-gap: 80px;
    align-items: start;
  }
  :global(.retrospective__heading) {
    grid-column: 1 / 2;
  }
  .retrospective__body {
    grid-column: 2 / 4;
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 80px;
  }
  .retrospective__text {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: var(--font-size-4xl);
    line-height: var(--font-line-height-5xl);
    letter-spacing: -0.4px;
    font-weight: var(--font-weight-medium);
    color: var(--color-text-emphasis);
  }
  /* :global() — class merges onto Button's own rendered <a>/<button>, which
     carries Button.astro's astro-cid, not this component's. Without this,
     the button stretches to the full column width via the flex-column
     parent's default align-items:stretch — Figma has it fixed at 320px. */
  :global(.retrospective__button) {
    align-self: flex-start;
  }
  .retrospective__smile {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 128px;
    height: 128px;
    color: var(--color-icon-default);
  }
  .retrospective__smile-ring {
    position: absolute;
    inset: 0;
    display: flex;
    /* Slow continuous spin on the ring's text path — the smile icon it
       surrounds stays static/centered. No token fits a multi-second
       decorative loop (tokens.css's durations are all sub-second UI
       transitions), so this is a literal value scoped to this component,
       same precedent as the hero scroll-cue's bounce animation. */
    animation: retrospective-ring-spin 20s linear infinite;
  }
  .retrospective__smile-ring :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  @keyframes retrospective-ring-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .retrospective__smile-ring {
      animation: none;
    }
  }

  @media (max-width: 1023px) {
    .retrospective {
      grid-template-columns: 1fr;
      gap: var(--spacing-xl);
    }
    :global(.retrospective__heading) {
      grid-column: 1;
    }
    .retrospective__body {
      grid-column: 1;
    }
  }
</style>
