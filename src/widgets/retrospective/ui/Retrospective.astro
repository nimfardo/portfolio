---
import { Button, IconBadge, Heading } from '@shared/ui';

interface Props {
  heading: string;
  behanceUrl: string;
}

const { heading, behanceUrl } = Astro.props;
---

<section class="retrospective">
  <Heading class="retrospective__heading">{heading}</Heading>
  <div class="retrospective__body">
    <p class="retrospective__text"><slot /></p>
    <Button type="solid" href={behanceUrl} class="retrospective__button">Check on Behance</Button>
    <div class="retrospective__thanks">
      <IconBadge icon="thumb" />
      <p class="retrospective__thanks-text">Thanks for scrolling</p>
    </div>
  </div>
</section>

<style>
  .retrospective {
    display: grid;
    /* 33/66 proportional split — see ContentSection.astro for the Figma
       reference-column rationale. */
    grid-template-columns: repeat(3, 1fr);
    column-gap: 80px;
    align-items: start;
  }
  :global(.retrospective__heading) {
    grid-column: 1 / 2;
  }
  .retrospective__body {
    grid-column: 2 / 4;
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 80px;
  }
  .retrospective__text {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: var(--font-size-xl);
    line-height: 2;
    color: var(--color-text-emphasis);
  }
  .retrospective__thanks {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
  }
  .retrospective__thanks-text {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: var(--font-size-2xl);
    line-height: var(--font-line-height-2xl);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-emphasis);
  }

  @media (max-width: 1023px) {
    .retrospective {
      grid-template-columns: 1fr;
      gap: var(--spacing-xl);
    }
    :global(.retrospective__heading) {
      grid-column: 1;
    }
    .retrospective__body {
      grid-column: 1;
    }
  }
</style>
