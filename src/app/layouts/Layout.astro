---
import '@fontsource-variable/manrope';
import '@app/styles/tokens.css';
import '@app/styles/global.css';
import { Preloader } from '@widgets/preloader';
import { Navigation } from '@widgets/navigation';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      // Runs before paint to avoid a flash of the wrong theme.
      // Dark is the default (dark-first design); light is opt-in and persisted.
      const stored = localStorage.getItem('theme');
      if (stored === 'light') {
        document.documentElement.dataset.theme = 'light';
      }
    </script>
  </head>
  <body>
    <Preloader />
    <Navigation />
    <div class="page-content">
      <slot />
    </div>
    <script>
      import { initScrollReveal } from '@shared/lib';
      initScrollReveal();
    </script>
  </body>
</html>

<style>
  /* Reserves space for the persistent nav chrome from widgets/navigation:
     a 153px desktop sidebar, or a 64px mobile header below 1024px. */
  .page-content {
    padding-top: 64px;
  }
  @media (min-width: 1024px) {
    .page-content {
      padding-top: 0;
      padding-left: 153px;
    }
  }
</style>
