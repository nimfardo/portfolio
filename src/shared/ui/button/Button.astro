---
import Icon from '../icon/Icon.astro';
import type { IconName } from '../icon/Icon.astro';

interface Props {
  type?: 'solid' | 'outlined';
  /* Figma set 2006:327 gained a `size` property in feat-100. `md` is the
     320x60 button the whole site already used; `sm` is the 48-tall one the
     header CV button needs (canvas 2911:2071) — smaller text, a 24px glyph
     instead of 28, and no min-width, because it sits in a 48px header row
     rather than on a page. Same border/ink tokens and the same hover and
     disabled contracts, which is why this is a variant and not a component. */
  size?: 'md' | 'sm';
  disabled?: boolean;
  href?: string;
  /* Force the new-tab treatment. The default heuristic below only catches
     absolute URLs, and the CV is a same-origin FILE (`/max-shturma-cv.pdf`) —
     it has to open in a new tab because the ClientRouter cannot swap a PDF
     into the SPA, but it would fail a `startsWith('http')` test. Explicit
     beats widening the heuristic, which would start guessing about every
     internal path with a dot in it. */
  external?: boolean;
  class?: string;
  /* The trailing glyph. Defaults to the arrow every button shipped with, so
     existing call sites are untouched. /about's Contact button (canvas
     2901:1911) is the first to override it — Max swapped that instance's glyph
     to an envelope while the LAYER is still named `right-arrow`, which is the
     Button master's slot name. The name is not the glyph: the exported path
     there is byte-identical to this project's `mail.svg`. */
  icon?: IconName;
}

const {
  type = 'solid',
  size = 'md',
  disabled = false,
  href,
  external,
  class: className,
  icon = 'arrow-right',
} = Astro.props;
const Tag = href ? 'a' : 'button';
// External destinations (Behance, GitHub, ...) open in a new tab; internal
// routes stay in-tab so ClientRouter transitions keep working (bug-038).
// An explicit `external` wins over the heuristic — see the prop's note.
const isExternal = external ?? href?.startsWith('http');
// Canvas 2911:2071 draws the small button's glyph at 24, not 28.
const iconSize = size === 'sm' ? 24 : 28;
---

<Tag
  class:list={['button', `button--${type}`, `button--${size}`, className]}
  href={href}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noopener noreferrer' : undefined}
  disabled={!href && disabled ? true : undefined}
  aria-disabled={href && disabled ? 'true' : undefined}
>
  <span class="button__label"><slot /></span>
  <Icon name={icon} size={iconSize} class="button__icon" />
</Tag>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: none;
    background: none;
    cursor: pointer;
    font-family: var(--font-family-body);
    font-weight: var(--font-weight-medium);
    /* 0.04em, not a px value, so it tracks the size variant: 0.72px at md's
       18px and 0.56px at sm's 14px — both exactly what the canvas carries
       (2901:1911 and 2911:2071 respectively). */
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-align: center;
    text-decoration: none;
    white-space: nowrap;
  }

  /* --- size: md (the 320x60 button every page already used) --- */
  .button--md {
    gap: var(--spacing-sm);
    /* Canvas 2901:1911 carries min-width 240, not 320, and that difference is
       deliberately NOT taken. It cannot bind on the button that surfaced it —
       /about's Contact button is content-driven at 366px — but lowering it
       would shrink PasswordGate's short "Enter" label from 320 to 240 on
       another page. A library value that moves shipped pixels elsewhere is not
       worth the tidiness. */
    min-width: 320px;
    padding: var(--spacing-md) var(--spacing-lg);
    font-size: var(--font-size-lg);
    line-height: var(--font-line-height-lg);
  }

  /* --- size: sm (canvas 2911:2071, the header CV button) --- */
  .button--sm {
    gap: var(--spacing-md);
    /* No min-width on purpose. md's 320 floor exists so page-level CTAs share
       a width; this one is 187px of content inside a 48px header row, where a
       floor would only push the theme-toggle around. */
    /* Every value is the canvas number MINUS the 1px border, and that is not
       fussiness: Figma strokes this frame on the INSIDE, so its 48x187 box
       already contains the border, while CSS paints the border outside the
       padding box. Taking 12/24/18 literally renders a 50px control in a 48px
       header row — measured, it overhung by 1px top and bottom. Subtracting
       the border lands on the canvas's OUTER dimensions: 48 tall, label 24
       from the left edge, glyph 18 from the right.

       The 24-left / 18-right asymmetry itself is canvas and must survive: the
       download glyph's ink stops ~3.4px inside its 24px box at this size (its
       28-viewBox art spans x 4..24), so 18 + 3.4 reads as ~21 against 24 on
       the text side. Equalising them would look right-heavy. */
    padding: 11px 17px 11px 23px;
    font-size: var(--font-size-sm);
    line-height: var(--font-line-height-sm);
  }

  .button--solid {
    background: var(--color-bg-accent);
    color: var(--color-text-on-accent);
  }
  .button--solid:hover:not(:disabled):not([aria-disabled='true']) {
    background: var(--color-bg-accent-hover);
  }
  .button--solid:disabled,
  .button--solid[aria-disabled='true'] {
    background: var(--color-bg-muted);
    color: var(--color-text-muted);
    opacity: 0.4;
    cursor: not-allowed;
    pointer-events: none;
  }

  .button--outlined {
    border: 1px solid var(--color-border-accent);
    color: var(--color-text-accent);
  }
  .button--outlined:hover:not(:disabled):not([aria-disabled='true']) {
    border-color: var(--color-border-emphasis);
    color: var(--color-text-emphasis);
  }
  .button--outlined:disabled,
  .button--outlined[aria-disabled='true'] {
    border-color: var(--color-border-default);
    color: var(--color-text-muted);
    opacity: 0.4;
    cursor: not-allowed;
    pointer-events: none;
  }
</style>
