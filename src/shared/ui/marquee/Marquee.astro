---
// Infinite scrolling text strip, adapted from wearemotto.com/work's marquee
// pattern (wiki/concepts/motto-motion-patterns.md) — pure CSS keyframe loop,
// no JS. The track renders two copies of `text` back-to-back and animates
// -50% (one copy's width), so the loop point is invisible. The second copy
// is aria-hidden — it's a visual continuation, not new content for screen
// readers.
interface Props {
  text: string;
  duration?: string;
  class?: string;
}

const { text, duration = '24s', class: className } = Astro.props;
---

<div class:list={['marquee', className]} style={{ '--marquee-duration': duration }}>
  <div class="marquee__track">
    <span class="marquee__item">{text}</span>
    <span class="marquee__item" aria-hidden="true">{text}</span>
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    width: 100%;
  }
  .marquee__track {
    display: inline-flex;
    width: max-content;
    animation: marquee-scroll var(--marquee-duration) linear infinite;
  }
  .marquee:hover .marquee__track {
    animation-play-state: paused;
  }
  .marquee__item {
    flex-shrink: 0;
    padding-right: 1em;
    font-family: var(--font-family-body);
    font-size: var(--font-size-sm);
    line-height: var(--font-line-height-sm);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-text-primary);
  }
  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee__track {
      animation: none;
    }
  }
</style>
