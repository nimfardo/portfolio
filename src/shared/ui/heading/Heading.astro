---
// Matches Figma's real "Heading" component (496px wide, Manrope/xl/bold,
// uppercase, text-primary) — Max consolidated every major section title
// (Project Overview, Challenge, Process, Deliverables, Build,
// Retrospective) onto one shared component instead of separately-styled
// text, so this mirrors that on the code side rather than keeping styling
// duplicated across ContentSection/BuildSection/Retrospective/[slug].astro.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<h2 class:list={['heading', className]} data-reveal><slot /></h2>

<style>
  .heading {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: var(--font-size-xl);
    line-height: var(--font-line-height-xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: var(--color-text-primary);
  }
</style>
