---
// icon prop renders an Icon (default use); omit it to project arbitrary
// content instead via the slot — used by ProcessAccordion for the step
// number, which Figma now shows inside this same 80x80 badge shell rather
// than as plain text.
import Icon from '../icon/Icon.astro';
import type { IconName } from '../icon/Icon.astro';

interface Props {
  icon?: IconName;
  /** Icon glyph size in px, passed straight to Icon. Default 48 matches
   * this badge's original process-block icon usage; process-accordion
   * passes 32 to match its icons' real Figma frame. */
  size?: number;
  class?: string;
}

const { icon, size = 48, class: className } = Astro.props;
---

<span class:list={['icon-badge', className]}>
  {icon ? <Icon name={icon} size={size} /> : <slot />}
</span>

<style>
  .icon-badge {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 80px;
    height: 80px;
    color: var(--color-icon-default);
  }
</style>
