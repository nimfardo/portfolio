---
import iconArrowRight from './svg/arrow-right.svg?raw';
import iconArrowLeft from './svg/arrow-left.svg?raw';
import iconBehance from './svg/behance.svg?raw';
import iconCheck from './svg/check.svg?raw';
import iconClose from './svg/close.svg?raw';
import iconDrop from './svg/drop.svg?raw';
import iconEye from './svg/eye.svg?raw';
import iconEyeOff from './svg/eye-off.svg?raw';
import iconLeaf from './svg/leaf.svg?raw';
import iconLinkedin from './svg/linkedin.svg?raw';
import iconList from './svg/list.svg?raw';
import iconLocker from './svg/locker.svg?raw';
import iconMenu from './svg/menu.svg?raw';
import iconMinus from './svg/minus.svg?raw';
import iconPlus from './svg/plus.svg?raw';
import iconScroll from './svg/scroll.svg?raw';
import iconThumb from './svg/thumb.svg?raw';
import iconTree from './svg/tree.svg?raw';
import iconWaves from './svg/waves.svg?raw';

const icons = {
  'arrow-right': iconArrowRight,
  'arrow-left': iconArrowLeft,
  behance: iconBehance,
  check: iconCheck,
  close: iconClose,
  drop: iconDrop,
  eye: iconEye,
  'eye-off': iconEyeOff,
  leaf: iconLeaf,
  linkedin: iconLinkedin,
  list: iconList,
  locker: iconLocker,
  menu: iconMenu,
  minus: iconMinus,
  plus: iconPlus,
  scroll: iconScroll,
  thumb: iconThumb,
  tree: iconTree,
  waves: iconWaves,
} as const;

export type IconName = keyof typeof icons;

// Figma's icon components live in a 28x28 frame with the glyph inset at its
// own natural size (not stretched to fill it) — e.g. arrow-right's glyph is
// 14x14 within that 28x28 frame. linkedin/behance are the exception, framed
// at 32x32. Every exported SVG's width/height already IS that natural glyph
// size (tight viewBox, not padded to the frame) — see wiki/log.md for how
// this was diagnosed. So: render each glyph at its own intrinsic size, then
// scale it by size/nativeFrame to match how Figma scales an icon instance
// up or down, instead of stretching it to fill an arbitrary box.
const SOCIAL_ICONS = new Set<IconName>(['linkedin', 'behance']);

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 28, class: className } = Astro.props;
const nativeFrame = SOCIAL_ICONS.has(name) ? 32 : 28;
const scale = size / nativeFrame;
---

<span class:list={['icon', className]} style={{ width: `${size}px`, height: `${size}px` }}>
  <span class="icon__glyph" style={{ transform: `scale(${scale})` }} set:html={icons[name]} />
</span>

<style>
  .icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    /* No `color` declared here on purpose. `color` inherits by default in
       CSS with no rule needed — but a consumer passing `class="foo"` merges
       onto this SAME element (`class:list={['icon', className]}`), so an
       explicit `color: inherit` here would tie in specificity with the
       consumer's own `.foo { color: ... }` rule and the winner would depend
       on arbitrary stylesheet bundling order (this caused project-card's
       arrow icon to render text-primary instead of its intended
       icon-emphasis — same failure class bug-002 fixed for Button, still
       latent here since bug-002's fix only removed Icon's hardcoded color,
       not this implicit tie). Omitting the property outright means there's
       only ever one real `color` declaration on the element: the
       consumer's, when it sets one. */
  }
  .icon__glyph {
    display: inline-flex;
  }
  .icon__glyph :global(svg) {
    display: block;
  }
</style>
