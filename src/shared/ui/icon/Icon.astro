---
// The icon inventory (every ./svg export, uniform sizing rules, drift
// history) lives in ./icons.ts, a plain module — see that file's own header
// comment for why it isn't inline here. This component is just the render.
import { icons, type IconName } from './icons';
export type { IconName };

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 28, class: className } = Astro.props;
---

<span
  class:list={['icon', className]}
  style={{ width: `${size}px`, height: `${size}px` }}
  set:html={icons[name]}
/>

<style>
  .icon {
    /* Kept as inline-flex, not switched to inline-block, even though the SVG
       now fills the box on its own: both are inline-level, but they derive
       their baseline differently, and this element sits inline next to text at
       several call sites. Same outer box as before = no baseline shift. */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    /* No `color` declared here on purpose. `color` inherits by default in
       CSS with no rule needed — but a consumer passing `class="foo"` merges
       onto this SAME element (`class:list={['icon', className]}`), so an
       explicit `color: inherit` here would tie in specificity with the
       consumer's own `.foo { color: ... }` rule and the winner would depend
       on arbitrary stylesheet bundling order (this caused project-card's
       arrow icon to render text-primary instead of its intended
       icon-emphasis — same failure class bug-002 fixed for Button, still
       latent here since bug-002's fix only removed Icon's hardcoded color,
       not this implicit tie). Omitting the property outright means there's
       only ever one real `color` declaration on the element: the
       consumer's, when it sets one. */
  }
  /* :global() — the SVG comes from set:html, so it carries no astro-cid and a
     scoped selector would never match it.
     `flex: none` is the descendant of bug-055: width/height 100% resolve to
     exactly the container's content box, so there is no free space to shrink
     and the default flex-shrink cannot actually bite here — but that fix was
     originally lost precisely because the shrink was implicit, so it stays
     explicit. */
  .icon :global(svg) {
    display: block;
    flex: none;
    width: 100%;
    height: 100%;
  }
</style>
