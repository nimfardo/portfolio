---
import iconArrowRight from './svg/arrow-right.svg?raw';
import iconArrowLeft from './svg/arrow-left.svg?raw';
import iconArrowUp from './svg/arrow-up.svg?raw';
import iconBehance from './svg/behance.svg?raw';
import iconClose from './svg/close.svg?raw';
import iconDrop from './svg/drop.svg?raw';
import iconEye from './svg/eye.svg?raw';
import iconEyeOff from './svg/eye-off.svg?raw';
import iconLeaf from './svg/leaf.svg?raw';
import iconLinkedin from './svg/linkedin.svg?raw';
import iconLocker from './svg/locker.svg?raw';
import iconMenu from './svg/menu.svg?raw';
import iconMinus from './svg/minus.svg?raw';
import iconPlus from './svg/plus.svg?raw';
import iconScroll from './svg/scroll.svg?raw';
import iconSmile from './svg/smile.svg?raw';
import iconTree from './svg/tree.svg?raw';
import iconWaves from './svg/waves.svg?raw';
import iconSearch from './svg/search.svg?raw';
import iconPersonas from './svg/personas.svg?raw';
import iconSitemap from './svg/sitemap.svg?raw';
import iconWireframe from './svg/wireframe.svg?raw';
import iconSpeech from './svg/speech.svg?raw';
import iconPalette from './svg/palette.svg?raw';
import iconLayers from './svg/layers.svg?raw';
import iconTokens from './svg/tokens.svg?raw';
import iconSystem from './svg/system.svg?raw';
import iconResponsive from './svg/responsive.svg?raw';
import iconMotion from './svg/motion.svg?raw';
import iconHandoff from './svg/handoff.svg?raw';
import iconGithub from './svg/github.svg?raw';
import iconCv from './svg/cv.svg?raw';
import iconDownload from './svg/download.svg?raw';
import iconMail from './svg/mail.svg?raw';

const icons = {
  'arrow-right': iconArrowRight,
  'arrow-left': iconArrowLeft,
  'arrow-up': iconArrowUp,
  behance: iconBehance,
  close: iconClose,
  drop: iconDrop,
  eye: iconEye,
  'eye-off': iconEyeOff,
  leaf: iconLeaf,
  linkedin: iconLinkedin,
  locker: iconLocker,
  menu: iconMenu,
  minus: iconMinus,
  plus: iconPlus,
  scroll: iconScroll,
  smile: iconSmile,
  tree: iconTree,
  waves: iconWaves,
  // The 12-step process icons (comp-011) — all built on the same 28x28
  // frame as the rest of the set, so none belong in FRAME_32_ICONS.
  search: iconSearch,
  personas: iconPersonas,
  sitemap: iconSitemap,
  wireframe: iconWireframe,
  speech: iconSpeech,
  palette: iconPalette,
  layers: iconLayers,
  tokens: iconTokens,
  system: iconSystem,
  responsive: iconResponsive,
  motion: iconMotion,
  handoff: iconHandoff,
  // /about's link cards (feat-063). `cv` and `download` are 28x28 like most of
  // the set; `github` is a 32x32 frame (comp-014) and so joins FRAME_32_ICONS
  // below — its export carries the frame's own padding, so scale must divide
  // by 32 or the glyph renders ~14% small.
  github: iconGithub,
  cv: iconCv,
  download: iconDownload,
  // /about's Contact mail card (feat-074, canvas 2793:3231). A 28-frame icon,
  // not a 32: its 80px instance insets the glyph 14.29% each side, and 14.29%
  // of 28 is exactly the 4px padding the rest of the 28-frame set carries
  // (on a 32 frame it would be 4.57px, which no icon in the set uses). So it
  // stays out of FRAME_32_ICONS and scales by /28 like the majority.
  mail: iconMail,
} as const;

export type IconName = keyof typeof icons;

// Figma's icon components live in a 28x28 frame with the glyph inset at its
// own natural size (not stretched to fill it) — e.g. arrow-right's glyph is
// 14x14 within that 28x28 frame. linkedin/behance/smile are the exception,
// framed at 32x32. Every exported SVG's width/height already IS that natural
// glyph size (tight viewBox, not padded to the frame) — see wiki/log.md for
// how this was diagnosed. So: render each glyph at its own intrinsic size,
// then scale it by size/nativeFrame to match how Figma scales an icon
// instance up or down, instead of stretching it to fill an arbitrary box.
const FRAME_32_ICONS = new Set<IconName>(['linkedin', 'behance', 'smile', 'github']);

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 28, class: className } = Astro.props;
const nativeFrame = FRAME_32_ICONS.has(name) ? 32 : 28;
const scale = size / nativeFrame;
---

<span class:list={['icon', className]} style={{ width: `${size}px`, height: `${size}px` }}>
  <span class="icon__glyph" style={{ transform: `scale(${scale})` }} set:html={icons[name]} />
</span>

<style>
  .icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    /* No `color` declared here on purpose. `color` inherits by default in
       CSS with no rule needed — but a consumer passing `class="foo"` merges
       onto this SAME element (`class:list={['icon', className]}`), so an
       explicit `color: inherit` here would tie in specificity with the
       consumer's own `.foo { color: ... }` rule and the winner would depend
       on arbitrary stylesheet bundling order (this caused project-card's
       arrow icon to render text-primary instead of its intended
       icon-emphasis — same failure class bug-002 fixed for Button, still
       latent here since bug-002's fix only removed Icon's hardcoded color,
       not this implicit tie). Omitting the property outright means there's
       only ever one real `color` declaration on the element: the
       consumer's, when it sets one. */
  }
  .icon__glyph {
    display: inline-flex;
  }
  .icon__glyph :global(svg) {
    display: block;
  }
</style>
