---
// Header/nav logo — real Lottie animation of the monogram (exported from
// max-logo.aep, 30 frames / 30fps, raw/max-logo.json → public/media/logo/;
// resynced feat-116, replacing the export Max had rejected the first time).
// Rest state (frame 0) looks identical to the static Logo.astro glyph.
// Hover plays forward to the last frame and freezes there; unhover plays
// the same clip in reverse back to frame 0 — a small hover-reveal detail,
// not a looping/ambient animation. Wired into Navigation's desktop sidebar
// logo as of feat-116; the mobile header/overlay logos stay static Logo.
//
// The Lottie's fill colors are baked in at export time (not currentColor —
// Lottie shape fills don't follow CSS custom properties without runtime
// theming, which this plain AE export doesn't have set up), and the source
// export happens to match dark-theme's --color-icon-default (#efcba6)
// exactly. max-logo-light.json is the same 30-frame clip with those five
// baked-in fill/stroke colors swapped for light-theme's --color-icon-default
// (#2f1c08) instead. Same clip, same hover interaction, theme-correct color,
// swapped via CSS on [data-theme] — no JS theme-detection needed.

interface Props {
  size?: number;
  class?: string;
  /** Plays the clip forward once on mount, no hover required — the
   * preloader's masked-reveal use (STATE.md's open "preloader logo"
   * decision), distinct from the header's hover-triggered reveal. */
  autoplayOnce?: boolean;
}

const { size = 64, class: className, autoplayOnce = false } = Astro.props;
---

<span
  class:list={['animated-logo', className]}
  style={{ width: `${size}px`, height: `${size}px` }}
  data-animated-logo
  data-autoplay-once={autoplayOnce ? '' : undefined}
>
  <dotlottie-wc
    class="animated-logo__lottie animated-logo__lottie--dark"
    src="/media/logo/max-logo.json"
    mode="forward"
    aria-hidden="true"></dotlottie-wc>
  <dotlottie-wc
    class="animated-logo__lottie animated-logo__lottie--light"
    src="/media/logo/max-logo-light.json"
    mode="forward"
    aria-hidden="true"></dotlottie-wc>
</span>

<script>
  import { setWasmUrl } from '@lottiefiles/dotlottie-wc';
  setWasmUrl('/wasm/dotlottie-player.wasm');
</script>

<script>
  import { prefersReducedMotion, bindOncePersisted } from '@shared/lib';

  type DotLottieElement = HTMLElement & {
    dotLottie?: {
      setMode: (mode: 'forward' | 'reverse') => void;
      setSpeed: (speed: number) => void;
      play: () => void;
    };
  };

  // Unhover plays the reverse clip at 2x speed (half the duration) so the
  // logo snaps back to rest faster than it revealed on hover-in.
  const FORWARD_SPEED = 1;
  const REVERSE_SPEED = 2;

  // Every current instance lives inside Navigation's persisted containers
  // or the persisted Preloader, so `astro:page-load` firing again after a
  // client-side navigation would hit the same DOM nodes — bindOncePersisted
  // stops duplicate mouseenter/mouseleave listeners from stacking, and (just
  // as importantly) stops the preloader's autoplay-once instance from
  // replaying its reveal on every navigation.
  function initAnimatedLogos() {
    if (prefersReducedMotion()) return;
    bindOncePersisted<HTMLElement>('[data-animated-logo]', (wrapper) => {
      // Two players (dark/light), CSS-toggled by [data-theme] — only one is
      // ever visible, but both are driven together so a mid-hover theme
      // switch can't leave the newly-shown player stuck on a stale frame.
      const players = wrapper.querySelectorAll<DotLottieElement>('dotlottie-wc');
      if (!players.length) return;

      if (wrapper.dataset.autoplayOnce !== undefined) {
        players.forEach((player) => {
          player.dotLottie?.setMode('forward');
          player.dotLottie?.play();
        });
      }

      wrapper.addEventListener('mouseenter', () => {
        players.forEach((player) => {
          player.dotLottie?.setSpeed(FORWARD_SPEED);
          player.dotLottie?.setMode('forward');
          player.dotLottie?.play();
        });
      });
      wrapper.addEventListener('mouseleave', () => {
        players.forEach((player) => {
          player.dotLottie?.setSpeed(REVERSE_SPEED);
          player.dotLottie?.setMode('reverse');
          player.dotLottie?.play();
        });
      });
    });
  }

  document.addEventListener('astro:page-load', initAnimatedLogos);
</script>

<style>
  .animated-logo {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  /* Absolutely-positioned overlay, not flex-flow siblings: dotlottie-wc sizes
     its internal canvas buffer off a ResizeObserver on its own box, and that
     observer never fires for a `display: none` element — so the theme that
     was hidden at mount kept the canvas's default 300x150 buffer forever,
     which then got stretched to fill the real 64x64 box the instant it
     flipped to `display: block` (visible as a squished glyph, reported after
     a light/dark toggle). Both players now stay laid out at their real size
     the whole time — `visibility` swaps which one paints, not which one
     exists — so both get measured correctly from initial mount. */
  .animated-logo__lottie {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }
  .animated-logo__lottie--light {
    visibility: hidden;
  }
  :global([data-theme='light']) .animated-logo__lottie--dark {
    visibility: hidden;
  }
  :global([data-theme='light']) .animated-logo__lottie--light {
    visibility: visible;
  }
</style>
