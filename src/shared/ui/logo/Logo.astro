---
import logoSvg from './logo.svg?raw';

interface Props {
  size?: number;
  class?: string;
}

const { size = 64, class: className } = Astro.props;
---

<span
  class:list={['logo', className]}
  style={{ width: `${size}px`, height: `${size}px` }}
  set:html={logoSvg}
/>

<style>
  .logo {
    display: inline-flex;
    flex-shrink: 0;
    color: var(--color-icon-default);
  }
  .logo :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
