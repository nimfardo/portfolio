---
import logoSvg from './logo.svg?raw';

interface Props {
  size?: number;
  class?: string;
}

const { size = 64, class: className } = Astro.props;

// Figma's logo master is a 64x64 frame with the monogram inset at its own
// natural 46x49 size (not stretched to fill it) — same tight-viewBox pattern
// as Icon.astro (see bug-002). Scale the natural size instead of forcing
// width/height:100%, which distorted the glyph's aspect ratio.
const NATIVE_FRAME = 64;
const scale = size / NATIVE_FRAME;
---

<span class:list={['logo', className]} style={{ width: `${size}px`, height: `${size}px` }}>
  <span class="logo__glyph" style={{ transform: `scale(${scale})` }} set:html={logoSvg} />
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--color-icon-default);
  }
  .logo__glyph {
    display: inline-flex;
  }
  .logo__glyph :global(svg) {
    display: block;
  }
</style>
